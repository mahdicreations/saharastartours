---
// TourLayout.astro — Layout for all tour detail pages
// Adds Leaflet CSS + script, tour hero, sidebar booking form
import BaseLayout from './BaseLayout.astro';
import TourMap from '../components/TourMap.astro';

interface TourStop {
  number: number;
  name: string;
  day: string;
  subtitle: string;
  desc: string;
  coords: [number, number];
}

interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  // Tour data
  tourName: string;
  tourSlug: string;
  duration: string;
  startingFrom: string;
  category: string;
  price?: string;
  heroImage: string;
  highlights?: string[];
  inclusions?: string[];
  exclusions?: string[];
  itinerary?: Array<{ day: string; title: string; content: string }>;
  mapDestinations?: TourStop[];
  mapRouteCoordinates?: [number, number][];
  galleryImages?: Array<{ src: string; cap: string }>;
  relatedTours?: Array<{ slug: string; shortTitle: string; duration: string; price: string; heroImage: string }>;
  faqs?: Array<{ question: string; answer: string }>;
  schemaData?: Record<string, unknown>;
}

const {
  title,
  description,
  keywords,
  ogImage,
  tourName,
  tourSlug,
  duration,
  startingFrom,
  category,
  price = 'From $XXX/person',
  heroImage,
  highlights = [],
  inclusions = [],
  exclusions = [],
  itinerary = [],
  mapDestinations = [],
  mapRouteCoordinates = [],
  galleryImages = [],
  relatedTours = [],
  faqs = [],
  schemaData,
} = Astro.props;

// Build Tour schema (TouristTrip with authentic page data only)
const tourSchema = schemaData ?? {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": tourName,
  "description": description,
  "image": `https://www.saharastartours.com${heroImage}`,
  "url": `https://www.saharastartours.com/tours/${tourSlug}`,
  "touristType": "Adventure",
  "provider": {
    "@type": "TravelAgency",
    "name": "Sahara Star Tours",
    "url": "https://www.saharastartours.com"
  }
};

const galleryJSON = JSON.stringify(galleryImages);
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogImage={ogImage ?? heroImage}
  currentPage="tours"
  schemaData={tourSchema}
>
  <!-- Tour Hero Section -->
  <section class="tour-hero-section">
    <div class="tour-hero-bg">
      <img 
        src={heroImage} 
        alt={tourName} 
        onerror="this.src='/assets/placeholder-morocco.svg'"
      />
    </div>
    <div class="tour-hero-gradient"></div>
    <div class="tour-hero-content">
      <span class="tour-tag">{category}</span>
      <h1>{tourName}</h1>
      <div class="tour-quick-meta">
        <span><i class="fa-regular fa-clock"></i> <strong>{duration}</strong></span>
        <span><i class="fa-solid fa-location-dot"></i> From: <strong>{startingFrom}</strong></span>
      </div>
    </div>
  </section>

  <!-- ==============================================
       DESKTOP LUXURY STICKY SUB-NAV (OPTION 1)
       ============================================== -->
  <nav class="tour-subnav-desktop" id="tour-subnav-desktop" aria-label="Tour navigation">
    <div class="tour-subnav-container">
      <div class="tour-subnav-items">
        <a href="#tour-about" class="subnav-link active" data-section="tour-about">
          <i class="fa-solid fa-circle-info"></i> <span>Overview</span>
        </a>
        {itinerary.length > 0 && (
          <a href="#tour-itinerary" class="subnav-link" data-section="tour-itinerary">
            <i class="fa-solid fa-route"></i> <span>Itinerary</span>
          </a>
        )}
        {galleryImages.length > 0 && (
          <a href="#tour-gallery" class="subnav-link" data-section="tour-gallery">
            <i class="fa-solid fa-images"></i> <span>Gallery</span>
          </a>
        )}
        <a href="#tour-inclusions" class="subnav-link" data-section="tour-inclusions">
          <i class="fa-solid fa-list-check"></i> <span>Included</span>
        </a>
        {mapDestinations.length > 0 && (
          <a href="#tour-map" class="subnav-link" data-section="tour-map">
            <i class="fa-solid fa-map-location-dot"></i> <span>Map</span>
          </a>
        )}
        <a href="#tour-faq" class="subnav-link" data-section="tour-faq">
          <i class="fa-solid fa-circle-question"></i> <span>FAQ</span>
        </a>
      </div>
      <div class="tour-subnav-cta">
        <div class="subnav-price-chip">
          <span class="subnav-price-lbl">Starting from</span>
          <strong class="subnav-price-val">{price.replace(/^From\s*/i, '').trim()}</strong>
        </div>
        <a href="#booking-form" class="subnav-book-btn">
          <i class="fa-solid fa-calendar-check"></i> <span>Book This Tour</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- Page Content Slot + Sidebar Grid -->
  <div 
    class="tour-container" 
    id="tour-detail-container"
    x-data={`{
      lightboxOpen: false,
      activeIndex: 0,
      images: ${galleryJSON},
      bookingData: {
        name: '',
        email: '',
        package: '${tourSlug}',
        travelers: '2 Adults',
        date: '',
        style: 'Standard',
        message: ''
      },
      showSuccessModal: false,
      successMsg: '',
      openLightbox(idx) {
        this.activeIndex = idx;
        this.lightboxOpen = true;
      },
      prevImage() {
        this.activeIndex = (this.activeIndex - 1 + this.images.length) % this.images.length;
      },
      nextImage() {
        this.activeIndex = (this.activeIndex + 1) % this.images.length;
      },
      submitBooking() {
        this.successMsg = 'Shukran, ' + this.bookingData.name + '! Your inquiry for ${tourName} has been registered. Our travel designers in Marrakech will send your detailed personalized itinerary to ' + this.bookingData.email + ' within 24 hours.';
        this.showSuccessModal = true;
        document.body.style.overflow = 'hidden';
      },
      closeModal() {
        this.showSuccessModal = false;
        document.body.style.overflow = '';
      }
    }`}
    @keydown.escape.window="if(lightboxOpen) lightboxOpen = false; if(showSuccessModal) closeModal();"
    @keydown.left.window="if(lightboxOpen) prevImage();"
    @keydown.right.window="if(lightboxOpen) nextImage();"
  >
    <!-- LEFT COLUMN -->
    <div class="tour-main">
      <!-- About + Highlights -->
      <section class="timeline-card reveal active" id="tour-about">
        <h3>About This Tour</h3>
        <slot name="about" />
        {highlights.length > 0 && (
          <>
            <h5>Highlights:</h5>
            <ul style="margin-top: 10px; padding-left: 20px; color: var(--text-muted); line-height: 1.8;">
              {highlights.map(h => <li style="margin-bottom: 8px;">{h}</li>)}
            </ul>
          </>
        )}

        <!-- Download Detailed Itinerary PDF Bar -->
        <div class="tour-pdf-download-bar">
          <div class="tour-pdf-info">
            <i class="fa-solid fa-file-pdf"></i>
            <div>
              <strong>Download Tour Itinerary (PDF)</strong>
              <span>Complete day-by-day program, inclusions & route details</span>
            </div>
          </div>
          <a 
            href={`/pdfs/tours/${tourSlug}.pdf`} 
            download={`${tourSlug}.pdf`}
            target="_blank" 
            rel="noopener"
            class="btn btn-sm btn-primary"
            title={`Download ${tourName} itinerary PDF`}
          >
            <i class="fa-solid fa-download"></i> Download Tour PDF
          </a>
        </div>
      </section>

      <!-- Day-by-Day Itinerary -->
      {itinerary.length > 0 && (
        <section class="timeline-card reveal active" id="tour-itinerary">
          <h3><i class="fa-solid fa-route" style="color:var(--sand-gold);margin-right:8px;"></i> Program Itinerary</h3>
          <div class="timeline-steps-wrapper" id="timeline-steps">
            {itinerary.map(item => (
              <div class="timeline-item">
                <div class="timeline-day-tag">{item.day}</div>
                <h4>{item.title}</h4>
                <p set:html={item.content} />
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Media Gallery -->
      {galleryImages.length > 0 && (
        <section class="gallery-card reveal active" id="tour-gallery">
          <h3><i class="fa-solid fa-images" style="color:var(--sand-gold);margin-right:8px;"></i> Expedition Media Gallery</h3>
          <p>A visual glimpse of the spectacular landscapes awaiting you.</p>
          <div class="gallery-grid" id="gallery-grid">
            {galleryImages.map((img, idx) => (
              <div class="gallery-item" @click={`openLightbox(${idx})`}>
                <img 
                  src={img.src} 
                  alt={img.cap} 
                  loading="lazy" 
                  onerror="this.src='/assets/placeholder-morocco.svg'" 
                />
                <div class="gallery-overlay"><i class="fa-solid fa-maximize"></i></div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Inclusions & Exclusions -->
      <section class="inclusions-card reveal active" id="tour-inclusions">
        <h3><i class="fa-solid fa-list-check" style="color:var(--sand-gold);margin-right:8px;"></i> Inclusions &amp; Trip Details</h3>
        <div class="inc-exc-split">
          <div class="modal-inc-col included">
            <h5><i class="fa-solid fa-circle-check" style="color:var(--sand-gold); margin-right:8px;"></i> What's Included</h5>
            <ul class="modal-inc-list" style="list-style:none; display:flex; flex-direction:column; gap:12px; margin-top:16px;">
              {inclusions.map(item => (
                <li><i class="fa-solid fa-circle-check" style="color:var(--sand-gold);margin-right:8px;"></i>{item}</li>
              ))}
              <slot name="extra-inclusions" />
            </ul>
          </div>
          <div class="modal-inc-col excluded">
            <h5><i class="fa-solid fa-circle-xmark" style="color:var(--terracotta); margin-right:8px;"></i> Not Included</h5>
            <ul class="modal-exc-list" style="list-style:none; display:flex; flex-direction:column; gap:12px; margin-top:16px;">
              {exclusions.map(item => (
                <li><i class="fa-solid fa-circle-xmark" style="color:var(--terracotta);margin-right:8px;"></i>{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- Interactive Leaflet Route Map -->
      {mapDestinations.length > 0 && (
        <section class="map-section-wrap" id="tour-map">
          <TourMap tourSlug={tourSlug} duration={duration} destinations={mapDestinations} routeCoordinates={mapRouteCoordinates} />
        </section>
      )}

      <!-- Frequently Asked Questions -->
      <section class="faq-card reveal active" id="tour-faq">
        <h3><i class="fa-solid fa-circle-question" style="color:var(--sand-gold); margin-right:8px;"></i> Frequently Asked Questions</h3>
        <div class="faq-list">
          {faqs && faqs.length > 0 ? (
            faqs.map((f, idx) => (
              <details class="faq-item" open={idx === 0}>
                <summary class="faq-question">{f.question} <i class="fa-solid fa-chevron-down"></i></summary>
                <div class="faq-answer"><p>{f.answer}</p></div>
              </details>
            ))
          ) : (
            <>
              <details class="faq-item" open>
                <summary class="faq-question">What luggage and clothing should I pack for this trip? <i class="fa-solid fa-chevron-down"></i></summary>
                <div class="faq-answer"><p>We recommend comfortable walking shoes for medina cobbles and dunes, loose breathable cotton layers for daytime exploration, and a warm fleece or jacket for crisp desert evenings and mountain passes. Sunglasses, sunscreen, a hat, and a camera are essential.</p></div>
              </details>
              <details class="faq-item">
                <summary class="faq-question">Can this itinerary and accommodation level be customized? <i class="fa-solid fa-chevron-down"></i></summary>
                <div class="faq-answer"><p>Yes, absolutely! Every Sahara Star Tours package is 100% private and customizable. We can adjust the pacing, departure city, hotel tiers (Standard Riads, Comfort Boutique, or 5-Star Luxury Glamping), and add unique stops to match your travel dreams.</p></div>
              </details>
              <details class="faq-item">
                <summary class="faq-question">Where does pickup and drop-off take place? <i class="fa-solid fa-chevron-down"></i></summary>
                <div class="faq-answer"><p>We provide seamless door-to-door pickup and drop-off directly from your hotel, riad, or airport in {startingFrom}. Your private English-speaking driver/guide will greet you warmly with personalized signage.</p></div>
              </details>
              <details class="faq-item">
                <summary class="faq-question">Are special dietary requirements catered for? <i class="fa-solid fa-chevron-down"></i></summary>
                <div class="faq-answer"><p>Yes, all partner riads and our Sahara desert luxury camp chefs cater happily to vegetarian, vegan, halal, and gluten-free dietary requirements. Simply let us know your preferences during booking.</p></div>
              </details>
              <details class="faq-item">
                <summary class="faq-question">How do reservations and deposits work? <i class="fa-solid fa-chevron-down"></i></summary>
                <div class="faq-answer"><p>After submitting your inquiry, our local travel specialists in Marrakech will confirm availability and send your official itinerary voucher. A modest deposit secures your dates via credit card, PayPal, or wire transfer, with the balance paid safely upon arrival.</p></div>
              </details>
            </>
          )}
        </div>
      </section>

      <!-- Recommended Related Experiences -->
      {relatedTours && relatedTours.length > 0 && (
        <div class="related-tours-card reveal active">
          <h3><i class="fa-solid fa-compass" style="color:var(--terracotta); margin-right:8px;"></i> Recommended Similar Journeys</h3>
          <div class="related-tours-grid">
            {relatedTours.map(rt => (
              <a href={`/tours/${rt.slug}`} class="related-tour-item">
                <div class="related-tour-img">
                  <img src={rt.heroImage} alt={rt.shortTitle} loading="lazy" onerror="this.src='/assets/placeholder-morocco.svg'" />
                </div>
                <div class="related-tour-content">
                  <span class="related-tour-dur"><i class="fa-regular fa-clock"></i> {rt.duration}</span>
                  <h4>{rt.shortTitle}</h4>
                  <div class="related-tour-price">Starting <strong>{rt.price}</strong></div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Extra content slot for page-specific additions -->
      <slot name="extra-content" />
    </div>

    <!-- RIGHT SIDEBAR -->
    <aside class="tour-sidebar">
      <!-- Booking Form Card -->
      <div class="booking-sidebar-card" id="booking-form">
        <h3>Book This Tour</h3>
        <div class="booking-price-header">
          <span class="booking-price-label">Starting from</span>
          <span class="booking-price-val">{price.replace(/^From\s*/i, '').trim()}</span>
        </div>

        <!-- Travel Style Selector -->
        <div class="travel-style-group">
          <label class="travel-style-label"><i class="fa-solid fa-sliders"></i> Travel Style</label>
          <div class="travel-style-grid">
            {['Standard', 'Comfort', 'Luxury'].map(style => (
              <div 
                class="travel-style-card"
                :class={`bookingData.style === '${style}' ? 'active' : ''`}
                @click={`bookingData.style = '${style}'`}
              >
                <span class="ts-icon">
                  {style === 'Standard' && <i class="fa-solid fa-tent"></i>}
                  {style === 'Comfort' && <i class="fa-solid fa-hotel"></i>}
                  {style === 'Luxury' && <i class="fa-solid fa-star"></i>}
                </span>
                <span class="ts-name">{style}</span>
              </div>
            ))}
          </div>
        </div>

        <form @submit.prevent="submitBooking()">
          <div class="form-group">
            <input type="text" id="booking-name" x-model="bookingData.name" placeholder=" " required />
            <label for="booking-name">Your Full Name</label>
          </div>
          <div class="form-group">
            <input type="email" id="booking-email" x-model="bookingData.email" placeholder=" " required />
            <label for="booking-email">Email Address</label>
          </div>
          <div class="form-group">
            <input type="date" id="booking-date" x-model="bookingData.date" placeholder=" " />
            <label for="booking-date">Preferred Date</label>
          </div>
          <div class="form-group">
            <select id="booking-travelers" x-model="bookingData.travelers" style="width:100%">
              <option value="1 Adult">1 Adult</option>
              <option value="2 Adults" selected>2 Adults</option>
              <option value="3-4 People">3 - 4 People</option>
              <option value="5+ Group">5+ Group</option>
            </select>
            <label for="booking-travelers">Group Size</label>
          </div>
          <div class="form-group">
            <textarea id="booking-message" x-model="bookingData.message" placeholder=" " rows="3"></textarea>
            <label for="booking-message">Special requests or questions...</label>
          </div>
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-paper-plane"></i> Send My Inquiry
          </button>
        </form>

        <!-- Success Modal -->
        <div class="success-overlay" :class="showSuccessModal ? 'active' : ''" id="booking-success-modal">
          <div class="success-card">
            <div class="success-icon-box"><i class="fa-solid fa-circle-check"></i></div>
            <h3>Request Received!</h3>
            <p x-text="successMsg"></p>
            <button class="btn btn-primary" @click="closeModal()">Return to Exploring</button>
          </div>
        </div>
      </div>

      <!-- Quick Info Card -->
      <div class="booking-sidebar-card" style="padding:20px;">
        <h4 style="font-size:1.1rem;color:var(--sand-gold);margin-bottom:16px;">Quick Tour Info</h4>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:12px;font-size:0.9rem;">
          <li style="display:flex;align-items:center;gap:10px;color:var(--text-muted);">
            <i class="fa-regular fa-clock" style="color:var(--sand-gold);width:16px;"></i>
            <span><strong style="color:var(--text-main);">Duration:</strong> {duration}</span>
          </li>
          <li style="display:flex;align-items:center;gap:10px;color:var(--text-muted);">
            <i class="fa-solid fa-location-dot" style="color:var(--sand-gold);width:16px;"></i>
            <span><strong style="color:var(--text-main);">Starting:</strong> {startingFrom}</span>
          </li>
          <li style="display:flex;align-items:center;gap:10px;color:var(--text-muted);">
            <i class="fa-solid fa-users" style="color:var(--sand-gold);width:16px;"></i>
            <span><strong style="color:var(--text-main);">Group:</strong> Private & Custom</span>
          </li>
          <li style="display:flex;align-items:center;gap:10px;color:var(--text-muted);">
            <i class="fa-solid fa-language" style="color:var(--sand-gold);width:16px;"></i>
            <span><strong style="color:var(--text-main);">Guide:</strong> EN / FR / ES / IT</span>
          </li>
          <li style="display:flex;align-items:center;gap:10px;color:var(--text-muted);">
            <i class="fa-solid fa-car-side" style="color:var(--sand-gold);width:16px;"></i>
            <span><strong style="color:var(--text-main);">Transport:</strong> Private A/C Vehicle</span>
          </li>
        </ul>
        <hr style="border:none;border-top:1px solid var(--glass-border);margin:20px 0;" />
        <a 
          href={`/pdfs/tours/${tourSlug}.pdf`} 
          download={`${tourSlug}.pdf`}
          target="_blank" 
          rel="noopener"
          class="btn btn-secondary" 
          style="width:100%;justify-content:center;gap:10px;margin-bottom:10px;border-color:rgba(212,163,115,0.4);"
          title={`Download ${tourName} itinerary PDF`}
        >
          <i class="fa-solid fa-file-pdf" style="color:var(--sand-gold);font-size:1.1rem;"></i>
          <span>Download Tour PDF</span>
        </a>
        <a href="https://wa.me/212678317015" target="_blank" rel="noopener" class="btn btn-secondary" style="width:100%;justify-content:center;gap:10px;">
          <i class="fa-brands fa-whatsapp" style="color:#25D366;font-size:1.2rem;"></i> WhatsApp Us
        </a>
      </div>
    </aside>

    <!-- Lightbox Modal (Alpine Scope) -->
    <div 
      class="lightbox-overlay" 
      :class="lightboxOpen ? 'active' : ''"
      x-show="lightboxOpen"
      style="display:none;"
      @click.self="lightboxOpen = false"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
    >
      <div class="lightbox-content-box">
        <button class="lightbox-close" type="button" @click="lightboxOpen = false" aria-label="Close lightbox">
          <i class="fa-solid fa-xmark"></i>
        </button>
        <button class="lightbox-btn lightbox-prev" type="button" @click="prevImage()" aria-label="Previous image">
          <i class="fa-solid fa-chevron-left"></i>
        </button>
        <img 
          class="lightbox-img" 
          :src="images[activeIndex]?.src" 
          alt="Tour photo gallery preview"
          :alt="images[activeIndex]?.cap || 'Tour photo gallery preview'"
          onerror="this.src='/assets/hero_sahara_sunset.png'" 
        />
        <button class="lightbox-btn lightbox-next" type="button" @click="nextImage()" aria-label="Next image">
          <i class="fa-solid fa-chevron-right"></i>
        </button>
        <p class="lightbox-caption" x-text="images[activeIndex]?.cap"></p>
      </div>
    </div>
  </div>

  <!-- Mobile Floating Action Bar -->
  <div class="mobile-floating-booking-bar" id="mobile-booking-bar">
    <div class="mf-left">
      <span class="mf-tag"><i class="fa-solid fa-shield-halved"></i> INSTANT RESERVE</span>
      <span class="mf-title">Book This Tour</span>
    </div>
    <button type="button" class="mf-btn" onclick="const f=document.getElementById('booking-form');if(f){f.scrollIntoView({behavior:'smooth'});}">
      Book Now ↓
    </button>
  </div>

  <!-- ==============================================
       MOBILE SLIM VERTICAL ICON STRIP (OPTION 3)
       ============================================== -->
  <aside class="tour-subnav-mobile-strip" id="tour-subnav-mobile-strip" aria-label="Tour quick navigation">
    <div class="mobile-strip-inner">
      <a href="#tour-about" class="mobile-strip-item active" data-section="tour-about" title="Overview" aria-label="Overview">
        <i class="fa-solid fa-circle-info"></i>
        <span class="mobile-strip-tooltip">Overview</span>
      </a>
      {itinerary.length > 0 && (
        <a href="#tour-itinerary" class="mobile-strip-item" data-section="tour-itinerary" title="Itinerary" aria-label="Itinerary">
          <i class="fa-solid fa-route"></i>
          <span class="mobile-strip-tooltip">Itinerary</span>
        </a>
      )}
      {galleryImages.length > 0 && (
        <a href="#tour-gallery" class="mobile-strip-item" data-section="tour-gallery" title="Gallery" aria-label="Gallery">
          <i class="fa-solid fa-images"></i>
          <span class="mobile-strip-tooltip">Gallery</span>
        </a>
      )}
      <a href="#tour-inclusions" class="mobile-strip-item" data-section="tour-inclusions" title="Inclusions" aria-label="Inclusions">
        <i class="fa-solid fa-list-check"></i>
        <span class="mobile-strip-tooltip">Included</span>
      </a>
      {mapDestinations.length > 0 && (
        <a href="#tour-map" class="mobile-strip-item" data-section="tour-map" title="Route Map" aria-label="Route Map">
          <i class="fa-solid fa-map-location-dot"></i>
          <span class="mobile-strip-tooltip">Route Map</span>
        </a>
      )}
      <a href="#tour-faq" class="mobile-strip-item" data-section="tour-faq" title="FAQ" aria-label="FAQ">
        <i class="fa-solid fa-circle-question"></i>
        <span class="mobile-strip-tooltip">FAQ</span>
      </a>
      <a href="#booking-form" class="mobile-strip-item mobile-strip-item-book" data-section="booking-form" title="Book Now" aria-label="Book Now">
