  <!-- Interactive ScrollSpy & Smooth Scroll Script -->
  <script>
    function setupTourSubNav() {
      const desktopLinks = document.querySelectorAll('.tour-subnav-desktop .subnav-link');
      const mobileLinks = document.querySelectorAll('.tour-subnav-mobile-strip .mobile-strip-item');
      const allNavLinks = [...desktopLinks, ...mobileLinks];

      // Smooth click handler with custom header offset
      allNavLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          const href = link.getAttribute('href');
          if (href && href.startsWith('#')) {
            const target = document.querySelector(href);
            if (target) {
              e.preventDefault();
              const isMobile = window.innerWidth <= 768;
              const offset = isMobile ? 80 : 130;
              const targetPos = target.getBoundingClientRect().top + window.pageYOffset - offset;
              window.scrollTo({
                top: targetPos,
                behavior: 'smooth'
              });
            }
          }
        });
      });

      // ScrollSpy to highlight active link
      const sectionIds = ['tour-about', 'tour-itinerary', 'tour-gallery', 'tour-inclusions', 'tour-map', 'tour-faq', 'booking-form'];
      const sectionElements = sectionIds
        .map(id => document.getElementById(id))
        .filter((el): el is HTMLElement => el !== null);

      function updateActiveNav() {
        const isMobile = window.innerWidth <= 768;
        const scrollPos = window.scrollY + (isMobile ? 120 : 180);
        let currentId = '';

        for (let i = 0; i < sectionElements.length; i++) {
          const sec = sectionElements[i];
          if (sec && sec.offsetTop <= scrollPos) {
            currentId = sec.id;
          }
        }

        if (currentId) {
          desktopLinks.forEach(link => {
            if (link.getAttribute('href') === `#${currentId}`) {
              link.classList.add('active');
            } else {
              link.classList.remove('active');
            }
          });

          mobileLinks.forEach(link => {
            if (link.getAttribute('href') === `#${currentId}`) {
              link.classList.add('active');
            } else {
              link.classList.remove('active');
            }
          });
        }
      }

      window.addEventListener('scroll', updateActiveNav, { passive: true });
      updateActiveNav();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupTourSubNav);
    } else {
      setupTourSubNav();
    }
  </script>
</BaseLayout>

