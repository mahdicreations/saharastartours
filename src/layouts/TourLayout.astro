---
// TourLayout.astro — Layout for all tour detail pages
// Adds Leaflet CSS + script, tour hero, sidebar booking form, multi-language support (EN, ES, IT)
import BaseLayout from './BaseLayout.astro';
import TourMap from '../components/TourMap.astro';
import { getAlternateUrls } from '../data/i18n';

interface TourStop {
  number: number;
  name: string;
  day: string;
  subtitle: string;
  desc: string;
  coords: [number, number];
}

interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  lang?: 'en' | 'es' | 'it' | string;
  locale?: string;
  alternateUrls?: {
    en?: string;
    es?: string;
    it?: string;
    xDefault?: string;
  };
  touristType?: string;
  // Tour data
  tourName: string;
  tourSlug: string;
  duration: string;
  startingFrom: string;
  category: string;
  productType?: string;
  departureCity?: string;
  price?: string;
  heroImage: string;
  highlights?: string[];
  inclusions?: string[];
  exclusions?: string[];
  itinerary?: Array<{ day: string; title: string; content: string }>;
  mapDestinations?: TourStop[];
  mapRouteCoordinates?: [number, number][];
  galleryImages?: Array<{ src: string; cap: string; alt?: string }>;
  relatedTours?: Array<{ slug: string; shortTitle: string; duration: string; price: string; heroImage: string }>;
  faqs?: Array<{ question: string; answer: string }>;
  schemaData?: Record<string, unknown>;
}

const {
  title,
  description,
  keywords,
  ogImage,
  lang = 'en',
  locale,
  alternateUrls,
  touristType,
  tourName,
  tourSlug,
  duration,
  startingFrom,
  category,
  productType = 'multi-day',
  departureCity,
  price = 'From $XXX/person',
  heroImage,
  highlights = [],
  inclusions = [],
  exclusions = [],
  itinerary = [],
  mapDestinations = [],
  mapRouteCoordinates = [],
  galleryImages = [],
  relatedTours = [],
  faqs = [],
  schemaData,
} = Astro.props;

const currentLang = (['en', 'es', 'it'].includes(lang) ? lang : 'en') as 'en' | 'es' | 'it';
const defaultLocale = currentLang === 'es' ? 'es_ES' : (currentLang === 'it' ? 'it_IT' : 'en_US');
const activeLocale = locale ?? defaultLocale;
const resolvedAlternateUrls = alternateUrls ?? getAlternateUrls(`/tours/${tourSlug}`);
const currentCanonicalUrl = resolvedAlternateUrls[currentLang] || `https://www.saharastartours.com/tours/${tourSlug}`;

// Resolve genuine tourist audience only when supported by authentic content; otherwise omit
let resolvedTouristType: string | undefined = touristType;
if (!resolvedTouristType && tourName) {
  if (/\bcouple(s)?\b|\bromantic\b|parejas|coppie/i.test(tourName)) {
    resolvedTouristType = currentLang === 'es' ? 'Parejas' : (currentLang === 'it' ? 'Coppie' : 'Couples');
  } else if (/\bfamil(y|ies)\b|familias|famiglie/i.test(tourName)) {
    resolvedTouristType = currentLang === 'es' ? 'Familias' : (currentLang === 'it' ? 'Famiglie' : 'Families');
  }
}

// Localized UI Dictionary
const l10n = {
  en: {
    fromPrefix: 'From:',
    overview: 'Overview',
    itinerary: 'Itinerary',
    gallery: 'Gallery',
    included: 'Included',
    map: 'Map',
    faq: 'FAQ',
    startingFrom: 'Starting from',
    bookThisTour: 'Book This Tour',
    aboutTour: 'About This Tour',
    highlights: 'Highlights:',
    programItinerary: 'Program Itinerary',
    expeditionGallery: 'Expedition Media Gallery',
    gallerySubtitle: 'A visual glimpse of the spectacular landscapes awaiting you.',
    inclusionsHeading: 'Inclusions & Trip Details',
    whatsIncluded: "What's Included",
    notIncluded: 'Not Included',
    faqHeading: 'Frequently Asked Questions',
    relatedHeading: 'Recommended Similar Journeys',
    relatedStarting: 'Starting',
    travelStyle: 'Travel Style',
    styles: { Standard: 'Standard', Comfort: 'Comfort', Luxury: 'Luxury' } as Record<string, string>,
    fullName: 'Your Full Name',
    email: 'Email Address',
    prefDate: 'Preferred Date',
    groupSize: 'Group Size',
    groupOptions: [
      { value: '1 Adult', label: '1 Adult' },
      { value: '2 Adults', label: '2 Adults', selected: true },
      { value: '3-4 People', label: '3 - 4 People' },
      { value: '5+ Group', label: '5+ Group' },
    ],
    specialRequests: 'Special requests or questions...',
    sendInquiry: 'Send My Inquiry',
    requestReceived: 'Request Received!',
    returnExploring: 'Return to Exploring',
    quickInfo: 'Quick Tour Info',
    durationLabel: 'Duration:',
    startingLabel: 'Starting:',
    groupLabel: 'Group:',
    groupVal: 'Private & Custom',
    guideLabel: 'Guide:',
    guideVal: 'EN / FR / ES / IT',
    transportLabel: 'Transport:',
    transportVal: 'Private A/C Vehicle',
    downloadPdf: 'Download Tour Brochure (PDF in English)',
    whatsAppUs: 'WhatsApp Us',
    instantReserve: 'INSTANT RESERVE',
