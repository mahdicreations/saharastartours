      { value: 'Grupo 5+', label: 'Grupo 5+' },
    ],
    specialRequests: 'Peticiones especiales o preguntas...',
    sendInquiry: 'Enviar Consulta',
    requestReceived: '¡Solicitud Recibida!',
    returnExploring: 'Volver a Explorar',
    quickInfo: 'Información Rápida',
    durationLabel: 'Duración:',
    startingLabel: 'Salida:',
    groupLabel: 'Grupo:',
    groupVal: 'Privado y a Medida',
    guideLabel: 'Guía:',
    guideVal: 'EN / FR / ES / IT',
    transportLabel: 'Transporte:',
    transportVal: 'Vehículo Privado A/C',
    downloadPdf: 'Descargar Folleto (PDF en Inglés)',
    whatsAppUs: 'Escríbenos por WhatsApp',
    instantReserve: 'RESERVA INMEDIATA',
    bookNowBtn: 'Reservar Ahora ↓',
    bookNowNav: 'Reservar Ahora',
    fallbackFaqs: [
      {
        question: '¿Qué tipo de equipaje y ropa debo llevar para este viaje?',
        answer: 'Recomendamos calzado cómodo para caminar por medinas empedradas y dunas, ropa holgada y transpirable de algodón para el día, y un forro polar o chaqueta abrigada para las noches frescas del desierto y puertos de montaña. Gafas de sol, protector solar, sombrero y cámara son imprescindibles.',
      },
      {
        question: '¿Se puede personalizar este itinerario y la categoría de alojamiento?',
        answer: '¡Sí, por supuesto! Cada viaje de Sahara Star Tours es 100% privado y personalizable. Podemos ajustar el ritmo, ciudad de salida, categoría de hoteles (Riads Estándar, Boutique Confort o Campamentos de Lujo 5 estrellas) y añadir paradas exclusivas según tus preferencias.',
      },
      {
        question: '¿Dónde se realizan la recogida y el regreso?',
        answer: `Ofrecemos recogida y regreso puerta a puerta directamente en tu hotel, riad o aeropuerto en ${startingFrom}. Tu chófer/guía privado te recibirá puntualmente con un cartel personalizado.`,
      },
      {
        question: '¿Se adaptan a necesidades dietéticas especiales?',
        answer: 'Sí, todos nuestros riads asociados y los chefs de nuestro campamento en el desierto del Sáhara atienden con gusto dietas vegetarianas, veganas, halal y sin gluten. Solo indícanos tus preferencias al hacer la reserva.',
      },
      {
        question: '¿Cómo funcionan las reservas y los depósitos?',
        answer: 'Tras enviar tu consulta, nuestros especialistas locales en Marrakech confirmarán la disponibilidad y te enviarán el bono oficial del itinerario. Un depósito seguro confirma tus fechas mediante tarjeta, PayPal o transferencia, abonándose el resto a tu llegada a Marruecos.',
      },
    ],
  },
  it: {
    fromPrefix: 'Partenza:',
    overview: 'Panoramica',
    itinerary: 'Itinerario',
    gallery: 'Galleria',
    included: 'Incluso',
    map: 'Mappa',
    faq: 'FAQ',
    startingFrom: 'A partire da',
    bookThisTour: 'Prenota Questo Tour',
    aboutTour: 'Informazioni su Questo Tour',
    highlights: 'Punti Salienti:',
    programItinerary: 'Itinerario Dettagliato',
    expeditionGallery: 'Galleria Fotografica della Spedizione',
    gallerySubtitle: 'Uno sguardo visivo agli spettacolari paesaggi che ti attendono.',
    inclusionsHeading: 'Servizi Inclusi e Dettagli del Viaggio',
    whatsIncluded: 'Cosa è Incluso',
    notIncluded: 'Non Incluso',
    faqHeading: 'Domande Frequenti',
    relatedHeading: 'Itinerari Simili Consigliati',
    relatedStarting: 'A partire da',
    travelStyle: 'Stile di Viaggio',
    styles: { Standard: 'Standard', Comfort: 'Comfort', Luxury: 'Lusso' } as Record<string, string>,
    fullName: 'Nome e Cognome',
    email: 'Indirizzo Email',
    prefDate: 'Data Preferita',
    groupSize: 'Numero di Persone',
    groupOptions: [
      { value: '1 Adulto', label: '1 Adulto' },
      { value: '2 Adulti', label: '2 Adulti', selected: true },
      { value: '3-4 Persone', label: '3 - 4 Persone' },
      { value: 'Gruppo 5+', label: 'Gruppo 5+' },
    ],
    specialRequests: 'Richieste speciali o domande...',
    sendInquiry: 'Invia Richiesta',
    requestReceived: 'Richiesta Ricevuta!',
    returnExploring: 'Torna ad Esplorare',
    quickInfo: 'Informazioni sul Tour',
    durationLabel: 'Durata:',
    startingLabel: 'Partenza:',
    groupLabel: 'Gruppo:',
    groupVal: 'Privato e su Misura',
    guideLabel: 'Guida:',
    guideVal: 'EN / FR / ES / IT',
    transportLabel: 'Trasporto:',
    transportVal: 'Veicolo Privato A/C',
    downloadPdf: 'Scarica Brochure (PDF in Inglese)',
    whatsAppUs: 'Contattaci su WhatsApp',
    instantReserve: 'PRENOTAZIONE IMMEDIATA',
    bookNowBtn: 'Prenota Ora ↓',
    bookNowNav: 'Prenota Ora',
    fallbackFaqs: [
      {
        question: 'Che tipo di bagaglio e abbigliamento dovrei portare per questo viaggio?',
        answer: 'Consigliamo scarpe comode per camminare sui ciottoli delle medine e sulle dune, abiti leggeri e traspiranti in cotone per il giorno, e un pile o giacca calda per le serate fresche nel deserto e sui passi montani. Occhiali da sole, crema solare, cappello e macchina fotografica sono essenziali.',
      },
      {
        question: 'È possibile personalizzare questo itinerario e il livello degli alloggi?',
        answer: 'Assolutamente sì! Ogni viaggio di Sahara Star Tours è al 100% privato e personalizzabile. Possiamo modificare i ritmi, la città di partenza, la categoria degli alloggi (Riad Standard, Boutique Comfort o Campi Tendati di Lusso 5 Stelle) e aggiungere tappe uniche.',
      },
      {
        question: 'Dove avvengono il punto di incontro e il rientro?',
        answer: `Garantiamo il servizio di pick-up e drop-off direttamente presso il tuo hotel, riad o aeroporto a ${startingFrom}. Il tuo autista/guida privato ti accoglierà con un cartello personalizzato.`,
      },
      {
        question: 'Vengono gestite esigenze alimentari particolari?',
        answer: 'Sì, tutti i riad convenzionati e gli chef del nostro campo tendato nel Sahara preparano con cura menù vegetariani, vegani, halal e senza glutine. È sufficiente comunicarcelo al momento della prenotazione.',
      },
      {
        question: 'Come funzionano le prenotazioni e gli acconti?',
        answer: "Dopo aver inviato la richiesta, i nostri consulenti a Marrakech verificheranno la disponibilità e invieranno il voucher ufficiale dell'itinerario. Un piccolo acconto garantisce le date tramite carta di credito, PayPal o bonifico, con il saldo restante versato comodamente all'arrivo.",
      },
    ],
  },
}[currentLang];

// Departure city hubs mapping per language
const citySlugMap: Record<string, Record<string, { label: string; path: string }>> = {
  en: {
    marrakech: { label: 'Tours from Marrakech', path: '/tours-from-marrakech' },
    casablanca: { label: 'Tours from Casablanca', path: '/tours-from-casablanca' },
    fes: { label: 'Tours from Fes', path: '/tours-from-fes' },
    tangier: { label: 'Tours from Tangier', path: '/tours-from-tangier' },
    ouarzazate: { label: 'Tours from Ouarzazate', path: '/tours-from-ouarzazate' },
  },
  es: {
    marrakech: { label: 'Circuitos desde Marrakech', path: '/es/tours-from-marrakech' },
    casablanca: { label: 'Circuitos desde Casablanca', path: '/es/tours-from-casablanca' },
    fes: { label: 'Circuitos desde Fez', path: '/es/tours-from-fes' },
    tangier: { label: 'Circuitos desde Tánger', path: '/es/tours-from-tangier' },
    ouarzazate: { label: 'Circuitos desde Ouarzazate', path: '/es/tours-from-ouarzazate' },
  },
  it: {
    marrakech: { label: 'Tour da Marrakech', path: '/it/tours-from-marrakech' },
    casablanca: { label: 'Tour da Casablanca', path: '/it/tours-from-casablanca' },
    fes: { label: 'Tour da Fes', path: '/it/tours-from-fes' },
    tangier: { label: 'Tour da Tangeri', path: '/it/tours-from-tangier' },
    ouarzazate: { label: 'Tour da Ouarzazate', path: '/it/tours-from-ouarzazate' },
  },
};

const homeBreadcrumbs: Record<string, { name: string; url: string }> = {
  en: { name: 'Home', url: '/' },
  es: { name: 'Inicio', url: '/es' },
  it: { name: 'Home', url: '/it' },
};

const productBreadcrumbs: Record<string, Record<string, { name: string; url: string }>> = {
  en: {
    'day-trip': { name: 'Day Trips', url: '/day-trips' },
    'activity': { name: 'Activities', url: '/activities' },
    'multi-day': { name: 'Multi-Day Tours', url: '/tours' },
  },
  es: {
    'day-trip': { name: 'Excursiones de un Día', url: '/es/day-trips' },
    'activity': { name: 'Actividades', url: '/es/activities' },
    'multi-day': { name: 'Circuitos Multidía', url: '/es/tours' },
  },
  it: {
    'day-trip': { name: 'Escursioni Giornaliere', url: '/it/day-trips' },
    'activity': { name: 'Attività', url: '/it/activities' },
    'multi-day': { name: 'Tour di Più Giorni', url: '/it/tours' },
  },
};

interface BreadcrumbItem {
  name: string;
  url: string;
}

const breadcrumbs: BreadcrumbItem[] = [
  homeBreadcrumbs[currentLang],
];

const productTypeKey = productType === 'day-trip' || productType === 'activity' ? productType : 'multi-day';
breadcrumbs.push(productBreadcrumbs[currentLang][productTypeKey]);

if (productTypeKey === 'multi-day') {
  const cityKey = departureCity ? departureCity.toLowerCase().trim() : '';
  const cityEntry = citySlugMap[currentLang]?.[cityKey];
  if (cityEntry) {
    breadcrumbs.push({
      name: cityEntry.label,
      url: cityEntry.path,
    });
  }
}

// Current page item (no link in HTML navigation)
breadcrumbs.push({ name: tourName, url: '' });

// BreadcrumbList JSON-LD
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((b, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": b.name,
    "item": b.url ? `https://www.saharastartours.com${b.url}` : currentCanonicalUrl
  }))
};

// Build Tour schema (TouristTrip with authentic visible page content only)
const touristTripEntity = {
  "@type": "TouristTrip",
  "name": tourName,
  "description": description,
  "image": `https://www.saharastartours.com${heroImage}`,
  "url": currentCanonicalUrl,
  "inLanguage": currentLang === 'es' ? 'es-ES' : (currentLang === 'it' ? 'it-IT' : 'en-US'),
  ...(resolvedTouristType ? { "touristType": resolvedTouristType } : {}),
  "provider": {
    "@type": "TravelAgency",
    "name": "Sahara Star Tours",
    "url": "https://www.saharastartours.com"
  },
  ...(itinerary && itinerary.length > 0 ? {
    "itinerary": {
      "@type": "ItemList",
      "numberOfItems": itinerary.length,
      "itemListElement": itinerary.map((item, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": item.title,
        "description": item.content ? item.content.replace(/<[^>]*>/g, '').trim() : ''
      }))
    }
  } : {})
};

const tourSchema = schemaData ?? {
  "@context": "https://schema.org",
  "@graph": [
    touristTripEntity,
    breadcrumbSchema
  ]
};

const categoryLabels: Record<string, Record<string, string>> = {
  en: {
    'desert-tours': 'Desert Tours',
    'imperial-cities': 'Imperial Cities',
    'day-trips': 'Day Trips',
    'activities': 'Activities',
  },
  es: {
    'desert-tours': 'Circuitos por el Desierto',
    'imperial-cities': 'Ciudades Imperiales',
    'day-trips': 'Excursiones de un Día',
    'activities': 'Actividades',
  },
  it: {
    'desert-tours': 'Tour del Deserto',
    'imperial-cities': 'Città Imperiali',
    'day-trips': 'Escursioni Giornaliere',
    'activities': 'Attività',
  },
};
const catNormalized = category.toLowerCase().replace(/\s+/g, '-');
const localizedCategory = categoryLabels[currentLang]?.[catNormalized] ?? category;

const getTourDetailHref = (slug: string) => currentLang === 'en' ? `/tours/${slug}` : `/${currentLang}/tours/${slug}`;
const cleanPriceVal = price.replace(/^(From|Desde|A partire da)\s*/i, '').trim();

const galleryJSON = JSON.stringify(galleryImages);
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogImage={ogImage ?? heroImage}
  currentPage="tours"
  schemaData={tourSchema}
  lang={currentLang}
  locale={activeLocale}
  alternateUrls={resolvedAlternateUrls}
>
  <!-- Tour Hero Section -->
  <section class="tour-hero-section">
    <div class="tour-hero-bg">
      <img 
        src={heroImage} 
        alt={tourName} 
        fetchpriority="high"
        loading="eager"
        onerror="this.src='/assets/placeholder-morocco.svg'"
      />
    </div>
    <div class="tour-hero-gradient"></div>
    <div class="tour-hero-content">
      <nav class="tour-breadcrumbs" aria-label="Breadcrumb">
        {breadcrumbs.map((b, idx) => (
          <>
            {idx > 0 && <span class="sep" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></span>}
            {b.url ? (
              <a href={b.url}>{b.name}</a>
            ) : (
              <span class="current" aria-current="page">{b.name}</span>
            )}
          </>
        ))}
      </nav>
      <span class="tour-tag">{localizedCategory}</span>
      <h1>{tourName}</h1>
      <div class="tour-quick-meta">
        <span><i class="fa-regular fa-clock"></i> <strong>{duration}</strong></span>
        <span><i class="fa-solid fa-location-dot"></i> {l10n.fromPrefix} <strong>{startingFrom}</strong></span>
      </div>
    </div>
  </section>

  <!-- ==============================================
       DESKTOP LUXURY STICKY SUB-NAV (OPTION 1)
       ============================================== -->
  <nav class="tour-subnav-desktop" id="tour-subnav-desktop" aria-label="Tour navigation">
    <div class="tour-subnav-container">
      <div class="tour-subnav-items">
        <a href="#tour-about" class="subnav-link active" data-section="tour-about">
          <i class="fa-solid fa-circle-info"></i> <span>{l10n.overview}</span>
        </a>
        {itinerary.length > 0 && (
          <a href="#tour-itinerary" class="subnav-link" data-section="tour-itinerary">
            <i class="fa-solid fa-route"></i> <span>{l10n.itinerary}</span>
          </a>
        )}
        {galleryImages.length > 0 && (
          <a href="#tour-gallery" class="subnav-link" data-section="tour-gallery">
            <i class="fa-solid fa-images"></i> <span>{l10n.gallery}</span>
          </a>
        )}
        <a href="#tour-inclusions" class="subnav-link" data-section="tour-inclusions">
          <i class="fa-solid fa-list-check"></i> <span>{l10n.included}</span>
        </a>
        {mapDestinations.length > 0 && (
          <a href="#tour-map" class="subnav-link" data-section="tour-map">
            <i class="fa-solid fa-map-location-dot"></i> <span>{l10n.map}</span>
          </a>
        )}
        <a href="#tour-faq" class="subnav-link" data-section="tour-faq">
          <i class="fa-solid fa-circle-question"></i> <span>{l10n.faq}</span>
        </a>
      </div>
      <div class="tour-subnav-cta">
        <div class="subnav-price-chip">
          <span class="subnav-price-lbl">{l10n.startingFrom}</span>
          <strong class="subnav-price-val">{cleanPriceVal}</strong>
        </div>
        <a href="#booking-form" class="subnav-book-btn">
          <i class="fa-solid fa-calendar-check"></i> <span>{l10n.bookThisTour}</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- Page Content Slot + Sidebar Grid -->
  <div 
    class="tour-container" 
    id="tour-detail-container"
    x-data={`{
      lightboxOpen: false,
      activeIndex: 0,
      images: ${galleryJSON},
      bookingData: {
        name: '',
        email: '',
        package: '${tourSlug}',
        travelers: '${l10n.groupOptions.find(o => o.selected)?.value || '2 Adults'}',
        date: '',
        style: 'Standard',
        message: ''
      },
      showSuccessModal: false,
      successMsg: '',
      openLightbox(idx) {
        this.activeIndex = idx;
        this.lightboxOpen = true;
      },
      prevImage() {
        this.activeIndex = (this.activeIndex - 1 + this.images.length) % this.images.length;
      },
      nextImage() {
        this.activeIndex = (this.activeIndex + 1) % this.images.length;
      },
      submitBooking() {
        const langCode = '${currentLang}';
        const tName = ${JSON.stringify(tourName)};
        if (langCode === 'es') {
          this.successMsg = '¡Shukran, ' + this.bookingData.name + '! Tu consulta para ' + tName + ' ha sido registrada. Nuestros diseñadores de viajes en Marrakech te enviarán tu itinerario personalizado detallado a ' + this.bookingData.email + ' en menos de 24 horas.';
        } else if (langCode === 'it') {
          this.successMsg = 'Shukran, ' + this.bookingData.name + '! La tua richiesta per ' + tName + ' è stata registrata. I nostri consulenti di viaggio a Marrakech ti invieranno l\\'itinerario personalizzato dettagliato a ' + this.bookingData.email + ' entro 24 ore.';
        } else {
          this.successMsg = 'Shukran, ' + this.bookingData.name + '! Your inquiry for ' + tName + ' has been registered. Our travel designers in Marrakech will send your detailed personalized itinerary to ' + this.bookingData.email + ' within 24 hours.';
        }
        this.showSuccessModal = true;
        document.body.style.overflow = 'hidden';
      },
      closeModal() {
        this.showSuccessModal = false;
        document.body.style.overflow = '';
      }
    }`}
    @keydown.escape.window="if(lightboxOpen) lightboxOpen = false; if(showSuccessModal) closeModal();"
    @keydown.left.window="if(lightboxOpen) prevImage();"
    @keydown.right.window="if(lightboxOpen) nextImage();"
