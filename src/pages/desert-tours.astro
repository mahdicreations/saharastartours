---
// src/pages/desert-tours.astro — Desert tours category page
import BaseLayout from '../layouts/BaseLayout.astro';
import { getToursByCategory } from '../data/tours';

const desertTours = getToursByCategory('desert-tours');
---

<BaseLayout
  title="Desert Tours Morocco | Sahara Star Tours"
  description="Explore Morocco desert tours from Casablanca and Marrakech. Erg Chebbi glamping, camel treks, High Atlas passes, and custom Sahara safaris from 3 to 16 days."
  keywords="morocco desert tours, sahara camel trek, erg chebbi tour, merzouga tour, casablanca desert tour, marrakech desert tour"
  currentPage="desert-tours"
>

<section class="cat-hero">
  <span class="tag" style="display:inline-block;color:var(--sand-gold);text-transform:uppercase;letter-spacing:3px;font-size:0.9rem;font-weight:600;margin-bottom:12px;">Morocco Desert Tours</span>
  <h1 style="font-size:3rem;max-width:700px;margin:0 auto 20px;background:linear-gradient(135deg,var(--text-main) 30%,var(--sand-gold) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">Sahara Desert Tours &amp; Expeditions</h1>
  <p style="max-width:650px;margin:0 auto;font-size:1.1rem;">From the golden dunes of Erg Chebbi to the red kasbahs of the Draa Valley — our curated desert tours deliver the most authentic Moroccan experiences.</p>
</section>

<section style="padding: 60px 5%; max-width: 1400px; margin: 0 auto;">
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:32px;">
    {desertTours.map(tour => (
      <article class="tour-card reveal active">
        <div class="tour-img-wrapper">
          <img src={tour.heroImage} alt={tour.shortTitle} loading="lazy" onerror="this.src='/assets/hero_sahara_sunset.png'" />
          {tour.badge && <span class="tour-badge">{tour.badge}</span>}
        </div>
        <div class="tour-info">
          <div class="tour-meta">
            <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
            <div><i class="fa-solid fa-location-dot"></i> {tour.startingFrom}</div>
          </div>
          <h2 class="tour-title">{tour.shortTitle}</h2>
          <p class="tour-desc">{tour.description}</p>
          <div class="tour-footer">
            <div class="tour-price">
              <span class="tour-price-label">Starting from</span>
              <span class="tour-price-value">{tour.price.replace(/^From\s*/i, '').replace(/\/person\s*/i, '').trim()}</span>
            </div>
            <a href={`/tours/${tour.slug}`} class="btn btn-primary btn-sm">View Tour <i class="fa-solid fa-arrow-right"></i></a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

</BaseLayout>
