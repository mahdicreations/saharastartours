---
// src/pages/it/trip-cost-calculator.astro — Italian Morocco Trip Cost Calculator
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAlternateUrls } from '../../data/i18n';

const alternateUrls = getAlternateUrls('/trip-cost-calculator');

const calcSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Calcolatore dei Costi di Viaggio in Marocco | Sahara Star Tours",
  "url": alternateUrls.it,
  "description": "Calcolatore interattivo del budget per viaggi in Marocco: stima tour privati su misura, safari nel deserto e itinerari nelle città imperiali.",
  "applicationCategory": "TravelApplication",
  "operatingSystem": "All"
};
---

<BaseLayout
  title="Calcolatore dei Costi di Viaggio in Marocco | Sahara Star Tours"
  description="Calcola il preventivo del tuo viaggio su misura in Marocco in pochi secondi. Scegli durata, partecipanti, categoria di alloggio ed esperienze con prezzi trasparenti."
  keywords="calcolatore viaggio marocco, budget viaggio marocco, quanto costa un tour in marocco, costo tour deserto merzouga"
  currentPage="calculator"
  lang="it"
  alternateUrls={alternateUrls}
  schemaData={calcSchema}
>
  <!-- Calculator Hero Header -->
  <section class="calc-page-hero">
    <div class="calc-hero-bg">
      <img src="/assets/hero_sahara_sunset.png" alt="Calcolatore di Viaggio in Marocco" />
    </div>
    <div class="calc-hero-gradient"></div>
    <div class="calc-hero-content">
      <span class="calc-hero-tag"><i class="fa-solid fa-calculator"></i> Prezzi 100% Trasparenti</span>
      <h1>Calcolatore Preventivo <span>Viaggio Marocco</span></h1>
      <p>Stima il costo del tuo itinerario privato in Marocco in pochi secondi. Personalizza durata, numero di partecipanti, categoria di hotel ed esperienze con prezzi in tempo reale.</p>
    </div>
  </section>

  <!-- Interactive Calculator Section -->
  <section class="calc-main-section">
    <div 
      class="calculator-container"
      x-data="{
        days: 7,
        people: 2,
        tier: 'comfort',
        addons: { camel: true, balloon: false, private: true },
        tiers: { standard: 120, comfort: 195, luxury: 320 },
        get base() { return this.days * this.people * this.tiers[this.tier]; },
        get addonTotal() {
          return (this.addons.camel ? 45 * this.people : 0)
            + (this.addons.balloon ? 180 * this.people : 0)
            + (this.addons.private ? 80 * this.days : 0);
        },
        get total() { return this.base + this.addonTotal; },
        get perPerson() { return Math.round(this.total / this.people); },
        get whatsappLink() {
          const text = encodeURIComponent(
            `Salve! Ho utilizzato il vostro Calcolatore per un tour di ${this.days} giorni per ${this.people} persone (stile ${this.tier.toUpperCase()}). Preventivo stimato: $${this.total.toLocaleString()}. Potete inviarmi una proposta ufficiale dettagliata?`
          );
          return `https://wa.me/212678317015?text=${text}`;
        }
      }"
    >
      <!-- LEFT: CONTROLS & INPUTS -->
      <div class="calc-inputs">
        <div class="calc-header-box">
          <span class="step-num">Passo 1 di 2</span>
          <h3>Personalizza i Parametri del Tuo Viaggio</h3>
          <p>Regola i selettori per aggiornare la stima del tuo viaggio in tempo reale.</p>
        </div>

        <!-- 1. Duration Slider -->
        <div class="calc-group">
          <div class="calc-label-row">
            <label><i class="fa-regular fa-clock"></i> Durata del Tour</label>
            <span class="calc-value" x-text="days + ' Giorni / ' + (days - 1) + ' Notti'"></span>
          </div>
          <div class="range-slider-wrap">
            <input type="range" min="3" max="16" x-model.number="days" aria-label="Durata del tour in giorni" />
            <div class="range-ticks">
              <span>3 Giorni</span>
              <span>7 Giorni</span>
              <span>10 Giorni</span>
              <span>16 Giorni</span>
            </div>
          </div>
        </div>

        <!-- 2. Group Size Slider -->
        <div class="calc-group">
          <div class="calc-label-row">
            <label><i class="fa-solid fa-users"></i> Numero di Partecipanti</label>
            <span class="calc-value" x-text="people + (people === 1 ? ' Viaggiatore Singolo' : ' Partecipanti')"></span>
          </div>
          <div class="range-slider-wrap">
            <input type="range" min="1" max="12" x-model.number="people" aria-label="Numero di partecipanti" />
            <div class="range-ticks">
              <span>1 Persona</span>
              <span>2 (Coppie)</span>
              <span>4 - 6</span>
              <span>12 (Gruppo)</span>
            </div>
          </div>
        </div>

        <!-- 3. Accommodation Tier -->
        <div class="calc-group">
          <div class="calc-label-row">
            <label><i class="fa-solid fa-hotel"></i> Categoria di Alloggio</label>
            <span class="tier-hint" x-text="tier === 'standard' ? 'Riad Autentici e Tende Tradizionali' : (tier === 'comfort' ? 'Boutique Riad 4 Stelle e Campo Privato' : 'Palazzi Storici 5 Stelle e Glamping Reale VIP')"></span>
          </div>
          <div class="tier-cards">
            <div 
              class="tier-card" 
              :class="tier === 'standard' ? 'active' : ''" 
              @click="tier = 'standard'"
              role="button"
              tabindex="0"
            >
              <div class="tier-icon"><i class="fa-solid fa-tent"></i></div>
              <span class="tier-name">Standard</span>
              <span class="tier-rate">$120 / giorno</span>
              <small>Riad autentici, camere private e campo tendato berbero nel deserto</small>
            </div>

            <div 
              class="tier-card" 
              :class="tier === 'comfort' ? 'active' : ''" 
              @click="tier = 'comfort'"
              role="button"
              tabindex="0"
            >
              <div class="tier-pop-badge">Più Richiesto</div>
              <div class="tier-icon"><i class="fa-solid fa-hotel"></i></div>
              <span class="tier-name">Comfort</span>
              <span class="tier-rate">$195 / giorno</span>
              <small>Boutique riad 4 stelle con corte interna e tende di lusso con bagno privato</small>
            </div>

            <div 
              class="tier-card" 
              :class="tier === 'luxury' ? 'active' : ''" 
              @click="tier = 'luxury'"
              role="button"
              tabindex="0"
            >
              <div class="tier-icon"><i class="fa-solid fa-star"></i></div>
              <span class="tier-name">Lusso VIP</span>
              <span class="tier-rate">$320 / giorno</span>
              <small>Palazzi storici 5 stelle, suite private e glamping reale tra le dune</small>
            </div>
          </div>
        </div>

        <!-- 4. Signature Add-Ons -->
        <div class="calc-group">
          <div class="calc-label-row">
            <label><i class="fa-solid fa-wand-magic-sparkles"></i> Esperienze Esclusive e Upgrade</label>
          </div>
          <div class="addons-grid">
            <div 
              class="addon-item" 
              :class="addons.camel ? 'active' : ''" 
              @click="addons.camel = !addons.camel"
              role="button"
              tabindex="0"
            >
              <input type="checkbox" :checked="addons.camel" aria-label="Trekking in Cammello al Tramonto" />
              <div class="addon-icon-box"><i class="fa-solid fa-mountain-sun"></i></div>
              <div class="addon-details">
                <span class="addon-name">Cammellata al Tramonto</span>
                <span class="addon-sub">Safari tra le dune dell'Erg Chebbi</span>
                <span class="addon-price">+$45 / persona</span>
              </div>
            </div>

            <div 
              class="addon-item" 
              :class="addons.balloon ? 'active' : ''" 
              @click="addons.balloon = !addons.balloon"
              role="button"
              tabindex="0"
            >
              <input type="checkbox" :checked="addons.balloon" aria-label="Volo in Mongolfiera all'Alba" />
              <div class="addon-icon-box"><i class="fa-solid fa-cloud"></i></div>
              <div class="addon-details">
                <span class="addon-name">Mongolfiera all'Alba</span>
                <span class="addon-sub">Volo panoramico sulle pendici dell'Atlante</span>
                <span class="addon-price">+$180 / persona</span>
              </div>
            </div>

            <div 
              class="addon-item" 
              :class="addons.private ? 'active' : ''" 
              @click="addons.private = !addons.private"
              role="button"
              tabindex="0"
            >
              <input type="checkbox" :checked="addons.private" aria-label="Autista Dedicato Mercedes VIP" />
              <div class="addon-icon-box"><i class="fa-solid fa-car-side"></i></div>
              <div class="addon-details">
                <span class="addon-name">Autista Mercedes VIP Privato</span>
                <span class="addon-sub">Trasporto privato di alta gamma</span>
                <span class="addon-price">+$80 / giorno</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT: STICKY LIVE ESTIMATE SUMMARY -->
      <div class="calc-summary-wrapper">
        <div class="calc-summary">
          <div class="calc-summary-head">
            <span class="step-num">Passo 2 di 2</span>
            <h4>Il Tuo Preventivo in Tempo Reale</h4>
            <span class="live-pill"><span class="pulse-dot"></span> Live</span>
          </div>

          <ul class="calc-summary-details">
            <li>
              <span><i class="fa-regular fa-calendar"></i> Durata:</span>
              <strong x-text="days + ' giorni'"></strong>
            </li>
            <li>
              <span><i class="fa-solid fa-user-group"></i> Partecipanti:</span>
              <strong x-text="people + ' partecipanti'"></strong>
            </li>
            <li>
              <span><i class="fa-solid fa-bed"></i> Alloggio:</span>
              <strong x-text="tier === 'standard' ? 'Standard' : (tier === 'comfort' ? 'Comfort' : 'Lusso VIP')"></strong>
            </li>
            <li>
              <span><i class="fa-solid fa-coins"></i> Costo base del tour:</span>
              <strong x-text="'$' + base.toLocaleString()"></strong>
            </li>
            <li>
              <span><i class="fa-solid fa-plus-circle"></i> Upgrade selezionati:</span>
              <strong x-text="'$' + addonTotal.toLocaleString()"></strong>
            </li>
          </ul>

          <div class="calc-total-box">
            <span class="total-label">Totale Pacchetto Stimato</span>
            <div class="total-amount" x-text="'$' + total.toLocaleString()"></div>
            <div class="per-person-rate" x-text="'Circa $' + perPerson.toLocaleString() + ' a persona'"></div>
          </div>

          <div class="discount-badge">
            <i class="fa-solid fa-tags"></i>
            <span>Prenotando in anticipo risparmi fino al <strong>15%</strong></span>
          </div>

          <div class="calc-actions-col">
            <a href="/it/contact" class="btn btn-primary" style="width:100%;justify-content:center;gap:10px;">
              <i class="fa-solid fa-paper-plane"></i> Blocca il Mio Preventivo Gratuito
            </a>
            <a :href="whatsappLink" target="_blank" rel="noopener" class="btn btn-secondary calc-wa-btn" style="width:100%;justify-content:center;gap:10px;">
              <i class="fa-brands fa-whatsapp" style="color:#25D366;font-size:1.2rem;"></i> Scrivici su WhatsApp
            </a>
          </div>

          <div class="calc-trust-footer">
            <span><i class="fa-solid fa-shield-halved"></i> Nessuna carta di credito</span>
            <span><i class="fa-solid fa-handshake"></i> Consulenza 100% gratuita</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ / TRANSPARENT PRICING INFO -->
  <section class="calc-faq-section">
    <div class="section-header reveal active">
      <span class="tag">Prezzi Chiari</span>
      <h2>Domande Frequenti sui Costi di Viaggio</h2>
      <p>Tutto quello che c'è da sapere sulle tariffe dei nostri itinerari privati su misura in Marocco.</p>
    </div>

    <div class="calc-faq-grid">
      <div class="calc-faq-card">
        <h4><i class="fa-solid fa-circle-check"></i> Cosa include esattamente il prezzo stimato?</h4>
        <p>Tutti i preventivi includono veicolo privato moderno con aria condizionata e carburante, autista professionista per l'intero viaggio, pernottamenti con mezza pensione (colazioni e cene nel deserto), cammellata tra le dune e tasse turistiche locali.</p>
      </div>

      <div class="calc-faq-card">
        <h4><i class="fa-solid fa-circle-check"></i> Ci sono supplementi per viaggiatori singoli o coppie?</h4>
        <p>Trattandosi di un trasporto interamente privato, i piccoli gruppi (1 o 2 persone) coprono l'intero costo del veicolo e dell'autista. A partire da 3 o 4 persone, la quota individuale per partecipante diminuisce notevolmente.</p>
      </div>

      <div class="calc-faq-card">
        <h4><i class="fa-solid fa-circle-check"></i> Come funzionano il pagamento e l'acconto?</h4>
        <p>È richiesto un piccolo acconto del 20% per confermare i riad e i campamenti boutique. Il saldo residuo viene saldato comodamente all'arrivo a Marrakech o Casablanca in contanti o con carta.</p>
      </div>

      <div class="calc-faq-card">
        <h4><i class="fa-solid fa-circle-check"></i> Posso modificare i dettagli dopo la richiesta?</h4>
        <p>Assolutamente sì! Questo calcolatore fornisce una stima di riferimento. Una volta inviata la richiesta, i nostri designer adatteranno tappe, hotel ed esperienze fino a creare l'itinerario perfetto per te.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .calc-page-hero {
    position: relative;
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 130px 20px 70px;
    overflow: hidden;
  }
  .calc-hero-bg {
    position: absolute;
    inset: 0;
  }
  .calc-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.4) contrast(1.1);
  }
  .calc-hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17,14,13,0.3) 0%, rgba(17,14,13,0.85) 75%, var(--night-bg) 100%);
  }
  .calc-hero-content {
    position: relative;
    z-index: 2;
    max-width: 860px;
    margin: 0 auto;
  }
  .calc-hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(232, 195, 158, 0.15);
    border: 1px solid rgba(232, 195, 158, 0.3);
    color: var(--sand-gold);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 6px 16px;
    border-radius: 20px;
    margin-bottom: 16px;
  }
  .calc-hero-content h1 {
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    font-family: var(--font-serif);
    color: var(--text-main);
    line-height: 1.2;
    margin-bottom: 16px;
  }
  .calc-hero-content h1 span {
    color: var(--sand-gold);
    font-style: italic;
  }
  .calc-hero-content p {
    font-size: 1.15rem;
    color: rgba(255,255,255,0.85);
    line-height: 1.7;
    max-width: 720px;
    margin: 0 auto;
  }

  /* CALCULATOR LAYOUT */
  .calc-main-section {
    padding: 40px 20px 90px;
    background: var(--night-bg);
  }
  .calculator-container {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
    align-items: start;
  }

  /* LEFT INPUTS */
  .calc-inputs {
    background: var(--night-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 40px;
    box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .calc-header-box .step-num {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--sand-gold);
    display: block;
    margin-bottom: 6px;
  }
  .calc-header-box h3 {
    font-size: 1.6rem;
    font-family: var(--font-serif);
    color: var(--text-main);
    margin: 0 0 6px;
  }
  .calc-header-box p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
  }

  .calc-group {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .calc-group:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .calc-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .calc-label-row label {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .calc-label-row label i {
    color: var(--sand-gold);
  }
  .calc-value {
    background: rgba(232, 195, 158, 0.12);
    border: 1px solid rgba(232, 195, 158, 0.25);
    color: var(--sand-gold);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 4px 12px;
    border-radius: 20px;
  }
  .tier-hint {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-style: italic;
  }

  /* RANGE SLIDER */
  .range-slider-wrap {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .range-slider-wrap input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 8px;
    border-radius: 4px;
    background: rgba(255,255,255,0.12);
    outline: none;
    cursor: pointer;
    transition: background 0.2s;
  }
  .range-slider-wrap input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--sand-gold);
    cursor: pointer;
    box-shadow: 0 0 10px rgba(232, 195, 158, 0.6);
    transition: transform 0.15s, background-color 0.15s;
  }
  .range-slider-wrap input[type="range"]::-webkit-slider-thumb:hover {
    transform: scale(1.15);
    background: #f4d3b2;
  }
  .range-slider-wrap input[type="range"]::-moz-range-thumb {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--sand-gold);
    cursor: pointer;
    border: none;
    box-shadow: 0 0 10px rgba(232, 195, 158, 0.6);
  }
  .range-ticks {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--text-muted);
    padding: 0 4px;
  }

  /* TIER CARDS */
  .tier-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .tier-card {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--radius-sm);
    padding: 20px 14px;
    text-align: center;
    cursor: pointer;
    transition: all 0.25s;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .tier-card:hover {
    border-color: rgba(232, 195, 158, 0.4);
    transform: translateY(-2px);
  }
  .tier-card.active {
    background: rgba(232, 195, 158, 0.08);
    border-color: var(--sand-gold);
    box-shadow: 0 0 0 2px rgba(232, 195, 158, 0.25);
  }
  .tier-pop-badge {
    position: absolute;
    top: -10px;
    background: var(--sand-gold);
    color: #110e0d;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 2px 8px;
    border-radius: 10px;
  }
  .tier-icon {
    font-size: 1.5rem;
    color: var(--sand-gold);
    margin-bottom: 4px;
  }
  .tier-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-main);
  }
  .tier-rate {
    font-size: 0.85rem;
    color: var(--sand-gold);
    font-weight: 600;
  }
  .tier-card small {
    font-size: 0.74rem;
    color: var(--text-muted);
    line-height: 1.35;
    margin-top: 4px;
  }

  /* ADDONS GRID */
  .addons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
  }
  .addon-item {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-sm);
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .addon-item:hover {
    border-color: rgba(232, 195, 158, 0.3);
  }
  .addon-item.active {
    background: rgba(232, 195, 158, 0.06);
    border-color: var(--sand-gold);
  }
  .addon-item input[type="checkbox"] {
    accent-color: var(--sand-gold);
    width: 18px;
    height: 18px;
    cursor: pointer;
  }
  .addon-icon-box {
    font-size: 1.25rem;
    color: var(--sand-gold);
  }
  .addon-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .addon-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-main);
  }
  .addon-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .addon-price {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--sand-gold);
    margin-top: 2px;
  }

  /* RIGHT STICKY SUMMARY */
  .calc-summary-wrapper {
    position: sticky;
    top: 110px;
  }
  .calc-summary {
    background: var(--night-card);
    border: 1px solid var(--sand-gold);
    border-radius: var(--radius-lg);
    padding: 36px 30px;
    box-shadow: 0 20px 45px rgba(0,0,0,0.5);
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .calc-summary-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    padding-bottom: 16px;
  }
  .calc-summary-head h4 {
    font-size: 1.3rem;
    font-family: var(--font-serif);
    color: var(--text-main);
    margin: 4px 0 0;
  }
  .live-pill {
    background: rgba(37, 211, 102, 0.15);
    color: #25D366;
