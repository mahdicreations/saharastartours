---
// src/pages/it/day-trips.astro — Italian Day Trips category page
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalizedDayTrips } from '../../data/toursI18n';
import { getAlternateUrls } from '../../data/i18n';

const tours = getLocalizedDayTrips('it');
const alternateUrls = getAlternateUrls('/day-trips');

const schemaData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Escursioni in Giornata da Marrakech | Sahara Star Tours",
  "description": "Le migliori escursioni in giornata da Marrakech: Essaouira, Ait Ben Haddou, Cascate di Ouzoud e Valle dell'Ourika con trasporto privato e guide locali.",
  "url": alternateUrls.it
};
---

<BaseLayout
  title="Escursioni in Giornata da Marrakech | Sahara Star Tours"
  description="Le migliori escursioni in giornata da Marrakech: Essaouira, Ait Ben Haddou, Cascate di Ouzoud e Valle dell'Ourika con trasporto privato e guide locali."
  currentPage="day-trips"
  lang="it"
  alternateUrls={alternateUrls}
  schemaData={schemaData}
>
<section class="cat-hero">
  <span class="tag" style="display:inline-block;color:var(--sand-gold);text-transform:uppercase;letter-spacing:3px;font-size:0.9rem;font-weight:600;margin-bottom:12px;">Escursioni di un Giorno</span>
  <h1 style="font-size:3rem;max-width:700px;margin:0 auto 20px;background:linear-gradient(135deg,var(--text-main) 30%,var(--sand-gold) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">Escursioni in Giornata da Marrakech</h1>
  <p style="max-width:650px;margin:0 auto;font-size:1.1rem;">Fughe perfette di un giorno da Marrakech verso l'Alto Atlante, la costa atlantica di Essaouira, il deserto di Agafay e i villaggi più suggestivi del Marocco.</p>
</section>
<section style="padding: 60px 5%; max-width: 1400px; margin: 0 auto;">
  {tours.length > 0 ? (
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:32px;">
      {tours.map(tour => (
        <article class="tour-card reveal active">
          <div class="tour-img-wrapper">
            <img src={tour.heroImage} alt={tour.shortTitle} loading="lazy" onerror="this.src='/assets/placeholder-morocco.svg'" />
            {tour.badge && <span class="tour-badge">{tour.badge}</span>}
          </div>
          <div class="tour-info">
            <div class="tour-meta">
              <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
              <div><i class="fa-solid fa-location-dot"></i> {tour.startingFrom}</div>
            </div>
            <h2 class="tour-title">{tour.shortTitle}</h2>
            <p class="tour-desc">{tour.description}</p>
            <div class="tour-footer">
              <div class="tour-price">
                <span class="tour-price-label">A partire da</span>
                <span class="tour-price-value">{tour.price.replace(/^(From|Desde|Da|A partire da)\s*/i, '').replace(/\/(persona|person)\s*/i, '').trim()}</span>
              </div>
              <a href={`/it/tours/${tour.slug}`} class="btn btn-primary btn-sm">Vedi Escursione <i class="fa-solid fa-arrow-right"></i></a>
            </div>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div style="text-align:center;padding:60px;color:var(--text-muted);">
      <i class="fa-solid fa-compass" style="font-size:3rem;color:var(--sand-gold);margin-bottom:20px;"></i>
      <p>Nuove escursioni in arrivo! Nel frattempo, <a href="/it/contact" style="color:var(--sand-gold)">contattaci</a> per itinerari giornalieri personalizzati.</p>
    </div>
  )}
</section>
</BaseLayout>
