---
// src/pages/it/tours-from-ouarzazate.astro — Dedicated Italian Ouarzazate Departure Hub
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalizedMultiDayToursByCity } from '../../data/toursI18n';
import { getAlternateUrls } from '../../data/i18n';

const tours = getLocalizedMultiDayToursByCity('Ouarzazate', 'it');
const alternateUrls = getAlternateUrls('/tours-from-ouarzazate');

const ouarzazateSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": "Tour Privati in Marocco da Ouarzazate | Sahara Star Tours",
      "description": `Scopri la nostra collezione completa di ${tours.length} tour privati di più giorni con partenza da Ouarzazate. Porta d'accesso a Erg Chebbi, Valle del Draa, Gole del Todra e traversate per Fes e Marrakech.`,
      "url": alternateUrls.it
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": alternateUrls.it.replace('/tours-from-ouarzazate', '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tour di Più Giorni",
          "item": "https://www.saharastartours.com/it/tours"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Tour da Ouarzazate",
          "item": alternateUrls.it
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={`Tour da Ouarzazate (${tours.length} Traversate Private nel Deserto) | Sahara Star Tours`}
  description={`Prenota tour privati nel deserto da Ouarzazate verso Fes e Marrakech. Kasbah di Taourirt, Gole del Dades e Todra, dune di Merzouga a dorso di dromedario e notti in campo tendato.`}
  keywords="tour da ouarzazate, tour deserto ouarzazate, ouarzazate fes tour, ouarzazate marrakech tour, merzouga da ouarzazate"
  currentPage="tours"
  lang="it"
  alternateUrls={alternateUrls}
  schemaData={ouarzazateSchema}
>

<!-- CITY HERO SECTION -->
<section class="city-hero">
  <div class="city-hero-overlay"></div>
  <div class="city-hero-content">
    <nav class="city-breadcrumbs" aria-label="Percorso">
      <a href="/it">Home</a>
      <span class="sep"><i class="fa-solid fa-chevron-right"></i></span>
      <a href="/it/tours">Tour di Più Giorni</a>
      <span class="sep"><i class="fa-solid fa-chevron-right"></i></span>
      <span class="current">Tour da Ouarzazate</span>
    </nav>
    <span class="tag"><i class="fa-solid fa-video"></i> La Porta del Deserto del Sahara</span>
    <h1>Tour Privati in Marocco da Ouarzazate</h1>
    <p>Ouarzazate è la leggendaria soglia del deserto e la capitale cinematografica del Marocco. Situata esattamente tra l'Alto Atlante e le sabbie del Sahara, iniziare il tuo tour qui elimina i tempi di trasferimento montani e ti immerge subito nella rotta delle mille kasbah, tra le pareti verticali delle Gole del Todra e le dorate dune di Merzouga prima di proseguire verso Fes o Marrakech.</p>
  </div>
</section>

<!-- LOCAL EDITORIAL / ROUTE INSIGHTS -->
<section class="city-editorial-section">
  <div class="city-editorial-container">
    <div class="city-editorial-grid">
      <div class="editorial-card">
        <div class="editorial-icon"><i class="fa-solid fa-clapperboard"></i></div>
        <h3>La Hollywood del Marocco</h3>
        <p>Sede degli Atlas Film Studios e della storica Kasbah di Taourirt, Ouarzazate offre uno sguardo affascinante sui set in cui sono stati girati capolavori come Il Gladiatore, Le Crociate e La Mummia.</p>
      </div>
      <div class="editorial-card">
        <div class="editorial-icon"><i class="fa-solid fa-gem"></i></div>
        <h3>Accesso Diretto a Valli e Gole</h3>
        <p>Partire da Ouarzazate consente di accedere rapidamente all'oasi di Skoura, alla Valle delle Rose e alle imponenti scogliere di 300 metri delle Gole del Todra senza lunghe deviazioni.</p>
      </div>
      <div class="editorial-card">
        <div class="editorial-icon"><i class="fa-solid fa-campground"></i></div>
        <h3>Glamping a Erg Chebbi Merzouga</h3>
        <p>Vivi il trekking in dromedario e la fotografia al tramonto sul mare di dune più alto del Marocco, con canti berberi attorno al fuoco e tende private di lusso.</p>
      </div>
      <div class="editorial-card">
        <div class="editorial-icon"><i class="fa-solid fa-arrows-turn-to-dots"></i></div>
        <h3>Traversate Strategiche</h3>
        <p>I nostri itinerari da Ouarzazate sono strutturati come traversate panoramiche: viaggia attraverso il deserto per concludere nella medina di Fes o risali verso ovest fino a Marrakech.</p>
      </div>
    </div>
  </div>
</section>

<!-- TOURS CATALOGUE BODY -->
<section class="city-catalog-body">
  <div class="city-catalog-container">
    
    <!-- Header -->
    <div class="city-filter-panel">
      <div class="filter-header-left">
        <h2>{tours.length} Traversate Private nel Deserto con Partenza da Ouarzazate</h2>
        <p>Pick-up diretto dal tuo hotel o aeroporto a Ouarzazate con 4x4 privato e autista esperto</p>
      </div>
    </div>

    <!-- Tours Grid -->
    <div class="city-tours-grid">
      {tours.map(tour => (
        <article class="tour-card reveal active">
          <div class="tour-img-wrapper">
            <img 
              src={tour.heroImage} 
              alt={tour.shortTitle} 
              loading="lazy"
              onerror="this.src='/assets/placeholder-morocco.svg'"
            />
            {tour.badge && <span class="tour-badge">{tour.badge}</span>}
          </div>
          <div class="tour-info">
            <div class="tour-meta">
              <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
              <div><i class="fa-solid fa-location-dot"></i> A: {tour.arrivalCity}</div>
            </div>
            <h3 class="tour-title" style="font-size:1.35rem;">{tour.shortTitle}</h3>
            <p class="tour-desc">{tour.description}</p>
            <div class="tour-footer">
              <div class="tour-price">
                <span class="tour-price-label">Da</span>
                <span class="tour-price-value">{tour.price.replace(/^(From|Desde|Da|A partire da)\s*/i, '').replace(/\/(persona|person)\s*/i, '').trim()}</span>
              </div>
              <a href={`/it/tours/${tour.slug}`} class="btn btn-primary btn-sm">
                Vedi Tour <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<!-- OTHER DEPARTURE HUBS NAVIGATION -->
<section class="other-hubs-nav">
  <div class="other-hubs-container">
    <h3>Scopri Tour di Più Giorni da Altre Città di Partenza</h3>
    <div class="other-hubs-pills">
      <a href="/it/tours-from-marrakech" class="hub-pill"><i class="fa-solid fa-sun"></i> Tour da Marrakech</a>
      <a href="/it/tours-from-casablanca" class="hub-pill"><i class="fa-solid fa-plane-arrival"></i> Tour da Casablanca</a>
      <a href="/it/tours-from-fes" class="hub-pill"><i class="fa-solid fa-landmark"></i> Tour da Fes</a>
      <a href="/it/tours-from-tangier" class="hub-pill"><i class="fa-solid fa-ship"></i> Tour da Tangeri</a>
      <a href="/it/tours" class="hub-pill active"><i class="fa-solid fa-compass"></i> Tutti i Tour di Più Giorni</a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
.city-hero {
  position: relative;
  padding: 160px 5% 70px;
  text-align: center;
  background: radial-gradient(circle at 50% 30%, rgba(217, 107, 67, 0.18) 0%, transparent 60%), linear-gradient(180deg, var(--night-surface) 0%, var(--night-bg) 100%);
  border-bottom: 1px solid var(--glass-border);
  overflow: hidden;
}

.city-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url('/assets/zellij_pattern.svg');
  background-repeat: repeat;
  background-size: 180px 180px;
  opacity: 0.15;
  pointer-events: none;
  z-index: 1;
}

.city-hero-content {
  position: relative;
  z-index: 2;
  max-width: 850px;
  margin: 0 auto;
}

.city-breadcrumbs {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  font-size: 0.88rem;
  color: var(--text-muted);
  margin-bottom: 20px;
}

.city-breadcrumbs a {
  color: var(--text-muted);
  transition: color 0.3s;
}

.city-breadcrumbs a:hover {
  color: var(--sand-gold);
}

.city-breadcrumbs .sep {
  font-size: 0.7rem;
  opacity: 0.5;
}

.city-breadcrumbs .current {
  color: var(--sand-gold);
  font-weight: 500;
}

.city-hero h1 {
  font-size: 3rem;
  line-height: 1.15;
  margin: 16px 0 20px;
  background: linear-gradient(135deg, var(--text-main) 30%, var(--sand-gold) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.city-hero p {
  font-size: 1.1rem;
  color: var(--text-muted);
  line-height: 1.7;
}

/* Editorial cards */
.city-editorial-section {
  padding: 50px 5% 20px;
  max-width: 1400px;
  margin: 0 auto;
}

.city-editorial-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 22px;
}

.editorial-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-md);
  padding: 26px 22px;
  transition: all 0.3s ease;
}

.editorial-card:hover {
  border-color: var(--sand-gold);
  transform: translateY(-2px);
}

.editorial-icon {
  font-size: 1.6rem;
  color: var(--sand-gold);
  margin-bottom: 14px;
}

.editorial-card h3 {
  font-size: 1.15rem;
  color: var(--text-main);
  margin: 0 0 8px;
}

.editorial-card p {
  font-size: 0.88rem;
  color: var(--text-muted);
  margin: 0;
  line-height: 1.5;
}

/* Catalog Body */
.city-catalog-body {
  padding: 40px 0 80px;
}

.city-catalog-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 5%;
}

.city-filter-panel {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 20px;
  margin-bottom: 40px;
  padding-bottom: 25px;
  border-bottom: 1px solid var(--glass-border);
}

.filter-header-left h2 {
  font-size: 1.6rem;
  color: var(--text-main);
  margin: 0 0 6px;
}

.filter-header-left p {
  font-size: 0.9rem;
  color: var(--text-muted);
  margin: 0;
}

.city-tours-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 32px;
}

/* Other Hubs Navigation */
.other-hubs-nav {
  padding: 30px 5% 90px;
  max-width: 1400px;
  margin: 0 auto;
  text-align: center;
}

.other-hubs-nav h3 {
  font-size: 1.25rem;
  color: var(--text-main);
  margin-bottom: 20px;
}

.other-hubs-pills {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
}

.hub-pill {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--glass-border);
  color: var(--text-muted);
  border-radius: 30px;
  padding: 8px 20px;
  font-size: 0.85rem;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.3s;
}

.hub-pill:hover {
  color: var(--sand-gold);
  border-color: var(--sand-gold);
  transform: translateY(-2px);
}

.hub-pill.active {
  border-color: var(--sand-gold);
  color: var(--sand-gold);
}

@media (max-width: 900px) {
  .city-filter-panel {
    flex-direction: column;
    align-items: flex-start;
  }
  .city-hero h1 {
    font-size: 2.2rem;
  }
}
</style>
