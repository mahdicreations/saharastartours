---
// src/pages/it/about.astro — Italian About Us page
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAlternateUrls } from '../../data/i18n';

const alternateUrls = getAlternateUrls('/about');

const aboutSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "name": "Chi Siamo | Sahara Star Tours",
      "description": "Scopri Sahara Star Tours: tour operator locale con sede a Marrakech con oltre 15 anni di esperienza nella creazione di tour privati su misura in Marocco e nel Sahara.",
      "url": alternateUrls.it
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": alternateUrls.it.replace('/about', '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Chi Siamo",
          "item": alternateUrls.it
        }
      ]
    }
  ]
};
---

<BaseLayout
  title="Chi Siamo | Sahara Star Tours - Esperti Locali di Viaggi in Marocco"
  description="Scopri Sahara Star Tours: tour operator locale con sede a Marrakech con oltre 15 anni di esperienza nella creazione di tour privati su misura in Marocco e nel Sahara."
  keywords="chi siamo sahara star tours, tour operator locale marocco, guide marrakech, esperti deserto marocco"
  currentPage="about"
  lang="it"
  alternateUrls={alternateUrls}
  schemaData={aboutSchema}
>

<section class="about-hero">
  <div class="about-hero-bg">
    <img src="/assets/marrakech_riad_pool.png" alt="Team Sahara Star Tours" />
  </div>
  <div class="about-hero-gradient"></div>
  <div class="about-hero-content">
    <span class="tour-tag">La Nostra Storia</span>
    <h1>Siamo Sahara Star Tours</h1>
    <p>Esperti locali marocchini dedicati a creare itinerari autentici che superano il turismo convenzionale: un'avventura privata su misura alla volta.</p>
  </div>
</section>

<section class="about-story">
  <div class="about-story-grid">
    <div class="about-story-text">
      <span class="tag">Dal 2009</span>
      <h2>Nati nel Deserto, Guidati dalla Passione</h2>
      <p>Sahara Star Tours è stata fondata a Marrakech da viaggiatori berberi ed esperti locali convinti che il vero viaggio autentico debba essere accessibile a tutti, senza sacrificare comfort, cultura e cura del dettaglio.</p>
      <p>Con oltre 15 anni di esperienza e più di 2.400 viaggiatori soddisfatti, siamo diventati uno dei tour operator privati più affidabili del Marocco, specializzati in safari nel deserto, città imperiali ed escursioni sull'Alto Atlante.</p>
      <p>La nostra promessa è semplice: ogni viaggio è personalizzato, accompagnato da guide locali autorizzate e realizzato con la profonda conoscenza che solo i veri nativi del deserto possono offrire.</p>
    </div>
    <div class="about-story-visual">
      <img src="/assets/sahara_star_camp_night.jpg" alt="Campo tendato di lusso nel deserto Sahara Star Tours" />
      <div class="about-story-badge">
        <div class="story-badge-value">2.400+</div>
        <div class="story-badge-label">Viaggiatori Soddisfatti</div>
      </div>
    </div>
  </div>
</section>

<section class="about-values">
  <div class="section-header reveal active">
    <span class="tag">La Nostra Filosofia</span>
    <h2>I Nostri Valori Fondamentali</h2>
  </div>
  <div class="values-grid">
    {[
      { icon: 'fa-solid fa-compass', title: 'Autentica Conoscenza Locale', desc: 'Le nostre guide sono esperti narratori nativi che condividono secoli di cultura berbera e tradizioni marocchine.' },
      { icon: 'fa-solid fa-sliders', title: '100% su Misura', desc: 'Ogni itinerario nasce da zero in base alle tue preferenze e al tuo ritmo: nessun viaggio Sahara Star Tours è mai uguale a un altro.' },
      { icon: 'fa-solid fa-shield-halved', title: 'Sicurezza e Affidabilità', desc: 'Agenzia con licenza ufficiale ONMT. Mezzi 4x4 e minivan privati moderni con aria condizionata e autisti professionisti certificati.' },
      { icon: 'fa-solid fa-leaf', title: 'Turismo Sostenibile', desc: 'Collaboriamo direttamente con campamenti e famiglie berbere locali per sostenere concretamente le comunità del deserto e dell\'Atlante.' },
    ].map(v => (
      <div class="value-card reveal active">
        <div class="value-icon"><i class={v.icon}></i></div>
        <h3>{v.title}</h3>
        <p>{v.desc}</p>
      </div>
    ))}
  </div>
</section>

<section class="about-cta">
  <h2>Pronto per Iniziare il Tuo Viaggio in Marocco?</h2>
  <p>I nostri esperti sono a tua disposizione per creare l'itinerario perfetto, senza alcun impegno e completamente gratuito.</p>
  <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-top:30px;">
    <a href="/it/contact" class="btn btn-primary"><i class="fa-solid fa-paper-plane"></i> Pianifica il Tuo Viaggio</a>
    <a href="/it/desert-tours" class="btn btn-secondary"><i class="fa-solid fa-compass"></i> Scopri i Tour</a>
  </div>
</section>

</BaseLayout>

<style>
.about-hero { height: 70vh; min-height: 480px; position: relative; display: flex; align-items: flex-end; overflow: hidden; padding-bottom: 60px; }
.about-hero-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.about-hero-bg img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.4) contrast(1.1); }
.about-hero-gradient { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to bottom, rgba(10,8,7,0.1) 0%, rgba(10,8,7,0.55) 60%, var(--night-bg) 100%); }
.about-hero-content { position: relative; z-index: 2; max-width: 1400px; margin: 0 auto; padding: 0 5%; width: 100%; }
.about-hero-content h1 { font-size: 3.5rem; color: var(--text-main); margin: 12px 0 16px; }
.about-hero-content p { font-size: 1.2rem; max-width: 600px; }
.about-story { padding: 100px 5%; }
.about-story-grid { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
.about-story-text .tag { color: var(--sand-gold); text-transform: uppercase; letter-spacing: 3px; font-size: 0.85rem; font-weight: 600; display: inline-block; margin-bottom: 12px; }
.about-story-text h2 { font-size: 2.5rem; margin-bottom: 24px; }
.about-story-text p { margin-bottom: 20px; font-size: 1.05rem; line-height: 1.8; }
.about-story-visual { position: relative; border-radius: var(--radius-md); overflow: hidden; height: 450px; }
.about-story-visual img { width: 100%; height: 100%; object-fit: cover; }
.about-story-badge { position: absolute; bottom: 25px; right: 25px; background: rgba(17,14,13,0.9); backdrop-filter: blur(10px); border: 1px solid rgba(232,195,158,0.2); border-radius: var(--radius-sm); padding: 16px 20px; text-align: center; }
.story-badge-value { font-family: var(--font-serif); font-size: 2rem; color: var(--sand-gold); font-weight: 700; }
.story-badge-label { font-size: 0.8rem; color: var(--text-muted); }
.about-values { padding: 80px 5%; background: var(--night-surface); border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border); }
.values-grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px; }
.value-card { background: var(--night-card); border: 1px solid var(--glass-border); border-radius: var(--radius-md); padding: 30px; text-align: center; transition: var(--transition-smooth); }
.value-card:hover { border-color: rgba(232,195,158,0.25); transform: translateY(-8px); box-shadow: var(--shadow-premium); }
.value-icon { width: 64px; height: 64px; background: rgba(217,107,67,0.1); border: 1px solid rgba(217,107,67,0.25); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; }
.value-icon i { color: var(--sand-gold); font-size: 1.6rem; }
.value-card h3 { font-size: 1.2rem; margin-bottom: 12px; }
.about-cta { padding: 100px 5%; text-align: center; max-width: 900px; margin: 0 auto; }
.about-cta h2 { font-size: 2.8rem; margin-bottom: 20px; }
.about-cta p { font-size: 1.15rem; color: var(--text-muted); }
@media (max-width: 992px) {
  .about-story-grid { grid-template-columns: 1fr; gap: 40px; }
  .about-hero-content h1 { font-size: 2.5rem; }
}
</style>
