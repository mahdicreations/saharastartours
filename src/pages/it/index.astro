<!-- LUXURY TESTIMONIALS CAROUSEL -->
<section 
  class="reviews-section" 
  id="testimonials"
  x-data="{
    current: 0,
    total: 3,
    timer: null,
    startTimer() {
      this.timer = setInterval(() => { this.next(); }, 6000);
    },
    stopTimer() {
      if (this.timer) clearInterval(this.timer);
    },
    next() {
      this.current = (this.current + 1) % this.total;
    },
    prev() {
      this.current = (this.current - 1 + this.total) % this.total;
    },
    goTo(index) {
      this.current = index;
    }
  }"
  x-init="startTimer()"
  @mouseenter="stopTimer()"
  @mouseleave="startTimer()"
>
  <div class="section-header reveal active">
    <span class="tag"><i class="fa-solid fa-quote-left"></i> Racconti dei Nostri Ospiti</span>
    <h2>Viaggiatori Che Si Sono Innamorati del Marocco</h2>
    <p>Oltre 2.400 viaggiatori hanno affidato a Sahara Star Tours il viaggio dei loro sogni. Ecco le loro storie reali.</p>
  </div>

  <div class="luxury-carousel-container">
    <!-- Prev Arrow Button -->
    <button 
      class="carousel-arrow carousel-arrow-prev" 
      @click="prev()" 
      type="button"
      aria-label="Recensione precedente"
    >
      <i class="fa-solid fa-chevron-left"></i>
    </button>

    <!-- Carousel Window -->
    <div class="carousel-window">
      <div 
        class="carousel-track" 
        :style="`transform: translateX(-${current * 100}%)`"
      >
        {reviews.map((r, idx) => (
          <div class="carousel-slide">
            <div class="luxury-review-card">
              <!-- Top row with stars & quote mark -->
              <div class="review-top-row">
                <div class="review-stars-box">
                  {Array.from({ length: r.stars }).map(() => (
                    <i class="fa-solid fa-star"></i>
                  ))}
                  <span class="review-score">5.0</span>
                </div>
                <div class="review-quote-badge">
                  <i class="fa-solid fa-quote-right"></i>
                </div>
              </div>

              <!-- Quote Body -->
              <p class="luxury-review-quote">
                &ldquo;{r.quote}&rdquo;
              </p>

              <!-- Footer with Avatar & Info -->
              <div class="luxury-review-footer">
                <div class="reviewer-avatar-wrap">
                  <img 
                    src={r.avatar} 
                    alt={r.name} 
                    class="reviewer-avatar-img"
                    loading="lazy" 
                  />
                  <span class="avatar-verified-tick"><i class="fa-solid fa-check"></i></span>
                </div>
                <div class="reviewer-meta">
                  <h4 class="reviewer-name">{r.name}</h4>
                  <div class="reviewer-sub">
                    <span class="reviewer-loc"><i class="fa-solid fa-location-dot"></i> {r.location}</span>
                    <span class="reviewer-tour-pill"><i class="fa-solid fa-compass"></i> {r.badge}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Next Arrow Button -->
    <button 
      class="carousel-arrow carousel-arrow-next" 
      @click="next()" 
      type="button"
      aria-label="Prossima recensione"
    >
      <i class="fa-solid fa-chevron-right"></i>
    </button>
  </div>

  <!-- Carousel Navigation Dots & Counter -->
  <div class="carousel-controls-bottom">
    <div class="carousel-dots">
      {reviews.map((_, idx) => (
        <button
          type="button"
          class="carousel-dot"
          :class={`current === ${idx} ? 'active' : ''`}
          @click={`goTo(${idx})`}
          aria-label={`Vai alla recensione ${idx + 1}`}
        ></button>
      ))}
    </div>
    <div class="carousel-counter">
      <span class="counter-curr" x-text="String(current + 1).padStart(2, '0')"></span>
      <span class="counter-sep">/</span>
      <span class="counter-total">03</span>
    </div>
  </div>
</section>

<!-- SEO NARRATIVE -->
<section class="agency-seo-showcase reveal active" id="seo-details">
  <div class="seo-grid">
    <div class="seo-text">
      <span class="tag" style="color:var(--sand-gold);text-transform:uppercase;letter-spacing:2.5px;font-size:0.9rem;font-weight:600">Esperti di Viaggi in Marocco</span>
      <h3>Viaggi su Misura Creati da <span>Sahara Star Tours</span></h3>
      <p>Come agenzia locale con sede a Marrakech, in <strong>Sahara Star Tours</strong> ci impegniamo a svelare la ricchezza visiva, le medine storiche e le tradizioni culturali del Marocco nel massimo comfort.</p>
      <p>I nostri itinerari e le mappe di viaggio sono disegnati da guide native che mantengono un legame profondo e autentico con la loro terra. Che si tratti di un safari al tramonto a Erg Chebbi, di una visita guidata a Fes o di un volo all'alba in mongolfiera, garantiamo trasferimenti privati VIP in Mercedes e riad di charme accuratamente selezionati.</p>
