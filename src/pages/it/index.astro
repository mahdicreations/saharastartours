---
// src/pages/it/index.astro — Italian Homepage
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllLocalizedTours } from '../../data/toursI18n';
import { getAlternateUrls } from '../../data/i18n';

const allTours = getAllLocalizedTours('it');
const alternateUrls = getAlternateUrls('/');

// Curated 6 most popular flagship tours for homepage "All Tours" tab (2 rows of 3)
const popularAllTours = [
  allTours.find(t => t.slug === '3-days-desert-tour-marrakech-to-fes') || allTours[0],
  allTours.find(t => t.slug === '7-day-morocco-tour-from-casablanca') || allTours[1],
  allTours.find(t => t.slug === '11-days-morocco-classic-tour') || allTours[2],
  allTours.find(t => t.slug === 'day-trip-essaouira-mogador') || allTours[3],
  allTours.find(t => t.slug === 'hot-air-balloon-marrakech') || allTours[4],
  allTours.find(t => t.slug === '12-days-morocco-tour') || allTours[5],
];

// Top 6 per category (2 rows of 3)
const popularDesertTours = allTours.filter(t => t.category === 'desert-tours').slice(0, 6);
const popularImperialTours = allTours.filter(t => t.category === 'imperial-cities').slice(0, 6);
const popularDayTrips = allTours.filter(t => t.category === 'day-trips').slice(0, 6);
const popularActivities = allTours.filter(t => t.category === 'activities').slice(0, 6);

// Stats for trust section
const stats = [
  { value: '2.400+', label: 'Viaggiatori Soddisfatti' },
  { value: '98%', label: 'Tasso di Soddisfazione' },
  { value: '15+', label: 'Anni di Esperienza' },
  { value: `${allTours.length}`, label: 'Itinerari Unici' },
];

// Culture cards
const cultureItems = [
  {
    title: 'Glamping di Lusso nel Sahara',
    desc: 'Dormi sotto miliardi di stelle in una lussuosa tenda berbera tra le dune di Erg Chebbi. Svegliati all\'alba con una passeggiata in dromedario sul mare di sabbia dorata.',
    image: '/assets/camel_trek_dunes.png',
  },
  {
    title: 'Medine Imperiali',
    desc: 'Perditi nel labirinto millenario di Fes el-Bali, una città viva patrimonio UNESCO dove le tradizioni e l\'artigianato sono rimasti immutati nei secoli.',
    image: '/assets/fes_medina_gate.png',
  },
  {
    title: 'Chefchaouen, la Città Blu',
    desc: 'La Perla Blu del Marocco: ogni scorcio dipinto di sfumature d\'indaco e azzurro, adagiata tra le vette incantate dei monti del Rif.',
    image: '/assets/chefchaouen_street.png',
  },
  {
    title: 'Trekking nell\'Alto Atlante',
    desc: 'Attraversa l\'Alto Atlante attraverso lo spettacolare valico Tizi n\'Tichka a 2.260 metri, tra antichi villaggi berberi e panorami alpini mozzafiato.',
    image: '/assets/atlas_mountains_valley.png',
  },
];

// Reviews with authentic generated traveler portraits
const reviews = [
  { 
    stars: 5, 
    quote: "L'esperienza di viaggio più magica della nostra vita: il tramonto in dromedario e il campo tendato di lusso sono andati oltre ogni sogno.", 
    name: 'Sophie Laurent', 
    location: 'Parigi, Francia', 
    avatar: '/assets/reviews/sophie.jpg',
    badge: 'Glamping a Erg Chebbi'
  },
  { 
    stars: 5, 
    quote: "Guida privata eccezionale nella medina di Fes. Il trasporto VIP Mercedes e i riad di charme ci hanno fatto sentire ospiti speciali.", 
    name: 'Marco Rossi', 
    location: 'Milano, Italia', 
    avatar: '/assets/reviews/marco.jpg',
    badge: 'Città Imperiali e Riad'
  },
  { 
    stars: 5, 
    quote: "La nostra luna di miele di 12 giorni è stata pura perfezione. Ogni terrazza di riad, valico montano e dettaglio locale era organizzato impeccabilmente.", 
    name: 'David & Emma Clark', 
    location: 'Londra, Regno Unito', 
    avatar: '/assets/reviews/david_emma.jpg',
    badge: 'Gran Tour Marocco 12 Giorni'
  },
];

// Category tabs configuration
const categoryList = [
  { id: 'all', label: 'Tutti i Tour', count: allTours.length },
  { id: 'desert-tours', label: 'Tour nel Deserto', count: allTours.filter(t => t.category === 'desert-tours').length },
  { id: 'imperial-cities', label: 'Città Imperiali', count: allTours.filter(t => t.category === 'imperial-cities').length },
  { id: 'day-trips', label: 'Escursioni in Giornata', count: allTours.filter(t => t.category === 'day-trips').length },
  { id: 'activities', label: 'Attività', count: allTours.filter(t => t.category === 'activities').length },
];

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Sahara Star Tours",
  "url": alternateUrls.it
};
---

<BaseLayout
  title="Sahara Star Tours | Agenzia Viaggi e Tour nel Deserto in Marocco"
  description="Vivi il Marocco con Sahara Star Tours. Safari esclusivi nel deserto del Sahara, tour delle città imperiali e itinerari privati su misura con guide berbere locali."
  keywords="sahara star tours, agenzia viaggi marocco, tour deserto sahara, tour marocco, viaggi privati marocco, escursioni marrakech"
  currentPage="home"
  lang="it"
  alternateUrls={alternateUrls}
  schemaData={homeSchema}
>

<!-- HERO SECTION -->
<section class="hero" id="hero">
  <div class="hero-background">
    <img src="/assets/hero_sahara_sunset.png" alt="Sahara Star Tours – Agenzia Viaggi Leader in Marocco" fetchpriority="high" loading="eager" />
  </div>
  <div class="hero-gradient"></div>
  <div class="hero-content">
    <span class="subtitle">SAHARA STAR TOURS — I VOSTRI ESPERTI DI VIAGGI IN MAROCCO</span>
    <h1>Tour Privati in Marocco ed <span>Esperienze nel Deserto del Sahara</span></h1>
    <p>Vivi tour indimenticabili in Marocco, dalle dune dorate del Sahara alle vivaci strade di Marrakech, Chefchaouen e oltre, con itinerari autentici creati da esperti locali.</p>
    <div class="hero-btns">
      <a href="/it/tours" class="btn btn-primary"><i class="fa-solid fa-compass"></i> Esplora i Tour</a>
      <a href="/it/contact" class="btn btn-secondary"><i class="fa-solid fa-paper-plane"></i> Crea Viaggio su Misura</a>
    </div>
    <div class="hero-trust-row">
      <span class="hero-trust-item">
        <i class="fa-solid fa-star"></i> 5 Stelle (Oltre 500 Recensioni)
      </span>
      <span class="hero-trust-item">
        <i class="fa-solid fa-certificate"></i> Agenzia Locale Autorizzata
      </span>
      <span class="hero-trust-item">
        <i class="fa-solid fa-headset"></i> Assistenza Dedicata 24/7
      </span>
    </div>
  </div>
</section>

<!-- STATS TRUST BAR -->
<div class="stats-bar reveal active">
  {stats.map(s => (
    <div class="stat-item">
      <span class="stat-value">{s.value}</span>
      <span class="stat-label">{s.label}</span>
    </div>
  ))}
</div>

<!-- AGENCY PRESENTATION / ABOUT INTRO SECTION -->
<section class="agency-intro-section reveal active" id="about-sahara-star">
  <div class="agency-intro-container">
    <div class="agency-intro-content">
      <div class="agency-trust-pill">
        <i class="fa-solid fa-shield-halved"></i>
        <span>Tour Operator Locale Affidabile | Licenza Ufficiale</span>
      </div>
      
      <div class="agency-header-row">
        <div class="agency-logo-wrap">
          <img src="/assets/logo.png" alt="Logo Sahara Star Tours" class="agency-intro-logo" width="75" height="75" />
        </div>
        <div class="agency-header-text">
          <span class="agency-subtag">Marrakech • Deserto del Sahara • Città Imperiali</span>
          <h2 class="agency-title">Benvenuti in <span>Sahara Star Tours</span></h2>
        </div>
      </div>

      <p class="agency-lead-text">
        Con sede a Marrakech e operativa in tutto il paese, <strong>Sahara Star Tours</strong> è un tour operator certificato e ufficialmente autorizzato in Marocco. Nati da generazioni di conoscenza del deserto e ospitalità berbera, organizziamo autentiche spedizioni private che ti connettono con l'anima più autentica del Marocco.
      </p>

      <p class="agency-body-text">
        Dal dormire sotto miliardi di stelle nei nostri campi tendati di lusso a Erg Chebbi all'attraversare i valichi dell'Alto Atlante a bordo di veicoli Mercedes climatizzati fino all'esplorazione di antiche medine con storici autorizzati: ogni viaggio è personalizzato al millimetro con standard a 5 stelle e prezzi locali trasparenti.
      </p>

      <div class="agency-highlights-grid">
        <div class="agency-hl-item">
          <div class="agency-hl-icon"><i class="fa-solid fa-certificate"></i></div>
          <div class="agency-hl-text">
            <strong>Autorizzazione del Ministero</strong>
            <span>Licenza turistica ufficiale e copertura assicurativa completa</span>
          </div>
        </div>
        <div class="agency-hl-item">
          <div class="agency-hl-icon"><i class="fa-solid fa-compass"></i></div>
          <div class="agency-hl-text">
            <strong>Guide Nomadi Native</strong>
            <span>Generazioni di esperienza nel Sahara e storici nelle medine</span>
          </div>
        </div>
        <div class="agency-hl-item">
          <div class="agency-hl-icon"><i class="fa-solid fa-car-side"></i></div>
          <div class="agency-hl-text">
            <strong>Flotta Privata VIP</strong>
            <span>Mercedes climatizzati con Wi-Fi a bordo e sedili in pelle</span>
          </div>
        </div>
        <div class="agency-hl-item">
          <div class="agency-hl-icon"><i class="fa-solid fa-sliders"></i></div>
          <div class="agency-hl-text">
            <strong>Itinerari 100% su Misura</strong>
            <span>Date personalizzate, selezione di riad di lusso e concierge 24/7</span>
          </div>
        </div>
      </div>

      <div class="agency-intro-actions">
        <a href="/it/about" class="btn btn-secondary">
          <i class="fa-solid fa-circle-info"></i> La Nostra Storia
        </a>
        <a href="/it/contact" class="btn btn-primary">
          <i class="fa-solid fa-paper-plane"></i> Organizza il Tuo Viaggio
        </a>
      </div>
    </div>

    <div class="agency-intro-visual">
      <div class="agency-image-card">
        <img 
          src="/assets/sahara_star_camp_night.jpg" 
          alt="Campo Tendato di Lusso nel Deserto Sahara Star Tours" 
          class="agency-main-img"
          loading="lazy"
        />
        <div class="agency-img-caption">
          <!-- Badge 1: 5-Star Reviews -->
          <div class="agency-caption-badge badge-reviews">
            <div class="acb-rating-row">
              <span class="acb-stars">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
              </span>
              <strong class="acb-score">4.9/5</strong>
            </div>
            <div class="acb-subtext">Basato su oltre 2.400 recensioni</div>
          </div>

          <!-- Badge 2: Trusted & Officially Licensed -->
          <div class="agency-caption-badge badge-license">
            <div class="acb-license-title">
              <i class="fa-solid fa-shield-halved"></i>
              <strong>Operatore Locale Ufficiale</strong>
            </div>
            <div class="acb-license-sub">Licenza Ufficiale #48D/19</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TOURS SECTION -->
<section class="tours-section" id="tours">
  <div class="section-header reveal active">
    <span class="tag"><i class="fa-solid fa-fire-flame-curved"></i> I Nostri Tour Più Richiesti</span>
    <h2>Tour su Misura in Marocco</h2>
    <p>Ogni viaggio è un capolavoro su misura: con autista privato, alloggi boutique di charme e ritmi studiati secondo i tuoi desideri.</p>
    <div class="special-offer-banner">
      <span class="sob-icon"><i class="fa-solid fa-tag"></i></span>
      <span class="sob-text">Offerta Speciale di Stagione: Risparmia <strong>fino al 30%</strong> su tutti i pacchetti privati!</span>
    </div>
  </div>

  <div class="category-showcase-container" x-data="{ activeTab: 'all' }">
    <!-- Category Filter Tabs -->
    <ul class="category-tabs" id="category-tabs">
      {categoryList.map(cat => (
        <li>
          <button 
            class="category-tab"
            :class={`activeTab === '${cat.id}' ? 'active' : ''`}
            @click={`activeTab = '${cat.id}'`}
            type="button"
          >
            {cat.label} <span>({cat.count})</span>
          </button>
        </li>
      ))}
    </ul>

    <!-- Tour Cards Grid -->
    <div class="category-tours-wrapper">
      <!-- ALL TOURS TAB -->
      <div 
        class="category-tour-grid" 
        x-show="activeTab === 'all'" 
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 scale-95"
        x-transition:enter-end="opacity-100 scale-100"
      >
        {popularAllTours.map(tour => (
          <article class="tour-card reveal active">
            <div class="tour-img-wrapper">
              <img 
                src={tour.heroImage} 
                alt={tour.shortTitle} 
                loading="lazy"
                onerror="this.src='/assets/hero_sahara_sunset.png'"
              />
              {tour.badge && <span class="tour-badge">{tour.badge}</span>}
            </div>
            <div class="tour-info">
              <div class="tour-meta">
                <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
                <div><i class="fa-solid fa-location-dot"></i> {tour.startingFrom}</div>
              </div>
              <h3 class="tour-title">{tour.shortTitle}</h3>
              <p class="tour-desc">{tour.description}</p>
              <div class="tour-footer">
                <div class="tour-price">
                  <span class="tour-price-label">Da</span>
                  <span class="tour-price-value">{tour.price.replace(/^(From|Desde|Da|A partire da)\s*/i, '').replace(/\/(persona|person)\s*/i, '').trim()}</span>
                </div>
                <a href={`/it/tours/${tour.slug}`} class="btn btn-primary btn-sm">
                  Vedi Tour <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- DESERT TOURS TAB -->
      <div 
        class="category-tour-grid" 
        x-show="activeTab === 'desert-tours'" 
        x-transition:enter="transition ease-out duration-300" 
        x-transition:enter-start="opacity-0 scale-95" 
        x-transition:enter-end="opacity-100 scale-100"
        style="display: none;"
      >
        {popularDesertTours.map(tour => (
          <article class="tour-card reveal active">
            <div class="tour-img-wrapper">
              <img 
                src={tour.heroImage} 
                alt={tour.shortTitle} 
                loading="lazy" 
                onerror="this.src='/assets/hero_sahara_sunset.png'"
              />
              {tour.badge && <span class="tour-badge">{tour.badge}</span>}
            </div>
            <div class="tour-info">
              <div class="tour-meta">
                <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
                <div><i class="fa-solid fa-location-dot"></i> {tour.startingFrom}</div>
              </div>
              <h3 class="tour-title">{tour.shortTitle}</h3>
              <p class="tour-desc">{tour.description}</p>
              <div class="tour-footer">
                <div class="tour-price">
                  <span class="tour-price-label">Da</span>
                  <span class="tour-price-value">{tour.price.replace(/^(From|Desde|Da|A partire da)\s*/i, '').replace(/\/(persona|person)\s*/i, '').trim()}</span>
                </div>
                <a href={`/it/tours/${tour.slug}`} class="btn btn-primary btn-sm">
                  Vedi Tour <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- IMPERIAL CITIES TAB -->
      <div 
        class="category-tour-grid" 
        x-show="activeTab === 'imperial-cities'" 
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 scale-95"
        x-transition:enter-end="opacity-100 scale-100"
        style="display: none;"
      >
        {popularImperialTours.map(tour => (
          <article class="tour-card reveal active">
            <div class="tour-img-wrapper">
              <img 
                src={tour.heroImage} 
                alt={tour.shortTitle} 
                loading="lazy"
                onerror="this.src='/assets/hero_sahara_sunset.png'"
              />
              {tour.badge && <span class="tour-badge">{tour.badge}</span>}
            </div>
            <div class="tour-info">
              <div class="tour-meta">
                <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
                <div><i class="fa-solid fa-location-dot"></i> {tour.startingFrom}</div>
              </div>
              <h3 class="tour-title">{tour.shortTitle}</h3>
              <p class="tour-desc">{tour.description}</p>
              <div class="tour-footer">
                <div class="tour-price">
                  <span class="tour-price-label">Da</span>
                  <span class="tour-price-value">{tour.price.replace(/^(From|Desde|Da|A partire da)\s*/i, '').replace(/\/(persona|person)\s*/i, '').trim()}</span>
                </div>
                <a href={`/it/tours/${tour.slug}`} class="btn btn-primary btn-sm">
                  Vedi Tour <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- DAY TRIPS TAB -->
      <div 
        class="category-tour-grid" 
        x-show="activeTab === 'day-trips'" 
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 scale-95"
        x-transition:enter-end="opacity-100 scale-100"
        style="display: none;"
      >
        {popularDayTrips.map(tour => (
          <article class="tour-card reveal active">
            <div class="tour-img-wrapper">
              <img 
                src={tour.heroImage} 
                alt={tour.shortTitle} 
                loading="lazy"
                onerror="this.src='/assets/hero_sahara_sunset.png'"
              />
              {tour.badge && <span class="tour-badge">{tour.badge}</span>}
            </div>
            <div class="tour-info">
              <div class="tour-meta">
                <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
                <div><i class="fa-solid fa-location-dot"></i> {tour.startingFrom}</div>
              </div>
              <h3 class="tour-title">{tour.shortTitle}</h3>
              <p class="tour-desc">{tour.description}</p>
              <div class="tour-footer">
                <div class="tour-price">
                  <span class="tour-price-label">Da</span>
                  <span class="tour-price-value">{tour.price.replace(/^(From|Desde|Da|A partire da)\s*/i, '').replace(/\/(persona|person)\s*/i, '').trim()}</span>
                </div>
                <a href={`/it/tours/${tour.slug}`} class="btn btn-primary btn-sm">
                  Vedi Tour <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- ACTIVITIES TAB -->
      <div 
        class="category-tour-grid" 
        x-show="activeTab === 'activities'" 
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 scale-95"
        x-transition:enter-end="opacity-100 scale-100"
        style="display: none;"
      >
        {popularActivities.map(tour => (
          <article class="tour-card reveal active">
            <div class="tour-img-wrapper">
              <img 
                src={tour.heroImage} 
                alt={tour.shortTitle} 
                loading="lazy"
                onerror="this.src='/assets/hero_sahara_sunset.png'"
              />
              {tour.badge && <span class="tour-badge">{tour.badge}</span>}
            </div>
            <div class="tour-info">
              <div class="tour-meta">
                <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
                <div><i class="fa-solid fa-location-dot"></i> {tour.startingFrom}</div>
              </div>
              <h3 class="tour-title">{tour.shortTitle}</h3>
              <p class="tour-desc">{tour.description}</p>
              <div class="tour-footer">
                <div class="tour-price">
                  <span class="tour-price-label">Da</span>
                  <span class="tour-price-value">{tour.price.replace(/^(From|Desde|Da|A partire da)\s*/i, '').replace(/\/(persona|person)\s*/i, '').trim()}</span>
                </div>
                <a href={`/it/tours/${tour.slug}`} class="btn btn-primary btn-sm">
                  Vedi Tour <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Prominent "Explore All Tours" Button -->
    <div class="browse-all-wrapper reveal active">
      <a href="/it/tours" class="btn btn-primary btn-lg">
        <i class="fa-solid fa-compass"></i> Esplora Tutti i Tour ({allTours.length}) <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </div>
</section>

<!-- STARTING CITIES SECTION -->
<section class="starting-cities-section">
  <div class="section-header reveal active">
    <span class="tag">Città di Partenza</span>
    <h2>Da Dove Inizierà il Tuo Viaggio?</h2>
    <p>Offriamo partenze da tutti i principali aeroporti e città del Marocco: scegli la tua porta d'accesso.</p>
  </div>
  <div class="starting-cities-grid">
    {[
      { city: 'Casablanca', badge: 'Aeroporto CMN', desc: 'Il principale hub aereo internazionale: grandi tour circolari e safari nel deserto con partenza da Casablanca.', tours: `${allTours.filter(t => t.productType === 'multi-day' && t.departureCity === 'Casablanca').length} Itinerari`, url: '/it/tours-from-casablanca', img: '/assets/casablanca_gateway.png' },
      { city: 'Marrakech', badge: 'Aeroporto RAK', desc: 'La Perla del Sud: itinerari privati che attraversano l\'Alto Atlante via Tizi n\'Tichka verso Merzouga e Fes.', tours: `${allTours.filter(t => t.productType === 'multi-day' && t.departureCity === 'Marrakech').length} Itinerari`, url: '/it/tours-from-marrakech', img: '/assets/marrakech_riad_pool.png' },
      { city: 'Fes', badge: 'Aeroporto FEZ', desc: 'Il cuore culturale del Marocco: percorsi attraverso le foreste di cedri del Medio Atlante e la Valle dello Ziz a Erg Chebbi.', tours: `${allTours.filter(t => t.productType === 'multi-day' && t.departureCity === 'Fes').length} Itinerari`, url: '/it/tours-from-fes', img: '/assets/fes_medina_gate.png' },
      { city: 'Tangeri', badge: 'Porto e TNG', desc: 'Porta d\'accesso marittima e aerea dall\'Europa: viaggi attraverso Chefchaouen, i monti del Rif e traversate verso sud.', tours: `${allTours.filter(t => t.productType === 'multi-day' && t.departureCity === 'Tangier').length} Itinerari`, url: '/it/tours-from-tangier', img: '/assets/tangier_coast.png' },
