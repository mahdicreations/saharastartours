---
// src/pages/it/imperial-cities.astro — Italian Imperial Cities category page
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalizedImperialCitiesTours } from '../../data/toursI18n';
import { getAlternateUrls } from '../../data/i18n';

const imperialTours = getLocalizedImperialCitiesTours('it');
const alternateUrls = getAlternateUrls('/imperial-cities');

const schemaData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Tour delle Città Imperiali del Marocco | Sahara Star Tours",
  "description": "Esplora le capitali imperiali del Marocco: Fes, Marrakech, Rabat e Meknes. Tour culturali privati da 10 a 15 giorni con guide locali autorizzate nelle medine.",
  "url": alternateUrls.it
};
---

<BaseLayout
  title="Tour delle Città Imperiali del Marocco | Sahara Star Tours"
  description="Esplora le capitali imperiali del Marocco: Fes, Marrakech, Rabat e Meknes. Tour culturali privati da 10 a 15 giorni con guide locali autorizzate nelle medine."
  keywords="citta imperiali marocco, tour fes marrakech rabat, viaggi culturali marocco, medina di fes"
  currentPage="imperial-cities"
  lang="it"
  alternateUrls={alternateUrls}
  schemaData={schemaData}
>

<section class="cat-hero">
  <span class="tag" style="display:inline-block;color:var(--sand-gold);text-transform:uppercase;letter-spacing:3px;font-size:0.9rem;font-weight:600;margin-bottom:12px;">Città Imperiali del Marocco</span>
  <h1 style="font-size:3rem;max-width:750px;margin:0 auto 20px;background:linear-gradient(135deg,var(--text-main) 30%,var(--sand-gold) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">Città Imperiali e Grande Patrimonio</h1>
  <p style="max-width:680px;margin:0 auto;font-size:1.1rem;color:var(--text-muted);line-height:1.8;">Un viaggio affascinante attraverso secoli di dinastie marocchine. Esplora le labirintiche medine medievali di Fes, i magnifici palazzi di Marrakech, i bastioni oceanici di Rabat e le maestose porte reali di Meknes.</p>
</section>

<section style="padding: 60px 5%; max-width: 1400px; margin: 0 auto;">
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:32px;">
    {imperialTours.map(tour => (
      <article class="tour-card reveal active">
        <div class="tour-img-wrapper">
          <img src={tour.heroImage} alt={tour.shortTitle} loading="lazy" onerror="this.src='/assets/placeholder-morocco.svg'" />
          {tour.badge && <span class="tour-badge">{tour.badge}</span>}
        </div>
        <div class="tour-info">
          <div class="tour-meta">
            <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
            <div><i class="fa-solid fa-location-dot"></i> {tour.startingFrom}</div>
          </div>
          <h2 class="tour-title">{tour.shortTitle}</h2>
          <p class="tour-desc">{tour.description}</p>
          <div class="tour-footer">
            <div class="tour-price">
              <span class="tour-price-label">A partire da</span>
              <span class="tour-price-value">{tour.price.replace(/^(From|Desde|Da|A partire da)\s*/i, '').replace(/\/(persona|person)\s*/i, '').trim()}</span>
            </div>
            <a href={`/it/tours/${tour.slug}`} class="btn btn-primary btn-sm">Vedi Tour <i class="fa-solid fa-arrow-right"></i></a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

</BaseLayout>
