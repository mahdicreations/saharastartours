---
// src/pages/es/tours-from-ouarzazate.astro — Dedicated Spanish Ouarzazate Departure Hub
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalizedMultiDayToursByCity } from '../../data/toursI18n';
import { getAlternateUrls } from '../../data/i18n';

const tours = getLocalizedMultiDayToursByCity('Ouarzazate', 'es');
const alternateUrls = getAlternateUrls('/tours-from-ouarzazate');

const ouarzazateSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": "Circuitos Privados por Marruecos desde Ouarzazate | Sahara Star Tours",
      "description": `Descubre nuestra colección completa de ${tours.length} circuitos privados multidía con salida desde Ouarzazate. Puerta a Erg Chebbi, Valle del Draa, Gargantas del Todra y travesías hacia Fez y Marrakech.`,
      "url": alternateUrls.es
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": alternateUrls.es.replace('/tours-from-ouarzazate', '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Circuitos Multidía",
          "item": "https://www.saharastartours.com/es/tours"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Circuitos desde Ouarzazate",
          "item": alternateUrls.es
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={`Circuitos desde Ouarzazate (${tours.length} Travesías Privadas al Desierto) | Sahara Star Tours`}
  description={`Reserva circuitos privados al desierto desde Ouarzazate hacia Fez y Marrakech. Kasbah de Taourirt, Gargantas del Dades y Todra, dunas de Merzouga en camello y noches en jaimas.`}
  keywords="circuitos desde ouarzazate, rutas desierto ouarzazate, ouarzazate a fez tour, ouarzazate a marrakech tour, merzouga desde ouarzazate"
  currentPage="tours"
  lang="es"
  alternateUrls={alternateUrls}
  schemaData={ouarzazateSchema}
>

<!-- CITY HERO SECTION -->
<section class="city-hero">
  <div class="city-hero-overlay"></div>
  <div class="city-hero-content">
    <nav class="city-breadcrumbs" aria-label="Miga de pan">
      <a href="/es">Inicio</a>
      <span class="sep"><i class="fa-solid fa-chevron-right"></i></span>
      <a href="/es/tours">Circuitos Multidía</a>
      <span class="sep"><i class="fa-solid fa-chevron-right"></i></span>
      <span class="current">Circuitos desde Ouarzazate</span>
    </nav>
    <span class="tag"><i class="fa-solid fa-video"></i> La Puerta del Desierto del Sáhara</span>
    <h1>Circuitos Privados por Marruecos desde Ouarzazate</h1>
    <p>Ouarzazate es el legendario umbral del desierto y la capital cinematográfica de Marruecos. Situada directamente entre el Alto Atlas y las arenas del Sáhara, iniciar tu viaje aquí elimina horas de trayecto de montaña y te sitúa de inmediato en la ruta de las mil kasbahs, los muros verticales de las Gargantas del Todra y las doradas dunas de Merzouga antes de continuar hacia Fez o Marrakech.</p>
  </div>
</section>

<!-- LOCAL EDITORIAL / ROUTE INSIGHTS -->
<section class="city-editorial-section">
  <div class="city-editorial-container">
    <div class="city-editorial-grid">
      <div class="editorial-card">
        <div class="editorial-icon"><i class="fa-solid fa-clapperboard"></i></div>
        <h3>El Hollywood de Marruecos</h3>
        <p>Sede de los Estudios de Cine Atlas y de la histórica Kasbah de Taourirt, Ouarzazate ofrece una fascinante mirada a escenarios donde se rodaron Gladiator, Kingdom of Heaven y La Momia.</p>
      </div>
      <div class="editorial-card">
        <div class="editorial-icon"><i class="fa-solid fa-gem"></i></div>
        <h3>Acceso Directo a Valles y Gargantas</h3>
        <p>Partir desde Ouarzazate permite acceder directamente al palmeral de Skoura, el Valle de las Rosas y los impresionantes acantilados de 300 metros del Todra sin largos desvíos.</p>
      </div>
      <div class="editorial-card">
        <div class="editorial-icon"><i class="fa-solid fa-campground"></i></div>
        <h3>Jaimas en Erg Chebbi Merzouga</h3>
        <p>Disfruta de paseos en dromedario y fotografía al atardecer sobre las dunas más altas del país, con hospitalidad bereber, cenas selectas y música tradicional en jaimas privadas.</p>
      </div>
      <div class="editorial-card">
        <div class="editorial-icon"><i class="fa-solid fa-arrows-turn-to-dots"></i></div>
        <h3>Travesías Estratégicas</h3>
        <p>Nuestros circuitos desde Ouarzazate están concebidos como travesías de alto valor paisajístico: atraviesa el desierto para culminar en la medina de Fez o enlaza hacia Marrakech.</p>
      </div>
    </div>
  </div>
</section>

<!-- TOURS CATALOGUE BODY -->
<section class="city-catalog-body">
  <div class="city-catalog-container">
    
    <!-- Header -->
    <div class="city-filter-panel">
      <div class="filter-header-left">
        <h2>{tours.length} Travesías Privadas al Desierto con Salida desde Ouarzazate</h2>
        <p>Recogida puerta a puerta en tu hotel o aeropuerto en Ouarzazate con 4x4 privado y chófer experto</p>
      </div>
    </div>

    <!-- Tours Grid -->
    <div class="city-tours-grid">
      {tours.map(tour => (
        <article class="tour-card reveal active">
          <div class="tour-img-wrapper">
            <img 
              src={tour.heroImage} 
              alt={tour.shortTitle} 
              loading="lazy"
              onerror="this.src='/assets/placeholder-morocco.svg'"
            />
            {tour.badge && <span class="tour-badge">{tour.badge}</span>}
          </div>
          <div class="tour-info">
            <div class="tour-meta">
              <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
              <div><i class="fa-solid fa-location-dot"></i> Hacia: {tour.arrivalCity}</div>
            </div>
            <h3 class="tour-title" style="font-size:1.35rem;">{tour.shortTitle}</h3>
            <p class="tour-desc">{tour.description}</p>
            <div class="tour-footer">
              <div class="tour-price">
                <span class="tour-price-label">Desde</span>
                <span class="tour-price-value">{tour.price.replace(/^(From|Desde|Da|A partire da)\s*/i, '').replace(/\/(persona|person)\s*/i, '').trim()}</span>
              </div>
              <a href={`/es/tours/${tour.slug}`} class="btn btn-primary btn-sm">
                Ver Circuito <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<!-- OTHER DEPARTURE HUBS NAVIGATION -->
<section class="other-hubs-nav">
  <div class="other-hubs-container">
    <h3>Explora Circuitos Multidía desde Otras Ciudades</h3>
    <div class="other-hubs-pills">
      <a href="/es/tours-from-marrakech" class="hub-pill"><i class="fa-solid fa-sun"></i> Circuitos desde Marrakech</a>
      <a href="/es/tours-from-casablanca" class="hub-pill"><i class="fa-solid fa-plane-arrival"></i> Circuitos desde Casablanca</a>
      <a href="/es/tours-from-fes" class="hub-pill"><i class="fa-solid fa-landmark"></i> Circuitos desde Fez</a>
      <a href="/es/tours-from-tangier" class="hub-pill"><i class="fa-solid fa-ship"></i> Circuitos desde Tánger</a>
      <a href="/es/tours" class="hub-pill active"><i class="fa-solid fa-compass"></i> Ver Todos los Circuitos</a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
.city-hero {
  position: relative;
  padding: 160px 5% 70px;
  text-align: center;
  background: radial-gradient(circle at 50% 30%, rgba(217, 107, 67, 0.18) 0%, transparent 60%), linear-gradient(180deg, var(--night-surface) 0%, var(--night-bg) 100%);
  border-bottom: 1px solid var(--glass-border);
  overflow: hidden;
}

.city-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url('/assets/zellij_pattern.svg');
  background-repeat: repeat;
  background-size: 180px 180px;
  opacity: 0.15;
  pointer-events: none;
  z-index: 1;
}

.city-hero-content {
  position: relative;
  z-index: 2;
  max-width: 850px;
  margin: 0 auto;
}

.city-breadcrumbs {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  font-size: 0.88rem;
  color: var(--text-muted);
  margin-bottom: 20px;
}

.city-breadcrumbs a {
  color: var(--text-muted);
  transition: color 0.3s;
}

.city-breadcrumbs a:hover {
  color: var(--sand-gold);
}

.city-breadcrumbs .sep {
  font-size: 0.7rem;
  opacity: 0.5;
}

.city-breadcrumbs .current {
  color: var(--sand-gold);
  font-weight: 500;
}

.city-hero h1 {
  font-size: 3rem;
  line-height: 1.15;
  margin: 16px 0 20px;
  background: linear-gradient(135deg, var(--text-main) 30%, var(--sand-gold) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.city-hero p {
  font-size: 1.1rem;
  color: var(--text-muted);
  line-height: 1.7;
}

/* Editorial cards */
.city-editorial-section {
  padding: 50px 5% 20px;
  max-width: 1400px;
  margin: 0 auto;
}

.city-editorial-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 22px;
}

.editorial-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-md);
  padding: 26px 22px;
  transition: all 0.3s ease;
}

.editorial-card:hover {
  border-color: var(--sand-gold);
  transform: translateY(-2px);
}

.editorial-icon {
  font-size: 1.6rem;
  color: var(--sand-gold);
  margin-bottom: 14px;
}

.editorial-card h3 {
  font-size: 1.15rem;
  color: var(--text-main);
  margin: 0 0 8px;
}

.editorial-card p {
  font-size: 0.88rem;
  color: var(--text-muted);
  margin: 0;
  line-height: 1.5;
}

/* Catalog Body */
.city-catalog-body {
  padding: 40px 0 80px;
}

.city-catalog-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 5%;
}

.city-filter-panel {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 20px;
  margin-bottom: 40px;
  padding-bottom: 25px;
  border-bottom: 1px solid var(--glass-border);
}

.filter-header-left h2 {
  font-size: 1.6rem;
  color: var(--text-main);
  margin: 0 0 6px;
}

.filter-header-left p {
  font-size: 0.9rem;
  color: var(--text-muted);
  margin: 0;
}

.city-tours-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 32px;
}

/* Other Hubs Navigation */
.other-hubs-nav {
  padding: 30px 5% 90px;
  max-width: 1400px;
  margin: 0 auto;
  text-align: center;
}

.other-hubs-nav h3 {
  font-size: 1.25rem;
  color: var(--text-main);
  margin-bottom: 20px;
}

.other-hubs-pills {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
}

.hub-pill {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--glass-border);
  color: var(--text-muted);
  border-radius: 30px;
  padding: 8px 20px;
  font-size: 0.85rem;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.3s;
}

.hub-pill:hover {
  color: var(--sand-gold);
  border-color: var(--sand-gold);
  transform: translateY(-2px);
}

.hub-pill.active {
  border-color: var(--sand-gold);
  color: var(--sand-gold);
}

@media (max-width: 900px) {
  .city-filter-panel {
    flex-direction: column;
    align-items: flex-start;
  }
  .city-hero h1 {
    font-size: 2.2rem;
  }
}
</style>
