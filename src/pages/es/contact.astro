---
// src/pages/es/contact.astro — Spanish Contact & Custom Trip Planning Page
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAlternateUrls } from '../../data/i18n';

const alternateUrls = getAlternateUrls('/contact');

const seoTitle = "Contacto y Planificación a Medida | Sahara Star Tours";
const seoDescription = "Contacta con Sahara Star Tours en Marrakech. Diseña tu circuito privado a medida por Marruecos, expedición al desierto del Sáhara o estancia en riads con expertos locales.";
const canonicalUrl = alternateUrls.es;

const contactSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "name": seoTitle,
      "description": seoDescription,
      "url": canonicalUrl,
      "mainEntity": {
        "@type": "TravelAgency",
        "name": "Sahara Star Tours",
        "telephone": "+212678317015",
        "email": "contact@saharastartours.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Derb Dabachi, Medina",
          "addressLocality": "Marrakech",
          "addressCountry": "MA"
        }
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": alternateUrls.es.replace('/contact', '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Contacto y Planificación a Medida",
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={seoTitle}
  description={seoDescription}
  canonicalUrl={canonicalUrl}
  currentPage="contact"
  lang="es"
  alternateUrls={alternateUrls}
  schemaData={contactSchema}
>
  <!-- HERO BANNER -->
  <section class="contact-hero">
    <div class="contact-hero-overlay"></div>
    <div class="contact-hero-content reveal active">
      <nav class="contact-breadcrumbs" aria-label="Breadcrumb">
        <a href="/es">Inicio</a>
        <span class="sep"><i class="fa-solid fa-chevron-right"></i></span>
        <span class="current">Contacto y Planificación a Medida</span>
      </nav>
      <span class="tag"><i class="fa-solid fa-compass"></i> Diseñemos el Viaje de tus Sueños</span>
      <h1>Diseña tu Viaje a Medida por Marruecos</h1>
      <p>Tanto si sueñas con el amanecer sobre las dunas de Erg Chebbi, el encanto íntimo de riads boutique o cruzar el Alto Atlas, nuestros diseñadores locales en Marrakech cuidarán cada detalle a la perfección.</p>
    </div>
  </section>

  <!-- MAIN CONTACT SECTION -->
  <section class="contact-page-body">
    <div class="contact-page-container">
      
      <!-- TOP CONTACT CARDS -->
      <div class="contact-channels-grid reveal active">
        <a href="https://wa.me/212678317015?text=Hola%20Sahara%20Star%20Tours%2C%20quisiera%20planificar%20un%20viaje%20a%20Marruecos" target="_blank" rel="noopener" class="contact-card wa-card">
          <div class="c-card-icon wa-icon">
            <i class="fa-brands fa-whatsapp"></i>
            <span class="c-live-badge">En Vivo</span>
          </div>
          <div class="c-card-details">
            <span class="c-card-tag">Respuesta Inmediata</span>
            <h3>Chat Directo por WhatsApp</h3>
            <p>Habla directamente con nuestros coordinadores locales en Marrakech.</p>
            <span class="c-card-val">+212 678-317015</span>
          </div>
        </a>

        <a href="mailto:contact@saharastartours.com" class="contact-card">
          <div class="c-card-icon email-icon">
            <i class="fa-regular fa-envelope"></i>
          </div>
          <div class="c-card-details">
            <span class="c-card-tag">Consultas Oficiales</span>
            <h3>Correo Electrónico</h3>
            <p>Envíanos tus fechas estimadas, vuelos y preferencias de viaje.</p>
            <span class="c-card-val">contact@saharastartours.com</span>
          </div>
        </a>

        <div class="contact-card address-card">
          <div class="c-card-icon address-icon">
            <i class="fa-solid fa-location-dot"></i>
          </div>
          <div class="c-card-details">
            <span class="c-card-tag">Sede Central</span>
            <h3>Oficina en Marrakech</h3>
            <p>Derb Dabachi, Medina, Marrakech 40000, Marruecos</p>
            <span class="c-card-val">Abierto todos los días de 8:00 a 21:00</span>
          </div>
        </div>
      </div>

      <!-- INQUIRY FORM CONTAINER -->
      <div 
        class="inquiry-form-card reveal active" 
        id="inquiry-form"
        x-data="{
          formData: {
            name: '',
            email: '',
            phone: '',
            startCity: 'Marrakech',
            travelers: '2 Adultos',
            travelMonth: '',
            style: 'Confort Boutique',
            tourType: 'Desierto y Ciudades Imperiales',
            message: ''
          },
          submitting: false,
          showModal: false,
          modalName: '',
          modalEmail: '',
          submitPlan() {
            this.modalName = this.formData.name;
            this.modalEmail = this.formData.email;
            this.showModal = true;
            document.body.style.overflow = 'hidden';
            this.formData.name = '';
            this.formData.email = '';
            this.formData.phone = '';
            this.formData.message = '';
          },
          closeModal() {
            this.showModal = false;
            document.body.style.overflow = '';
          }
        }"
      >
        <div class="inquiry-header">
          <span class="tag"><i class="fa-solid fa-sliders"></i> Itinerario a Medida</span>
          <h2>Personaliza tu Expedición por Marruecos</h2>
          <p>Indica tus preferencias a continuación. Nuestros expertos locales elaborarán una propuesta detallada y transparente en menos de 24 horas.</p>
        </div>

        <form @submit.prevent="submitPlan()" class="inquiry-form-grid">
          <!-- Row 1: Name & Email -->
          <div class="form-group">
            <input type="text" id="plan-name" x-model="formData.name" placeholder=" " required />
            <label for="plan-name">Nombre Completo *</label>
          </div>

          <div class="form-group">
            <input type="email" id="plan-email" x-model="formData.email" placeholder=" " required />
            <label for="plan-email">Correo Electrónico *</label>
          </div>

          <!-- Row 2: Phone/WhatsApp & Departure City -->
          <div class="form-group">
            <input type="tel" id="plan-phone" x-model="formData.phone" placeholder=" " />
            <label for="plan-phone">WhatsApp / Teléfono (con prefijo de país)</label>
          </div>

          <div class="form-group">
            <select id="plan-city" x-model="formData.startCity">
              <option value="Marrakech">Marrakech</option>
              <option value="Casablanca">Casablanca</option>
              <option value="Fes">Fez</option>
              <option value="Tangier">Tánger</option>
              <option value="Agadir">Agadir / Taghazout</option>
              <option value="Ouarzazate">Ouarzazate</option>
              <option value="Other">Otra / Varias Ciudades</option>
            </select>
            <label for="plan-city">Ciudad de Salida Preferida</label>
          </div>

          <!-- Row 3: Travelers & Travel Date/Month -->
          <div class="form-group">
            <select id="plan-travelers" x-model="formData.travelers">
              <option value="Viajero Individual">Viajero Individual (1 Persona)</option>
              <option value="2 Adultos" selected>2 Adultos (Pareja / Amigos)</option>
              <option value="Familia con Niños">Familia con Niños</option>
              <option value="Grupo Pequeño (3-5)">Grupo Pequeño (3 - 5 Personas)</option>
              <option value="Grupo Grande (6+)">Grupo Grande (6+ Personas)</option>
            </select>
            <label for="plan-travelers">Tamaño del Grupo</label>
          </div>

          <div class="form-group">
            <input type="text" id="plan-dates" x-model="formData.travelMonth" placeholder=" " />
            <label for="plan-dates">Fechas aproximadas o mes de viaje</label>
          </div>

          <!-- Accommodation Style Preference -->
          <div class="form-group form-col-full">
            <div class="style-select-wrap">
              <span class="style-legend"><i class="fa-solid fa-hotel"></i> Categoría de Alojamiento Deseada</span>
              <div class="style-pills">
                {['Riads Estándar', 'Confort Boutique', 'Glamping de Lujo 5 Estrellas'].map(st => (
                  <button 
                    type="button" 
                    class="style-pill-btn"
                    :class={`formData.style === '${st}' ? 'active' : ''`}
                    @click={`formData.style = '${st}'`}
                  >
                    {st}
                  </button>
                ))}
              </div>
            </div>
          </div>

          <!-- Trip Vision / Special Requests -->
          <div class="form-group form-col-full">
            <textarea 
              id="plan-message" 
              x-model="formData.message" 
              placeholder=" " 
              rows="4" 
              required
            ></textarea>
            <label for="plan-message">Cuéntanos sobre tus deseos de viaje (lugares que te gustaría visitar, ritmo deseado, dietas especiales, celebraciones...)</label>
          </div>

          <!-- Submit Button -->
          <div class="form-col-full" style="text-align: center; margin-top: 10px;">
            <button type="submit" class="btn btn-primary inquiry-submit-btn">
              <i class="fa-solid fa-paper-plane" style="margin-right: 8px;"></i> Solicitar Itinerario a Medida
            </button>
            <p class="form-privacy-note">
              <i class="fa-solid fa-shield-halved" style="color:var(--sand-gold);"></i> 
              Sin compromiso &bull; Presupuesto personalizado 100% gratuito &bull; Asistencia local directa en Marruecos
            </p>
          </div>
        </form>

        <!-- Success Modal Overlay -->
        <div class="success-overlay" :class="showModal ? 'active' : ''" id="contact-success-modal">
          <div class="success-card">
            <div class="success-icon-box">
              <i class="fa-solid fa-circle-check"></i>
            </div>
            <h3>¡Shukran, <span x-text="modalName"></span>!</h3>
            <p>
              Tu solicitud de itinerario a medida ha sido enviada a <strong>Sahara Star Tours</strong>. 
              Nuestros diseñadores expertos en Marrakech están preparando tu propuesta personalizada.
            </p>
            <p class="modal-subtext">
              Revisa tu bandeja de entrada (<strong x-text="modalEmail"></strong>) en las próximas 24 horas para recibir el presupuesto detallado.
            </p>
            <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:20px;">
              <a href="https://wa.me/212678317015" target="_blank" rel="noopener" class="btn btn-secondary">
                <i class="fa-brands fa-whatsapp" style="color:#25D366;margin-right:6px;"></i> Acelerar por WhatsApp
              </a>
              <button type="button" class="btn btn-primary" @click="closeModal()">
                Volver a la Web
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- TRUST & GUARANTEE GRID -->
      <div class="why-book-grid reveal active">
        <div class="why-book-card">
          <div class="wb-icon"><i class="fa-solid fa-compass"></i></div>
          <h4>100% Privado y a Medida</h4>
          <p>Cada itinerario se adapta a tu ritmo personal, horarios de vuelo y preferencias de alojamiento.</p>
        </div>
        <div class="why-book-card">
          <div class="wb-icon"><i class="fa-solid fa-id-card"></i></div>
          <h4>Guías y Chóferes Oficiales</h4>
          <p>Conductores profesionales nativos con vehículos 4x4 y minivans confortables con aire acondicionado.</p>
        </div>
        <div class="why-book-card">
          <div class="wb-icon"><i class="fa-solid fa-shield-halved"></i></div>
          <h4>Precios Transparentes</h4>
          <p>Sin costes ocultos ni paradas comerciales obligadas. Cada presupuesto desglosa el transporte, riads y actividades.</p>
        </div>
        <div class="why-book-card">
          <div class="wb-icon"><i class="fa-solid fa-clock-rotate-left"></i></div>
          <h4>Asistencia Local 24/7</h4>
          <p>Desde la bienvenida en el aeropuerto hasta la despedida, nuestro equipo en Marrakech está siempre a tu lado.</p>
        </div>
      </div>

      <!-- FREQUENTLY ASKED QUESTIONS ACCORDION -->
      <div class="contact-faq-section reveal active">
        <div class="faq-header">
          <span class="tag"><i class="fa-solid fa-circle-question"></i> Respuestas Claras</span>
          <h2>Preguntas Frecuentes al Planificar tu Viaje</h2>
        </div>

        <div class="faq-accordion-list">
          <details class="faq-item">
            <summary class="faq-summary">
              <span>¿Con cuánta antelación debo reservar mi circuito por Marruecos?</span>
              <i class="fa-solid fa-chevron-down faq-chevron"></i>
            </summary>
            <div class="faq-answer">
              <p>Recomendamos reservar con 4 a 8 semanas de antelación para fechas habituales, y con 2 a 4 meses si viajas en temporada alta (Semana Santa, Navidad/Fin de Año u otoño), ya que los campamentos VIP en el desierto y los riads boutique tienen plazas limitadas.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-summary">
              <span>¿Qué tipo de vehículos utilizáis para las rutas?</span>
              <i class="fa-solid fa-chevron-down faq-chevron"></i>
            </summary>
            <div class="faq-answer">
              <p>Utilizamos modernos Toyota Prado TX 4x4 y furgonetas Mercedes-Benz Vito/Sprinter con aire acondicionado, asientos de cuero y amplio espacio para el equipaje, con mantenimiento riguroso y seguro integral.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-summary">
              <span>¿Es seguro viajar por el desierto del Sáhara?</span>
              <i class="fa-solid fa-chevron-down faq-chevron"></i>
            </summary>
            <div class="faq-answer">
              <p>Totalmente seguro. Marruecos es un país muy seguro y hospitalario. Nuestros chóferes y guías son nativos del desierto con un conocimiento profundo de las rutas, el clima y los puertos de montaña del Atlas.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-summary">
              <span>¿Podemos personalizar las comidas y las paradas?</span>
              <i class="fa-solid fa-chevron-down faq-chevron"></i>
            </summary>
            <div class="faq-answer">
              <p>Por supuesto. Al tratarse de un circuito 100% privado, tú decides el ritmo: detenerte para tomar fotos panorámicas, degustar la gastronomía tradicional en pueblos bereberes o ajustar los horarios a tu gusto.</p>
            </div>
          </details>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  /* CONTACT HERO */
  .contact-hero {
    position: relative;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 20px 60px;
    background: url('/assets/marrakech_riad_pool.png') center/cover no-repeat;
  }
  .contact-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17,14,13,0.78) 0%, rgba(17,14,13,0.92) 100%);
    backdrop-filter: blur(2px);
  }
  .contact-hero-content {
    position: relative;
    z-index: 2;
    max-width: 820px;
    margin: 0 auto;
  }
  .contact-breadcrumbs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 20px;
  }
  .contact-breadcrumbs a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .contact-breadcrumbs a:hover {
    color: var(--sand-gold);
  }
  .contact-breadcrumbs .sep {
    font-size: 0.7rem;
    opacity: 0.6;
  }
  .contact-breadcrumbs .current {
    color: var(--sand-gold);
    font-weight: 500;
  }
  .contact-hero h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-family: var(--font-serif);
    color: var(--text-main);
    line-height: 1.2;
    margin: 12px 0 16px;
  }
  .contact-hero p {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.85);
    line-height: 1.7;
    max-width: 680px;
    margin: 0 auto;
  }

  /* BODY */
  .contact-page-body {
    padding: 60px 20px 100px;
    background: var(--night-bg);
  }
  .contact-page-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  /* CHANNELS GRID */
  .contact-channels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }
  .contact-card {
    background: var(--night-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    padding: 30px 24px;
    display: flex;
    align-items: flex-start;
    gap: 20px;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .contact-card:hover {
    transform: translateY(-4px);
    border-color: var(--sand-gold);
    box-shadow: 0 12px 30px rgba(0,0,0,0.3);
  }
  .c-card-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
    position: relative;
  }
  .wa-icon {
    background: rgba(37, 211, 102, 0.15);
    color: #25D366;
  }
  .c-live-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    background: #25D366;
    color: #000;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 10px;
    text-transform: uppercase;
  }
  .email-icon {
    background: rgba(217, 107, 67, 0.15);
    color: var(--terracotta);
  }
  .address-icon {
    background: rgba(232, 195, 158, 0.15);
    color: var(--sand-gold);
  }
  .c-card-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .c-card-tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--sand-gold);
    font-weight: 600;
  }
  .c-card-details h3 {
    font-size: 1.15rem;
    color: var(--text-main);
    margin: 0;
  }
  .c-card-details p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 4px 0 8px;
    line-height: 1.5;
  }
  .c-card-val {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-main);
  }

  /* INQUIRY FORM CARD */
  .inquiry-form-card {
    background: var(--night-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 50px 40px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    position: relative;
  }
  .inquiry-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 40px;
  }
  .inquiry-header h2 {
    font-size: 2rem;
    font-family: var(--font-serif);
    color: var(--text-main);
    margin: 12px 0 10px;
  }
  .inquiry-header p {
    color: var(--text-muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }
  .inquiry-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .form-col-full {
    grid-column: 1 / -1;
  }
  .form-group {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 16px 18px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: var(--radius-sm);
    color: var(--text-main);
    font-size: 0.95rem;
    font-family: inherit;
    transition: all 0.2s;
    outline: none;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--sand-gold);
    background: rgba(255,255,255,0.06);
    box-shadow: 0 0 0 3px rgba(232, 195, 158, 0.15);
  }
  .form-group label {
    position: absolute;
    top: 17px;
    left: 18px;
    color: var(--text-muted);
    font-size: 0.9rem;
    pointer-events: none;
    transition: all 0.2s;
    background: transparent;
  }
  .form-group input:focus ~ label,
  .form-group input:not(:placeholder-shown) ~ label,
  .form-group select ~ label,
  .form-group textarea:focus ~ label,
  .form-group textarea:not(:placeholder-shown) ~ label {
    top: -10px;
    left: 14px;
    font-size: 0.75rem;
    color: var(--sand-gold);
    background: var(--night-card);
    padding: 0 6px;
    border-radius: 4px;
  }
  .form-group select {
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23e8c39e'%3e%3cpath d='M7 10l5 5 5-5z'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 14px center;
    background-size: 18px;
    cursor: pointer;
  }
  .form-group select option {
    background: #1a1614;
    color: #fff;
  }

  /* STYLE PILLS */
  .style-select-wrap {
    background: rgba(255,255,255,0.02);
    border: 1px dashed rgba(255,255,255,0.15);
    border-radius: var(--radius-sm);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .style-legend {
    font-size: 0.85rem;
    color: var(--sand-gold);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .style-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .style-pill-btn {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.12);
    color: var(--text-muted);
    padding: 10px 18px;
    border-radius: 20px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .style-pill-btn:hover {
    border-color: var(--sand-gold);
    color: var(--text-main);
  }
  .style-pill-btn.active {
    background: var(--sand-gold);
    color: #110e0d;
    border-color: var(--sand-gold);
    font-weight: 600;
  }

  /* SUBMIT */
  .inquiry-submit-btn {
    padding: 16px 42px;
    font-size: 1.05rem;
    letter-spacing: 0.5px;
