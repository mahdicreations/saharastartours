---
// src/pages/es/about.astro — Spanish About Us page
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAlternateUrls } from '../../data/i18n';

const alternateUrls = getAlternateUrls('/about');

const aboutSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "name": "Sobre Nosotros | Sahara Star Tours",
      "description": "Conoce a Sahara Star Tours: especialistas locales en Marrakech con más de 15 años de experiencia diseñando circuitos privados a medida por Marruecos y el Sáhara.",
      "url": alternateUrls.es
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": alternateUrls.es.replace('/about', '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Sobre Nosotros",
          "item": alternateUrls.es
        }
      ]
    }
  ]
};
---

<BaseLayout
  title="Sobre Nosotros | Sahara Star Tours - Expertos Locales en Marruecos"
  description="Conoce a Sahara Star Tours: especialistas locales en Marrakech con más de 15 años de experiencia diseñando circuitos privados a medida por Marruecos y el Sáhara."
  keywords="sobre sahara star tours, agencia de viajes marruecos, guias locales marrakech, expertos marruecos"
  currentPage="about"
  lang="es"
  alternateUrls={alternateUrls}
  schemaData={aboutSchema}
>

<section class="about-hero">
  <div class="about-hero-bg">
    <img src="/assets/marrakech_riad_pool.png" alt="Equipo de Sahara Star Tours" />
  </div>
  <div class="about-hero-gradient"></div>
  <div class="about-hero-content">
    <span class="tour-tag">Nuestra Historia</span>
    <h1>Somos Sahara Star Tours</h1>
    <p>Expertos locales marroquíes dedicados a crear viajes que van más allá del turismo convencional: expediciones privadas hechas a tu medida.</p>
  </div>
</section>

<section class="about-story">
  <div class="about-story-grid">
    <div class="about-story-text">
      <span class="tag">Desde 2009</span>
      <h2>Nacidos en el Desierto, Guiados por la Pasión</h2>
      <p>Sahara Star Tours nació en Marrakech de la mano de apasionados viajeros locales bereberes convencidos de que la autenticidad debe ser accesible para todos, sin renunciar al confort ni a la personalización.</p>
      <p>Tras más de 15 años y 2.400+ viajeros satisfechos, nos hemos consolidado como una de las agencias privadas más fiables de Marruecos, especializada en expediciones por el desierto, inmersiones en medinas imperiales y rutas por el Alto Atlas.</p>
      <p>Nuestra promesa es clara: cada itinerario se diseña a medida, se guía por expertos nativos y se realiza con el conocimiento íntimo que solo los hijos del desierto pueden ofrecer.</p>
    </div>
    <div class="about-story-visual">
      <img src="/assets/sahara_star_camp_night.jpg" alt="Campamento de lujo en el desierto de Sahara Star Tours" />
      <div class="about-story-badge">
        <div class="story-badge-value">2.400+</div>
        <div class="story-badge-label">Viajeros Felices</div>
      </div>
    </div>
  </div>
</section>

<section class="about-values">
  <div class="section-header reveal active">
    <span class="tag">Nuestra Filosofía</span>
    <h2>Nuestros Valores Fundamentales</h2>
  </div>
  <div class="values-grid">
    {[
      { icon: 'fa-solid fa-compass', title: 'Conocimiento Local Auténtico', desc: 'Nuestros guías son narradores nativos que transmiten siglos de sabiduría cultural bereber y marroquí en cada rincón.' },
      { icon: 'fa-solid fa-sliders', title: '100% a Medida', desc: 'Cada circuito se crea desde cero según tus gustos, fechas y ritmo: no hay dos viajes idénticos en Sahara Star Tours.' },
      { icon: 'fa-solid fa-shield-halved', title: 'Seguridad y Confianza', desc: 'Operador con licencia oficial ONMT. Vehículos 4x4 y minivans de alta gama con mantenimiento riguroso y conductores profesionales certificados.' },
      { icon: 'fa-solid fa-leaf', title: 'Turismo Sostenible', desc: 'Colaboramos estrechamente con familias y campamentos bereberes locales, apoyando de forma directa la economía de las comunidades del desierto.' },
    ].map(v => (
      <div class="value-card reveal active">
        <div class="value-icon"><i class={v.icon}></i></div>
        <h3>{v.title}</h3>
        <p>{v.desc}</p>
      </div>
    ))}
  </div>
</section>

<section class="about-cta">
  <h2>¿Listo para Comenzar tu Viaje por Marruecos?</h2>
  <p>Nuestros diseñadores de viajes están listos para preparar tu itinerario perfecto de forma 100% gratuita y sin compromiso.</p>
  <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-top:30px;">
    <a href="/es/contact" class="btn btn-primary"><i class="fa-solid fa-paper-plane"></i> Diseña tu Viaje</a>
    <a href="/es/desert-tours" class="btn btn-secondary"><i class="fa-solid fa-compass"></i> Ver Circuitos</a>
  </div>
</section>

</BaseLayout>

<style>
.about-hero { height: 70vh; min-height: 480px; position: relative; display: flex; align-items: flex-end; overflow: hidden; padding-bottom: 60px; }
.about-hero-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.about-hero-bg img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.4) contrast(1.1); }
.about-hero-gradient { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to bottom, rgba(10,8,7,0.1) 0%, rgba(10,8,7,0.55) 60%, var(--night-bg) 100%); }
.about-hero-content { position: relative; z-index: 2; max-width: 1400px; margin: 0 auto; padding: 0 5%; width: 100%; }
.about-hero-content h1 { font-size: 3.5rem; color: var(--text-main); margin: 12px 0 16px; }
.about-hero-content p { font-size: 1.2rem; max-width: 600px; }
.about-story { padding: 100px 5%; }
.about-story-grid { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
.about-story-text .tag { color: var(--sand-gold); text-transform: uppercase; letter-spacing: 3px; font-size: 0.85rem; font-weight: 600; display: inline-block; margin-bottom: 12px; }
.about-story-text h2 { font-size: 2.5rem; margin-bottom: 24px; }
.about-story-text p { margin-bottom: 20px; font-size: 1.05rem; line-height: 1.8; }
.about-story-visual { position: relative; border-radius: var(--radius-md); overflow: hidden; height: 450px; }
.about-story-visual img { width: 100%; height: 100%; object-fit: cover; }
.about-story-badge { position: absolute; bottom: 25px; right: 25px; background: rgba(17,14,13,0.9); backdrop-filter: blur(10px); border: 1px solid rgba(232,195,158,0.2); border-radius: var(--radius-sm); padding: 16px 20px; text-align: center; }
.story-badge-value { font-family: var(--font-serif); font-size: 2rem; color: var(--sand-gold); font-weight: 700; }
.story-badge-label { font-size: 0.8rem; color: var(--text-muted); }
.about-values { padding: 80px 5%; background: var(--night-surface); border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border); }
.values-grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px; }
.value-card { background: var(--night-card); border: 1px solid var(--glass-border); border-radius: var(--radius-md); padding: 30px; text-align: center; transition: var(--transition-smooth); }
.value-card:hover { border-color: rgba(232,195,158,0.25); transform: translateY(-8px); box-shadow: var(--shadow-premium); }
.value-icon { width: 64px; height: 64px; background: rgba(217,107,67,0.1); border: 1px solid rgba(217,107,67,0.25); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; }
.value-icon i { color: var(--sand-gold); font-size: 1.6rem; }
.value-card h3 { font-size: 1.2rem; margin-bottom: 12px; }
.about-cta { padding: 100px 5%; text-align: center; max-width: 900px; margin: 0 auto; }
.about-cta h2 { font-size: 2.8rem; margin-bottom: 20px; }
.about-cta p { font-size: 1.15rem; color: var(--text-muted); }
@media (max-width: 992px) {
  .about-story-grid { grid-template-columns: 1fr; gap: 40px; }
  .about-hero-content h1 { font-size: 2.5rem; }
}
</style>
