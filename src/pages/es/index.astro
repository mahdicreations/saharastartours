---
// src/pages/es/index.astro — Spanish Homepage
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllLocalizedTours } from '../../data/toursI18n';
import { getAlternateUrls } from '../../data/i18n';

const allTours = getAllLocalizedTours('es');
const alternateUrls = getAlternateUrls('/');

// Curated 6 most popular flagship tours for homepage "All Tours" tab (2 rows of 3)
const popularAllTours = [
  allTours.find(t => t.slug === '3-days-desert-tour-marrakech-to-fes') || allTours[0],
  allTours.find(t => t.slug === '7-day-morocco-tour-from-casablanca') || allTours[1],
  allTours.find(t => t.slug === '11-days-morocco-classic-tour') || allTours[2],
  allTours.find(t => t.slug === 'day-trip-essaouira-mogador') || allTours[3],
  allTours.find(t => t.slug === 'hot-air-balloon-marrakech') || allTours[4],
  allTours.find(t => t.slug === '12-days-morocco-tour') || allTours[5],
];

// Top 6 per category (2 rows of 3)
const popularDesertTours = allTours.filter(t => t.category === 'desert-tours').slice(0, 6);
const popularImperialTours = allTours.filter(t => t.category === 'imperial-cities').slice(0, 6);
const popularDayTrips = allTours.filter(t => t.category === 'day-trips').slice(0, 6);
const popularActivities = allTours.filter(t => t.category === 'activities').slice(0, 6);

// Stats for trust section
const stats = [
  { value: '2.400+', label: 'Viajeros Felices' },
  { value: '98%', label: 'Tasa de Satisfacción' },
  { value: '15+', label: 'Años de Experiencia' },
  { value: `${allTours.length}`, label: 'Itinerarios Únicos' },
];

// Culture cards
const cultureItems = [
  {
    title: 'Jaimas de Lujo en el Desierto',
    desc: 'Duerme bajo miles de millones de estrellas en una jaima bereber de lujo en las dunas de Erg Chebbi. Despierta con un paseo en dromedario al amanecer sobre el mar de arena dorada.',
    image: '/assets/camel_trek_dunes.png',
  },
  {
    title: 'Medinas Imperiales',
    desc: 'Pasea por el laberinto de 1.200 años de historia de Fes el-Bali, una medina viva declarada Patrimonio de la Humanidad por la UNESCO donde nada ha cambiado en siglos.',
    image: '/assets/fes_medina_gate.png',
  },
  {
    title: 'Chefchaouen, la Ciudad Azul',
    desc: 'La Perla Azul de Marruecos: cada rincón bañado en intensos tonos añiles y celestes, acunada entre las brumas de la cordillera del Rif.',
    image: '/assets/chefchaouen_street.png',
  },
  {
    title: 'Rutas por el Alto Atlas',
    desc: 'Cruza la cordillera del Alto Atlas por el espectacular paso de Tizi n\'Tichka a 2.260 m, descubriendo pueblos bereberes con vistas panorámicas sobrecogedoras.',
    image: '/assets/atlas_mountains_valley.png',
  },
];

// Reviews with authentic generated traveler portraits
const reviews = [
  { 
    stars: 5, 
    quote: "La experiencia de viaje más mágica de nuestras vidas: el amanecer en dromedario y el campamento de lujo superaron todos los sueños.", 
    name: 'Sophie Laurent', 
    location: 'París, Francia', 
    avatar: '/assets/reviews/sophie.jpg',
    badge: 'Jaimas de Lujo en Erg Chebbi'
  },
  { 
    stars: 5, 
    quote: "Guía privado extraordinario en la medina de Fez. El transporte Mercedes VIP y los riads boutique nos hicieron sentir como la realeza.", 
    name: 'Marco Rossi', 
    location: 'Milán, Italia', 
    avatar: '/assets/reviews/marco.jpg',
    badge: 'Ciudades Imperiales y Riads'
  },
  { 
    stars: 5, 
    quote: "Nuestra luna de miel de 12 días fue pura perfección. Cada terraza de riad, puerto de montaña y contacto local estuvo impecablemente organizado.", 
    name: 'David & Emma Clark', 
    location: 'Londres, Reino Unido', 
    avatar: '/assets/reviews/david_emma.jpg',
    badge: 'Gran Circuito Marruecos 12 Días'
  },
];

// Category tabs configuration
const categoryList = [
  { id: 'all', label: 'Todos los Circuitos', count: allTours.length },
  { id: 'desert-tours', label: 'Rutas por el Desierto', count: allTours.filter(t => t.category === 'desert-tours').length },
  { id: 'imperial-cities', label: 'Ciudades Imperiales', count: allTours.filter(t => t.category === 'imperial-cities').length },
  { id: 'day-trips', label: 'Excursiones de un Día', count: allTours.filter(t => t.category === 'day-trips').length },
  { id: 'activities', label: 'Actividades', count: allTours.filter(t => t.category === 'activities').length },
];

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Sahara Star Tours",
  "url": alternateUrls.es
};
---

<BaseLayout
  title="Sahara Star Tours | Agencia de Viajes y Circuitos por el Desierto en Marruecos"
  description="Descubre Marruecos con Sahara Star Tours. Rutas privadas por el desierto del Sáhara, circuitos por Ciudades Imperiales y viajes a medida con guías bereberes oficiales."
  keywords="sahara star tours, agencia viajes marruecos, rutas desierto sahara, circuitos marruecos, viajes privados marruecos, excursiones marrakech"
  currentPage="home"
  lang="es"
  alternateUrls={alternateUrls}
  schemaData={homeSchema}
>

<!-- HERO SECTION -->
<section class="hero" id="hero">
  <div class="hero-background">
    <img src="/assets/hero_sahara_sunset.png" alt="Sahara Star Tours – Agencia de Viajes Líder en Marruecos" fetchpriority="high" loading="eager" />
  </div>
  <div class="hero-gradient"></div>
  <div class="hero-content">
    <span class="subtitle">SAHARA STAR TOURS — EXPERTOS EN VIAJES POR MARRUECOS</span>
    <h1>Circuitos Privados por Marruecos y <span>Experiencias en el Desierto del Sáhara</span></h1>
    <p>Descubre viajes inolvidables por Marruecos, desde las dunas doradas del Sáhara hasta las vibrantes calles de Marrakech, Chefchaouen y más allá, con itinerarios auténticos diseñados por expertos locales.</p>
    <div class="hero-btns">
      <a href="/es/tours" class="btn btn-primary"><i class="fa-solid fa-compass"></i> Explorar Circuitos</a>
      <a href="/es/contact" class="btn btn-secondary"><i class="fa-solid fa-paper-plane"></i> Planificar Viaje a Medida</a>
    </div>
    <div class="hero-trust-row">
      <span class="hero-trust-item">
        <i class="fa-solid fa-star"></i> 5 Estrellas (Más de 500 Opiniones)
      </span>
      <span class="hero-trust-item">
        <i class="fa-solid fa-certificate"></i> Agencia Oficial con Licencia
      </span>
      <span class="hero-trust-item">
        <i class="fa-solid fa-headset"></i> Atención Exclusiva 24/7
      </span>
    </div>
  </div>
</section>

<!-- STATS TRUST BAR -->
<div class="stats-bar reveal active">
  {stats.map(s => (
    <div class="stat-item">
      <span class="stat-value">{s.value}</span>
      <span class="stat-label">{s.label}</span>
    </div>
  ))}
</div>

<!-- AGENCY PRESENTATION / ABOUT INTRO SECTION -->
<section class="agency-intro-section reveal active" id="about-sahara-star">
  <div class="agency-intro-container">
    <div class="agency-intro-content">
      <div class="agency-trust-pill">
        <i class="fa-solid fa-shield-halved"></i>
        <span>Operador Turístico Local de Confianza | Licencia Oficial</span>
      </div>
      
      <div class="agency-header-row">
        <div class="agency-logo-wrap">
          <img src="/assets/logo.png" alt="Logo Sahara Star Tours" class="agency-intro-logo" width="75" height="75" />
        </div>
        <div class="agency-header-text">
          <span class="agency-subtag">Marrakech • Desierto del Sáhara • Ciudades Imperiales</span>
          <h2 class="agency-title">Bienvenidos a <span>Sahara Star Tours</span></h2>
        </div>
      </div>

      <p class="agency-lead-text">
        Con sede en Marrakech y operativa en todo el país, <strong>Sahara Star Tours</strong> es una agencia de viajes y operador turístico oficial con licencia en Marruecos. Nacidos de generaciones de conocimiento del desierto y hospitalidad bereber, diseñamos expediciones privadas auténticas que te conectan con el alma de Marruecos.
      </p>

      <p class="agency-body-text">
        Desde dormir bajo un millón de estrellas en nuestros campamentos de lujo en Erg Chebbi hasta cruzar los puertos del Alto Atlas en vehículos Mercedes climatizados y explorar medinas imperiales milenarias con historiadores certificados: cada viaje se diseña a medida con confort de 5 estrellas y precios locales transparentes.
      </p>

      <div class="agency-highlights-grid">
        <div class="agency-hl-item">
          <div class="agency-hl-icon"><i class="fa-solid fa-certificate"></i></div>
          <div class="agency-hl-text">
            <strong>Licencia Ministerial y Seguro</strong>
            <span>Permiso oficial de turismo y cobertura completa de pasajeros</span>
          </div>
        </div>
        <div class="agency-hl-item">
          <div class="agency-hl-icon"><i class="fa-solid fa-compass"></i></div>
          <div class="agency-hl-text">
            <strong>Guías Nómadas Nativos</strong>
            <span>Generaciones de conocimiento del Sáhara e historiadores en medinas</span>
          </div>
        </div>
        <div class="agency-hl-item">
          <div class="agency-hl-icon"><i class="fa-solid fa-car-side"></i></div>
          <div class="agency-hl-text">
            <strong>Flota Privada VIP</strong>
            <span>Vehículos Mercedes con aire acondicionado, wifi y asientos de piel</span>
          </div>
        </div>
        <div class="agency-hl-item">
          <div class="agency-hl-icon"><i class="fa-solid fa-sliders"></i></div>
          <div class="agency-hl-text">
            <strong>100% a Medida</strong>
            <span>Fechas flexibles, selección de riads de lujo y atención 24/7</span>
          </div>
        </div>
      </div>

      <div class="agency-intro-actions">
        <a href="/es/about" class="btn btn-secondary">
          <i class="fa-solid fa-circle-info"></i> Descubre Nuestra Historia
        </a>
        <a href="/es/contact" class="btn btn-primary">
          <i class="fa-solid fa-paper-plane"></i> Planifica tu Viaje
        </a>
      </div>
    </div>

    <div class="agency-intro-visual">
      <div class="agency-image-card">
        <img 
          src="/assets/sahara_star_camp_night.jpg" 
          alt="Campamento de Lujo en el Desierto Sahara Star Tours" 
          class="agency-main-img"
          loading="lazy"
        />
        <div class="agency-img-caption">
          <!-- Badge 1: 5-Star Reviews -->
          <div class="agency-caption-badge badge-reviews">
            <div class="acb-rating-row">
              <span class="acb-stars">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
              </span>
              <strong class="acb-score">4.9/5</strong>
            </div>
            <div class="acb-subtext">Basado en más de 2.400 opiniones</div>
          </div>

          <!-- Badge 2: Trusted & Officially Licensed -->
          <div class="agency-caption-badge badge-license">
            <div class="acb-license-title">
              <i class="fa-solid fa-shield-halved"></i>
              <strong>Operador Local Oficial</strong>
            </div>
            <div class="acb-license-sub">Licencia Oficial #48D/19</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TOURS SECTION -->
<section class="tours-section" id="tours">
  <div class="section-header reveal active">
    <span class="tag"><i class="fa-solid fa-fire-flame-curved"></i> Nuestras Rutas Más Populares</span>
    <h2>Circuitos por Marruecos Diseñados a Mano</h2>
    <p>Cada viaje es una experiencia única: con chófer y guía privado, alojamientos con encanto y totalmente adaptado a tu visión soñada de Marruecos.</p>
    <div class="special-offer-banner">
      <span class="sob-icon"><i class="fa-solid fa-tag"></i></span>
      <span class="sob-text">Oferta Especial de Temporada: Ahorra <strong>hasta un 30% DTO</strong> en todos los paquetes privados!</span>
    </div>
  </div>

  <div class="category-showcase-container" x-data="{ activeTab: 'all' }">
    <!-- Category Filter Tabs -->
    <ul class="category-tabs" id="category-tabs">
      {categoryList.map(cat => (
        <li>
          <button 
            class="category-tab"
            :class={`activeTab === '${cat.id}' ? 'active' : ''`}
            @click={`activeTab = '${cat.id}'`}
            type="button"
          >
            {cat.label} <span>({cat.count})</span>
          </button>
        </li>
      ))}
    </ul>

    <!-- Tour Cards Grid -->
    <div class="category-tours-wrapper">
      <!-- ALL TOURS TAB -->
      <div 
        class="category-tour-grid" 
        x-show="activeTab === 'all'" 
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 scale-95"
        x-transition:enter-end="opacity-100 scale-100"
      >
        {popularAllTours.map(tour => (
          <article class="tour-card reveal active">
            <div class="tour-img-wrapper">
              <img 
                src={tour.heroImage} 
                alt={tour.shortTitle} 
                loading="lazy"
                onerror="this.src='/assets/hero_sahara_sunset.png'"
              />
              {tour.badge && <span class="tour-badge">{tour.badge}</span>}
            </div>
            <div class="tour-info">
              <div class="tour-meta">
                <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
                <div><i class="fa-solid fa-location-dot"></i> {tour.startingFrom}</div>
              </div>
              <h3 class="tour-title">{tour.shortTitle}</h3>
              <p class="tour-desc">{tour.description}</p>
              <div class="tour-footer">
                <div class="tour-price">
                  <span class="tour-price-label">Desde</span>
                  <span class="tour-price-value">{tour.price.replace(/^(From|Desde|Da|A partire da)\s*/i, '').replace(/\/(persona|person)\s*/i, '').trim()}</span>
                </div>
                <a href={`/es/tours/${tour.slug}`} class="btn btn-primary btn-sm">
                  Ver Circuito <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- DESERT TOURS TAB -->
      <div 
        class="category-tour-grid" 
        x-show="activeTab === 'desert-tours'" 
        x-transition:enter="transition ease-out duration-300" 
        x-transition:enter-start="opacity-0 scale-95" 
        x-transition:enter-end="opacity-100 scale-100"
        style="display: none;"
      >
        {popularDesertTours.map(tour => (
          <article class="tour-card reveal active">
            <div class="tour-img-wrapper">
              <img 
                src={tour.heroImage} 
                alt={tour.shortTitle} 
                loading="lazy" 
                onerror="this.src='/assets/hero_sahara_sunset.png'"
              />
              {tour.badge && <span class="tour-badge">{tour.badge}</span>}
            </div>
            <div class="tour-info">
              <div class="tour-meta">
                <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
                <div><i class="fa-solid fa-location-dot"></i> {tour.startingFrom}</div>
              </div>
              <h3 class="tour-title">{tour.shortTitle}</h3>
              <p class="tour-desc">{tour.description}</p>
              <div class="tour-footer">
                <div class="tour-price">
                  <span class="tour-price-label">Desde</span>
                  <span class="tour-price-value">{tour.price.replace(/^(From|Desde|Da|A partire da)\s*/i, '').replace(/\/(persona|person)\s*/i, '').trim()}</span>
                </div>
                <a href={`/es/tours/${tour.slug}`} class="btn btn-primary btn-sm">
                  Ver Circuito <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- IMPERIAL CITIES TAB -->
      <div 
        class="category-tour-grid" 
        x-show="activeTab === 'imperial-cities'" 
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 scale-95"
        x-transition:enter-end="opacity-100 scale-100"
        style="display: none;"
      >
        {popularImperialTours.map(tour => (
          <article class="tour-card reveal active">
            <div class="tour-img-wrapper">
              <img 
                src={tour.heroImage} 
                alt={tour.shortTitle} 
                loading="lazy"
                onerror="this.src='/assets/hero_sahara_sunset.png'"
              />
              {tour.badge && <span class="tour-badge">{tour.badge}</span>}
            </div>
            <div class="tour-info">
              <div class="tour-meta">
                <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
                <div><i class="fa-solid fa-location-dot"></i> {tour.startingFrom}</div>
              </div>
              <h3 class="tour-title">{tour.shortTitle}</h3>
              <p class="tour-desc">{tour.description}</p>
              <div class="tour-footer">
                <div class="tour-price">
                  <span class="tour-price-label">Desde</span>
                  <span class="tour-price-value">{tour.price.replace(/^(From|Desde|Da|A partire da)\s*/i, '').replace(/\/(persona|person)\s*/i, '').trim()}</span>
                </div>
                <a href={`/es/tours/${tour.slug}`} class="btn btn-primary btn-sm">
                  Ver Circuito <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- DAY TRIPS TAB -->
      <div 
        class="category-tour-grid" 
        x-show="activeTab === 'day-trips'" 
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 scale-95"
        x-transition:enter-end="opacity-100 scale-100"
        style="display: none;"
      >
        {popularDayTrips.map(tour => (
          <article class="tour-card reveal active">
            <div class="tour-img-wrapper">
              <img 
                src={tour.heroImage} 
                alt={tour.shortTitle} 
                loading="lazy"
                onerror="this.src='/assets/hero_sahara_sunset.png'"
              />
              {tour.badge && <span class="tour-badge">{tour.badge}</span>}
            </div>
            <div class="tour-info">
              <div class="tour-meta">
                <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
                <div><i class="fa-solid fa-location-dot"></i> {tour.startingFrom}</div>
              </div>
              <h3 class="tour-title">{tour.shortTitle}</h3>
              <p class="tour-desc">{tour.description}</p>
              <div class="tour-footer">
                <div class="tour-price">
                  <span class="tour-price-label">Desde</span>
                  <span class="tour-price-value">{tour.price.replace(/^(From|Desde|Da|A partire da)\s*/i, '').replace(/\/(persona|person)\s*/i, '').trim()}</span>
                </div>
                <a href={`/es/tours/${tour.slug}`} class="btn btn-primary btn-sm">
                  Ver Circuito <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- ACTIVITIES TAB -->
      <div 
        class="category-tour-grid" 
        x-show="activeTab === 'activities'" 
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 scale-95"
        x-transition:enter-end="opacity-100 scale-100"
        style="display: none;"
      >
        {popularActivities.map(tour => (
          <article class="tour-card reveal active">
            <div class="tour-img-wrapper">
              <img 
                src={tour.heroImage} 
                alt={tour.shortTitle} 
                loading="lazy"
                onerror="this.src='/assets/hero_sahara_sunset.png'"
              />
              {tour.badge && <span class="tour-badge">{tour.badge}</span>}
            </div>
            <div class="tour-info">
              <div class="tour-meta">
                <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
                <div><i class="fa-solid fa-location-dot"></i> {tour.startingFrom}</div>
              </div>
              <h3 class="tour-title">{tour.shortTitle}</h3>
              <p class="tour-desc">{tour.description}</p>
              <div class="tour-footer">
                <div class="tour-price">
                  <span class="tour-price-label">Desde</span>
                  <span class="tour-price-value">{tour.price.replace(/^(From|Desde|Da|A partire da)\s*/i, '').replace(/\/(persona|person)\s*/i, '').trim()}</span>
                </div>
                <a href={`/es/tours/${tour.slug}`} class="btn btn-primary btn-sm">
                  Ver Circuito <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Prominent "Explore All Tours" Button -->
    <div class="browse-all-wrapper reveal active">
      <a href="/es/tours" class="btn btn-primary btn-lg">
        <i class="fa-solid fa-compass"></i> Explorar Todos los Circuitos ({allTours.length}) <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </div>
</section>

<!-- STARTING CITIES SECTION -->
<section class="starting-cities-section">
  <div class="section-header reveal active">
    <span class="tag">Ciudades de Salida</span>
    <h2>¿Dónde Comenzará tu Viaje?</h2>
    <p>Ofrecemos salidas desde los principales aeropuertos y ciudades de Marruecos: elige tu punto de partida.</p>
  </div>
  <div class="starting-cities-grid">
    {[
      { city: 'Casablanca', badge: 'Aeropuerto CMN', desc: 'El principal centro aéreo internacional: grandes circuitos y expediciones al desierto con salida desde Casablanca.', tours: `${allTours.filter(t => t.productType === 'multi-day' && t.departureCity === 'Casablanca').length} Itinerarios`, url: '/es/tours-from-casablanca', img: '/assets/casablanca_gateway.png' },
      { city: 'Marrakech', badge: 'Aeropuerto RAK', desc: 'La Perla del Sur: circuitos privados cruzando el Alto Atlas por Tizi n\'Tichka hacia Merzouga y Fez.', tours: `${allTours.filter(t => t.productType === 'multi-day' && t.departureCity === 'Marrakech').length} Itinerarios`, url: '/es/tours-from-marrakech', img: '/assets/marrakech_riad_pool.png' },
      { city: 'Fez', badge: 'Aeropuerto FEZ', desc: 'El corazón cultural de Marruecos: rutas por los bosques de cedros del Medio Atlas y Valle del Ziz a Erg Chebbi.', tours: `${allTours.filter(t => t.productType === 'multi-day' && t.departureCity === 'Fes').length} Itinerarios`, url: '/es/tours-from-fes', img: '/assets/fes_medina_gate.png' },
      { city: 'Tánger', badge: 'Puerto y TNG', desc: 'Puerta de entrada marítima y aérea desde Europa: viajes por Chefchaouen, montes del Rif y travesías al sur.', tours: `${allTours.filter(t => t.productType === 'multi-day' && t.departureCity === 'Tangier').length} Itinerarios`, url: '/es/tours-from-tangier', img: '/assets/tangier_coast.png' },
