---
// src/pages/tours-from-casablanca.astro — Dedicated Casablanca Departure Hub
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMultiDayToursByCity } from '../data/tours';

const tours = getMultiDayToursByCity('Casablanca');

function getDurationTier(days: number): string {
  if (days <= 7) return '4-7';
  if (days <= 10) return '8-10';
  return '11+';
}

const casablancaSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Private Morocco Tours from Casablanca | Sahara Star Tours",
  "description": `Browse our complete collection of ${tours.length} private multi-day Morocco tours departing from Casablanca. Direct airport pickups, Imperial Cities loops, and grand Sahara desert expeditions from 4 to 16 days.`,
  "url": "https://www.saharastartours.com/tours-from-casablanca"
};
---

<BaseLayout
  title={`Tours from Casablanca (${tours.length} Private Grand Loops & Desert Tours) | Sahara Star Tours`}
  description={`Book private tours from Casablanca from 4 to 16 days. Seamless CMN airport pickup, Hassan II Mosque visits, Imperial Cities of Rabat, Fes, and Marrakech, and luxury Erg Chebbi desert glamping.`}
  keywords="tours from casablanca, casablanca desert tour, casablanca to marrakech tour, grand morocco tour from casablanca, morocco private tours from casablanca"
  currentPage="tours"
  schemaData={casablancaSchema}
>

<!-- CITY HERO SECTION -->
<section class="city-hero">
  <div class="city-hero-overlay"></div>
  <div class="city-hero-content">
    <nav class="city-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep"><i class="fa-solid fa-chevron-right"></i></span>
      <a href="/tours">Multi-Day Tours</a>
      <span class="sep"><i class="fa-solid fa-chevron-right"></i></span>
      <span class="current">Tours from Casablanca</span>
    </nav>
    <span class="tag"><i class="fa-solid fa-plane-arrival"></i> Gateway to Grand Morocco Circuits</span>
    <h1>Private Morocco Tours from Casablanca</h1>
    <p>Casablanca is Morocco's primary international aviation gateway. Beginning directly at Mohammed V International Airport (CMN) or your Casablanca hotel, our private multi-day itineraries seamlessly connect the iconic Hassan II Mosque with Morocco's Imperial Capitals, the blue alleyways of Chefchaouen, and the deep golden sands of the Sahara Desert.</p>
  </div>
</section>

<!-- LOCAL EDITORIAL / ROUTE INSIGHTS -->
<section class="city-editorial-section">
  <div class="city-editorial-container">
    <div class="city-editorial-grid">
      <div class="editorial-card">
        <div class="editorial-icon"><i class="fa-solid fa-plane-departure"></i></div>
        <h3>Direct Airport Meet &amp; Greet</h3>
        <p>Your private English-speaking driver greets you warmly inside CMN airport arrivals, escorting you smoothly into a modern air-conditioned vehicle with zero transit stress.</p>
      </div>
      <div class="editorial-card">
        <div class="editorial-icon"><i class="fa-solid fa-mosque"></i></div>
        <h3>Hassan II Mosque &amp; Atlantic Coast</h3>
        <p>Marvel at one of the world's architectural wonders perched dramatically over the Atlantic Ocean before traveling inland toward Morocco's imperial heritage sites.</p>
      </div>
      <div class="editorial-card">
        <div class="editorial-icon"><i class="fa-solid fa-landmark"></i></div>
        <h3>Four Imperial Capitals</h3>
        <p>Casablanca departures offer the ideal geography to link Rabat's coastal towers, Meknes' royal gates, Fes' medieval maze, and Marrakech's bustling souks into one grand journey.</p>
      </div>
      <div class="editorial-card">
        <div class="editorial-icon"><i class="fa-solid fa-sun"></i></div>
        <h3>Comprehensive Sahara Expeditions</h3>
        <p>From 4-day express desert traverses to comprehensive 16-day grand odysseys, experience Erg Chebbi dunes, Todra Gorges, and the southern Kasbah trail with luxury glamping.</p>
      </div>
    </div>
  </div>
</section>

<!-- TOURS CATALOGUE BODY -->
<section class="city-catalog-body">
  <div class="city-catalog-container" x-data="{ activeDuration: 'all' }">
    
    <!-- Filter bar -->
    <div class="city-filter-panel">
      <div class="filter-header-left">
        <h2>{tours.length} Multi-Day Itineraries Departing Casablanca</h2>
        <p>Private luxury transport, licensed local medina guides, and authentic boutique accommodations</p>
      </div>
      <div class="duration-pills-wrap">
        <button
          class="duration-pill"
          :class="activeDuration === 'all' ? 'active' : ''"
          @click="activeDuration = 'all'"
          type="button"
        >
          All Durations ({tours.length})
        </button>
        <button
          class="duration-pill"
          :class="activeDuration === '4-7' ? 'active' : ''"
          @click="activeDuration = '4-7'"
          type="button"
        >
          4–7 Days ({tours.filter(t => t.durationDays <= 7).length})
        </button>
        <button
          class="duration-pill"
          :class="activeDuration === '8-10' ? 'active' : ''"
          @click="activeDuration = '8-10'"
          type="button"
        >
          8–10 Days ({tours.filter(t => t.durationDays >= 8 && t.durationDays <= 10).length})
        </button>
        <button
          class="duration-pill"
          :class="activeDuration === '11+' ? 'active' : ''"
          @click="activeDuration = '11+'"
          type="button"
        >
          11+ Days ({tours.filter(t => t.durationDays >= 11).length})
        </button>
      </div>
    </div>

    <!-- Tours Grid -->
    <div class="city-tours-grid">
      {tours.map(tour => {
        const tier = getDurationTier(tour.durationDays);
        return (
          <article 
            class="tour-card reveal active"
            data-duration-tier={tier}
            x-show={`activeDuration === 'all' || activeDuration === '${tier}'`}
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
          >
            <div class="tour-img-wrapper">
              <img 
                src={tour.heroImage} 
                alt={tour.shortTitle} 
                loading="lazy"
                onerror="this.src='/assets/placeholder-morocco.svg'"
              />
              {tour.badge && <span class="tour-badge">{tour.badge}</span>}
            </div>
            <div class="tour-info">
              <div class="tour-meta">
                <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
                <div><i class="fa-solid fa-location-dot"></i> To: {tour.arrivalCity}</div>
              </div>
              <h3 class="tour-title" style="font-size:1.35rem;">{tour.shortTitle}</h3>
              <p class="tour-desc">{tour.description}</p>
              <div class="tour-footer">
                <div class="tour-price">
                  <span class="tour-price-label">Starting from</span>
                  <span class="tour-price-value">{tour.price.replace(/^From\s*/i, '').replace(/\/person\s*/i, '').trim()}</span>
                </div>
                <a href={`/tours/${tour.slug}`} class="btn btn-primary btn-sm">
                  View Itinerary <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>

<!-- THEMATIC CROSS-LINK BANNER (Imperial Cities) -->
<section class="city-silo-nav">
  <div class="city-silo-container">
    <div class="silo-callout">
      <div class="silo-callout-text">
        <span class="tag"><i class="fa-solid fa-landmark"></i> Cultural Heritage Focus</span>
        <h3>Interested in Cultural Imperial Cities Circuits?</h3>
        <p>Many Casablanca departures visit Morocco's ancient dynasty capitals. If your primary focus is UNESCO medinas, Roman ruins, and palaces, explore our curated Imperial Cities hub:</p>
      </div>
      <div class="silo-callout-btns">
        <a href="/imperial-cities" class="btn btn-secondary">
          <i class="fa-solid fa-archway"></i> Explore Imperial Cities Circuits
        </a>
      </div>
    </div>
  </div>
</section>

<!-- OTHER DEPARTURE HUBS NAVIGATION -->
<section class="other-hubs-nav">
  <div class="other-hubs-container">
    <h3>Explore Multi-Day Tours from Other Departure Cities</h3>
    <div class="other-hubs-pills">
      <a href="/tours-from-marrakech" class="hub-pill"><i class="fa-solid fa-sun"></i> Tours from Marrakech</a>
      <a href="/tours-from-fes" class="hub-pill"><i class="fa-solid fa-landmark"></i> Tours from Fes</a>
      <a href="/tours-from-tangier" class="hub-pill"><i class="fa-solid fa-ship"></i> Tours from Tangier</a>
      <a href="/tours-from-ouarzazate" class="hub-pill"><i class="fa-solid fa-camera"></i> Tours from Ouarzazate</a>
      <a href="/tours" class="hub-pill active"><i class="fa-solid fa-compass"></i> View All Multi-Day Tours</a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
.city-hero {
  position: relative;
  padding: 160px 5% 70px;
  text-align: center;
  background: radial-gradient(circle at 50% 30%, rgba(217, 107, 67, 0.18) 0%, transparent 60%), linear-gradient(180deg, var(--night-surface) 0%, var(--night-bg) 100%);
  border-bottom: 1px solid var(--glass-border);
  overflow: hidden;
}

.city-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url('/assets/zellij_pattern.svg');
  background-repeat: repeat;
  background-size: 180px 180px;
  opacity: 0.15;
  pointer-events: none;
  z-index: 1;
}

.city-hero-content {
  position: relative;
  z-index: 2;
  max-width: 850px;
  margin: 0 auto;
}

.city-breadcrumbs {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  font-size: 0.88rem;
  color: var(--text-muted);
  margin-bottom: 20px;
}

.city-breadcrumbs a {
  color: var(--text-muted);
  transition: color 0.3s;
}

.city-breadcrumbs a:hover {
  color: var(--sand-gold);
}

.city-breadcrumbs .sep {
  font-size: 0.7rem;
  opacity: 0.5;
}

.city-breadcrumbs .current {
  color: var(--sand-gold);
  font-weight: 500;
}

.city-hero h1 {
  font-size: 3rem;
  line-height: 1.15;
  margin: 16px 0 20px;
  background: linear-gradient(135deg, var(--text-main) 30%, var(--sand-gold) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.city-hero p {
  font-size: 1.1rem;
  color: var(--text-muted);
  line-height: 1.7;
}

/* Editorial cards */
.city-editorial-section {
  padding: 50px 5% 20px;
  max-width: 1400px;
  margin: 0 auto;
}

.city-editorial-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 22px;
}

.editorial-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-md);
  padding: 26px 22px;
  transition: all 0.3s ease;
}

.editorial-card:hover {
  border-color: var(--sand-gold);
  transform: translateY(-2px);
}

.editorial-icon {
  font-size: 1.6rem;
  color: var(--sand-gold);
  margin-bottom: 14px;
}

.editorial-card h3 {
  font-size: 1.15rem;
  color: var(--text-main);
  margin: 0 0 8px;
}

.editorial-card p {
  font-size: 0.88rem;
  color: var(--text-muted);
  margin: 0;
  line-height: 1.5;
}

/* Catalog Body */
.city-catalog-body {
  padding: 40px 0 80px;
}

.city-catalog-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 5%;
}

.city-filter-panel {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 20px;
  margin-bottom: 40px;
  padding-bottom: 25px;
  border-bottom: 1px solid var(--glass-border);
}

.filter-header-left h2 {
  font-size: 1.6rem;
  color: var(--text-main);
  margin: 0 0 6px;
}

.filter-header-left p {
  font-size: 0.9rem;
  color: var(--text-muted);
  margin: 0;
}

.duration-pills-wrap {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.duration-pill {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: var(--text-muted);
  border-radius: 30px;
  padding: 7px 18px;
  font-family: var(--font-sans);
  font-size: 0.85rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition-smooth);
}

.duration-pill:hover {
  color: var(--sand-gold);
  border-color: var(--sand-gold);
}

.duration-pill.active {
  background: linear-gradient(135deg, var(--terracotta) 0%, hsl(14, 75%, 45%) 100%);
  border-color: var(--terracotta);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4px 14px var(--terracotta-glow);
}

.city-tours-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 32px;
}

/* Silo callout */
.city-silo-nav {
  padding: 20px 5% 50px;
  max-width: 1400px;
  margin: 0 auto;
}

.silo-callout {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  padding: 35px 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 30px;
  flex-wrap: wrap;
}

.silo-callout-text h3 {
  font-size: 1.35rem;
  color: var(--text-main);
  margin: 8px 0 6px;
}

.silo-callout-text p {
  font-size: 0.92rem;
  color: var(--text-muted);
  margin: 0;
}

.silo-callout-btns {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

/* Other Hubs Navigation */
.other-hubs-nav {
  padding: 30px 5% 90px;
  max-width: 1400px;
  margin: 0 auto;
  text-align: center;
}

.other-hubs-nav h3 {
  font-size: 1.25rem;
  color: var(--text-main);
  margin-bottom: 20px;
}

.other-hubs-pills {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
}

.hub-pill {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--glass-border);
  color: var(--text-muted);
  border-radius: 30px;
  padding: 8px 20px;
  font-size: 0.85rem;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.3s;
}

.hub-pill:hover {
  color: var(--sand-gold);
  border-color: var(--sand-gold);
  transform: translateY(-2px);
}

.hub-pill.active {
  border-color: var(--sand-gold);
  color: var(--sand-gold);
}

@media (max-width: 900px) {
  .city-filter-panel {
    flex-direction: column;
    align-items: flex-start;
  }
  .silo-callout {
    flex-direction: column;
    text-align: center;
  }
  .silo-callout-btns {
    justify-content: center;
  }
  .city-hero h1 {
    font-size: 2.2rem;
  }
}
</style>
