---
// src/pages/index.astro — Homepage
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeaturedTours, getToursByCategory, categoryLabels } from '../data/tours';

const featuredTours = getFeaturedTours(9);

// Stats for trust section
const stats = [
  { value: '2,400+', label: 'Happy Travelers' },
  { value: '98%', label: 'Satisfaction Rate' },
  { value: '15+', label: 'Years Experience' },
  { value: '31', label: 'Unique Itineraries' },
];

// Culture cards
const cultureItems = [
  {
    title: 'Sahara Desert Glamping',
    desc: 'Sleep under a billion stars in a luxury Berber tent deep in the Erg Chebbi dunes. Wake to sunrise camel rides across the golden sea of sand.',
    image: '/assets/camel_trek_dunes.png',
  },
  {
    title: 'Imperial Medinas',
    desc: 'Wander through the 1,200-year-old labyrinthine streets of Fes el-Bali, a living UNESCO World Heritage city where nothing has changed in centuries.',
    image: '/assets/fes_medina_gate.png',
  },
  {
    title: 'Chefchaouen Blue City',
    desc: "Morocco's ethereal Blue Pearl — every surface washed in brilliant indigo and azure, perched in the Rif Mountain mist.",
    image: '/assets/chefchaouen_street.png',
  },
  {
    title: 'High Atlas Treks',
    desc: "Cross the High Atlas range via the dramatic Tizi n'Tichka pass at 2260m, passing through Berber villages with breathtaking mountain views.",
    image: '/assets/atlas_mountains_valley.png',
  },
];

// Reviews
const reviews = [
  { stars: 5, quote: "The most magical travel experience of my life. The desert camp at Erg Chebbi was beyond anything I ever imagined — stars like I've never seen.", name: 'Sophie Laurent', location: 'Paris, France', avatar: '/assets/hero_sahara_sunset.png' },
  { stars: 5, quote: "Our guide was phenomenal. He knew every hidden corner of Fes, every family story behind the tanneries. Authentic, not touristic. Absolutely recommend Sahara Star Tours.", name: 'Marco Rossi', location: 'Milan, Italy', avatar: '/assets/marrakech_riad_pool.png' },
  { stars: 5, quote: "We custom-designed our 12-day trip with their team from scratch. They listened to every single wish. The VIP Mercedes transportation was a dream.", name: 'David & Emma Clark', location: 'London, UK', avatar: '/assets/chefchaouen_street.png' },
  { stars: 5, quote: "The camel trek at sunset, the Berber music by the campfire, the Majorelle Gardens in morning light... Morocco through Sahara Star Tours is pure poetry.", name: 'Alejandro García', location: 'Madrid, Spain', avatar: '/assets/atlas_mountains_valley.png' },
];

// Category tabs configuration
const categoryList = [
  { id: 'all', label: 'All Tours', count: 31 },
  { id: 'desert-tours', label: 'Desert Tours', count: 21 },
  { id: 'imperial-cities', label: 'Imperial Cities', count: 3 },
  { id: 'day-trips', label: 'Day Trips', count: 6 },
  { id: 'activities', label: 'Activities', count: 6 },
];

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Sahara Star Tours",
  "url": "https://www.saharastartours.com",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://www.saharastartours.com/tours/{search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---

<BaseLayout
  title="Sahara Star Tours | Bespoke Sahara Desert & Morocco Travel Agency"
  description="Discover the magic of Morocco with Sahara Star Tours. From luxury Sahara Desert safaris to Marrakech medina tours and high Atlas treks, book your dream journey today."
  keywords="sahara star tours, morocco travel agency, sahara desert tour, marrakech riad booking, moroccan tours, custom travel morocco"
  currentPage="home"
  schemaData={homeSchema}
>

<!-- HERO SECTION -->
<section class="hero" id="hero">
  <div class="hero-background">
    <img src="/assets/hero_sahara_sunset.png" alt="Sahara Star Tours – Morocco's Premier Desert Travel Agency" />
  </div>
  <div class="hero-gradient"></div>
  <div class="hero-content">
    <span class="subtitle">SAHARA STAR TOURS — MOROCCO TRAVEL EXPERTS</span>
    <h1>Discover the <span>Magic of Morocco</span></h1>
    <p>Explore unforgettable Morocco tours, from the golden dunes of the Sahara to the vibrant streets of Marrakech, Chefchaouen and beyond — with authentic journeys crafted by local experts.</p>
    <div class="hero-btns">
      <a href="#tours" class="btn btn-primary"><i class="fa-solid fa-compass"></i> Explore Tours</a>
      <a href="#contact" class="btn btn-secondary"><i class="fa-solid fa-paper-plane"></i> Plan a Custom Trip</a>
    </div>
  </div>
</section>

<!-- STATS TRUST BAR -->
<div class="stats-bar reveal active">
  {stats.map(s => (
    <div class="stat-item">
      <span class="stat-value">{s.value}</span>
      <span class="stat-label">{s.label}</span>
    </div>
  ))}
</div>

<!-- TOURS SECTION -->
<section class="tours-section" id="tours">
  <div class="section-header reveal active">
    <span class="tag">Our Signature Experiences</span>
    <h2>Handcrafted Morocco Tours</h2>
    <p>Each journey is a bespoke masterpiece — privately guided, luxury-accommodated, and completely tailored to your dream vision of Morocco.</p>
  </div>

  <div class="category-showcase-container">
    <!-- Category Filter Tabs -->
    <ul class="category-tabs" x-data="{activeTab:'all'}" id="category-tabs">
      {categoryList.map(cat => (
        <li>
          <button 
            class="category-tab"
            :class={`activeTab === '${cat.id}' ? 'active' : ''`}
            @click={`activeTab = '${cat.id}'`}
            type="button"
          >
            {cat.label} <span>({cat.count})</span>
          </button>
        </li>
      ))}
    </ul>

    <!-- Tour Cards Grid -->
    <div class="category-tours-wrapper">
      <div class="category-tour-grid">
        {featuredTours.map(tour => (
          <article class="tour-card reveal active">
            <div class="tour-img-wrapper">
              <img 
                src={tour.heroImage} 
                alt={tour.shortTitle} 
                loading="lazy"
                onerror="this.src='/assets/hero_sahara_sunset.png'"
              />
              {tour.badge && <span class="tour-badge">{tour.badge}</span>}
            </div>
            <div class="tour-info">
              <div class="tour-meta">
                <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
                <div><i class="fa-solid fa-location-dot"></i> {tour.startingFrom}</div>
              </div>
              <h3 class="tour-title">{tour.shortTitle}</h3>
              <p class="tour-desc">{tour.description}</p>
              <div class="tour-footer">
                <div class="tour-price">
                  Starting from
                  <span>{tour.price}</span>
                </div>
                <a href={`/tours/${tour.slug}`} class="btn btn-primary btn-sm">
                  View Tour <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div style="text-align:center;margin-top:50px;">
      <a href="/desert-tours" class="btn btn-secondary">
        <i class="fa-solid fa-compass"></i> Browse All 31 Tours
      </a>
    </div>
  </div>
</section>

<!-- STARTING CITIES SECTION -->
<section class="starting-cities-section">
  <div class="section-header reveal active">
    <span class="tag">Departure Cities</span>
    <h2>Where Will Your Journey Begin?</h2>
    <p>We offer departures from Morocco's major international airports and cities — choose your gateway.</p>
  </div>
  <div class="starting-cities-grid">
    {[
      { city: 'Casablanca', badge: 'CMN Airport', desc: 'Morocco\'s largest international hub — most tour packages depart from Casablanca, with private transfers arranged to your first destination.', tours: '21 Departures', img: '/assets/casablanca_gateway.png' },
      { city: 'Marrakech', badge: 'RAK Airport', desc: 'The Pearl of the South — a magical starting point for desert adventures, day trips, and activities. Perfect for shorter 3-5 day itineraries.', tours: '15 Departures', img: '/assets/marrakech_riad_pool.png' },
      { city: 'Fes', badge: 'FEZ Airport', desc: 'Begin your Moroccan odyssey in the ancient imperial medina — one-way tours to Marrakech or round trips through the desert.', tours: '8 Departures', img: '/assets/fes_medina_gate.png' },
      { city: 'Tangier', badge: 'TNG Port', desc: 'Cross from Spain by ferry and explore Morocco from the north — access to Chefchaouen, Tetouan, and imperial cities.', tours: '5 Departures', img: '/assets/tangier_coast.png' },
    ].map(c => (
      <div class="city-card reveal active">
        <div class="city-img-wrapper">
          <img src={c.img} alt={`Tours from ${c.city}`} loading="lazy" />
          <span class="city-badge">{c.badge}</span>
        </div>
        <div class="city-content">
          <h3>{c.city}</h3>
          <p>{c.desc}</p>
          <div class="city-meta">
            <span><i class="fa-solid fa-plane-departure"></i> {c.tours}</span>
          </div>
          <div class="city-footer">
            <a href="/desert-tours" class="btn btn-primary btn-sm">View Packages</a>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- CULTURE SECTION -->
<section class="culture-section" id="culture">
  <div class="section-header reveal active">
    <span class="tag">Why Morocco?</span>
    <h2>Experiences That Will Change You</h2>
    <p>Morocco isn't a destination — it's a transformation. Here is a glimpse of what awaits.</p>
  </div>
  <div class="culture-slider">
    {cultureItems.map(item => (
      <div class="culture-card">
        <div class="culture-img">
          <img src={item.image} alt={item.title} loading="lazy" />
        </div>
        <div class="culture-info">
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- COST CALCULATOR / PLANNER -->
<section class="calculator-section" id="planner">
  <div class="section-header reveal active">
    <span class="tag">Plan Your Budget</span>
    <h2>Morocco Trip Cost Calculator</h2>
    <p>Get a personalized estimate for your Morocco dream journey — adjust your group size, duration, and travel style below.</p>
  </div>
  <div 
    class="calculator-container"
    x-data="{
      days: 7,
      people: 2,
      tier: 'standard',
      addons: { camel: false, balloon: false, private: false },
      tiers: { standard: 120, comfort: 195, luxury: 320 },
      get base() { return this.days * this.people * this.tiers[this.tier]; },
      get addonTotal() {
        return (this.addons.camel ? 45 * this.people : 0)
          + (this.addons.balloon ? 180 * this.people : 0)
          + (this.addons.private ? 80 * this.days : 0);
      },
      get total() { return this.base + this.addonTotal; },
      get perPerson() { return Math.round(this.total / this.people); }
    }"
  >
    <div class="calc-inputs">
      <h3>Customize Your Journey</h3>
      <div class="calc-group">
        <div class="calc-label-row">
          <label>Tour Duration</label>
          <span class="calc-value" x-text="days + ' Days'"></span>
        </div>
        <input type="range" min="3" max="16" x-model.number="days" />
      </div>
      <div class="calc-group">
        <div class="calc-label-row">
          <label>Group Size</label>
          <span class="calc-value" x-text="people + ' People'"></span>
        </div>
        <input type="range" min="1" max="12" x-model.number="people" />
      </div>
      <div class="calc-group">
        <div class="calc-label-row"><label>Accommodation Tier</label></div>
        <div class="tier-cards">
          <div class="tier-card" :class="tier==='standard'?'active':''" @click="tier='standard'">
            <i class="fa-solid fa-tent"></i>
            <span>Standard</span>
            <small>Guesthouses & riads</small>
          </div>
          <div class="tier-card" :class="tier==='comfort'?'active':''" @click="tier='comfort'">
            <i class="fa-solid fa-hotel"></i>
            <span>Comfort</span>
            <small>4-star hotels</small>
          </div>
          <div class="tier-card" :class="tier==='luxury'?'active':''" @click="tier='luxury'">
            <i class="fa-solid fa-star"></i>
            <span>Luxury</span>
            <small>5-star riads & camps</small>
          </div>
        </div>
      </div>
      <div class="calc-group">
        <div class="calc-label-row"><label>Add-Ons</label></div>
        <div class="addons-grid">
          <div class="addon-item" :class="addons.camel?'active':''" @click="addons.camel=!addons.camel">
            <input type="checkbox" :checked="addons.camel" />
            <div class="addon-details">
              <span class="addon-name">Camel Trek</span>
              <span class="addon-price">+$45/person</span>
            </div>
          </div>
          <div class="addon-item" :class="addons.balloon?'active':''" @click="addons.balloon=!addons.balloon">
            <input type="checkbox" :checked="addons.balloon" />
            <div class="addon-details">
              <span class="addon-name">Hot Air Balloon</span>
              <span class="addon-price">+$180/person</span>
            </div>
          </div>
          <div class="addon-item" :class="addons.private?'active':''" @click="addons.private=!addons.private">
            <input type="checkbox" :checked="addons.private" />
            <div class="addon-details">
              <span class="addon-name">Private Driver</span>
              <span class="addon-price">+$80/day</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="calc-summary-wrapper">
      <div class="calc-summary">
        <h4>Your Estimate</h4>
        <ul class="calc-summary-details">
          <li><span>Duration</span><span x-text="days + ' days'"></span></li>
          <li><span>Group size</span><span x-text="people + ' people'"></span></li>
          <li><span>Accommodation</span><span x-text="tier.charAt(0).toUpperCase() + tier.slice(1)"></span></li>
          <li><span>Base cost</span><span x-text="'$' + base.toLocaleString()"></span></li>
          <li><span>Add-ons</span><span x-text="'$' + addonTotal.toLocaleString()"></span></li>
        </ul>
        <div class="calc-total-box">
          <div class="planner-status-badge"><i class="fa-solid fa-compass"></i> Total Estimate</div>
          <div style="font-size:2.8rem;font-family:var(--font-serif);color:var(--sand-gold);font-weight:700;line-height:1.1;" x-text="'$' + total.toLocaleString()"></div>
          <div style="font-size:0.9rem;color:var(--text-muted);margin-top:6px;" x-text="'$' + perPerson + ' per person'"></div>
        </div>
        <div class="discount-badge-container">
          <div class="discount-badge">
            <i class="fa-solid fa-tag"></i>
            Early booking saves up to 15%
          </div>
        </div>
        <a href="#contact" class="btn btn-primary" style="width:100%;margin-top:20px;justify-content:center;">
          <i class="fa-solid fa-paper-plane"></i> Get Exact Quote
        </a>
      </div>
    </div>
  </div>
</section>

<!-- REVIEWS -->
<section 
  class="reviews-section"
  x-data="{
    reviews: [
      {stars:5,quote:'The most magical travel experience of my life. The desert camp at Erg Chebbi was beyond anything I ever imagined.',name:'Sophie Laurent',location:'Paris, France'},
      {stars:5,quote:'Our guide was phenomenal. He knew every hidden corner of Fes. Authentic, not touristic. Absolutely recommend Sahara Star Tours.',name:'Marco Rossi',location:'Milan, Italy'},
      {stars:5,quote:'We custom-designed our 12-day trip. They listened to every single wish. The VIP Mercedes transportation was a dream.',name:'David & Emma Clark',location:'London, UK'},
      {stars:5,quote:'The camel trek at sunset, the Berber music by the campfire, the Majorelle Gardens in morning light... Morocco through Sahara Star Tours is pure poetry.',name:'Alejandro García',location:'Madrid, Spain'},
    ],
    current: 0,
    interval: null,
    init() {
      this.interval = setInterval(() => { this.next(); }, 5500);
    },
    next() { this.current = (this.current + 1) % this.reviews.length; },
    prev() { this.current = (this.current - 1 + this.reviews.length) % this.reviews.length; },
    goTo(idx) { this.current = idx; clearInterval(this.interval); }
  }"
>
  <div class="section-header reveal active">
    <span class="tag">Testimonials</span>
    <h2>Stories From Our Travelers</h2>
    <p>Over 2,400 travelers have trusted Sahara Star Tours with their Moroccan dream. Here's what they say.</p>
  </div>
  <div class="reviews-container">
    <div class="reviews-wrapper" :style="`transform: translateX(-${current * 100}%)`">
      <template x-for="(r,idx) in reviews" :key="idx">
        <div class="review-slide">
          <div class="review-stars">
            <template x-for="i in r.stars" :key="i"><i class="fa-solid fa-star"></i></template>
          </div>
          <p class="review-quote" x-text="'&ldquo;' + r.quote + '&rdquo;'"></p>
          <div class="review-user">
            <div class="review-user-info">
              <h5 x-text="r.name"></h5>
              <span x-text="r.location"></span>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div class="review-dots">
      <template x-for="(r,idx) in reviews" :key="idx">
        <span class="review-dot" :class="current===idx?'active':''" @click="goTo(idx)"></span>
      </template>
    </div>
  </div>
</section>

<!-- SEO NARRATIVE -->
<section class="agency-seo-showcase reveal active" id="seo-details">
  <div class="seo-grid">
    <div class="seo-text">
      <span class="tag" style="color:var(--sand-gold);text-transform:uppercase;letter-spacing:2.5px;font-size:0.9rem;font-weight:600">Morocco Travel Experts</span>
      <h3>Bespoke Journeys Crafted by <span>Sahara Star Tours</span></h3>
      <p>As the premier locally-owned travel agency in Marrakech, <strong>Sahara Star Tours</strong> is dedicated to unlocking the deep visual splendor, historical medinas, and rich cultural traditions of Morocco in absolute comfort.</p>
      <p>Our custom point-by-point route maps and day-by-day itineraries are designed by native guides who possess a deep, lifelong connection to the land. Whether you seek a romantic sunset camel safari in Erg Chebbi, an educational walking tour of ancient Fes, or a sunrise hot air balloon flight over the Jbilet desert, we guarantee absolute comfort, private VIP Mercedes transport, and luxurious Riad accommodation tiers.</p>
    </div>
    <div class="seo-highlight-cards">
      <div class="seo-card"><i class="fa-solid fa-compass"></i><h4>Local Nomad Guides</h4><p>Explore the Sahara under the direct tutelage of native desert hosts and certified medina historians.</p></div>
      <div class="seo-card"><i class="fa-solid fa-car-side"></i><h4>VIP Mercedes Fleet</h4><p>Travel across panoramic mountain passes inside climate-controlled VIP leather-seated Mercedes transporters.</p></div>
      <div class="seo-card"><i class="fa-solid fa-star"></i><h4>5-Star Riad Stays</h4><p>Settle inside prestigious boutique zellige Riads and high-end glamping camps featuring en-suite private bathrooms.</p></div>
      <div class="seo-card"><i class="fa-solid fa-sliders"></i><h4>Point-by-Point Tailoring</h4><p>Completely customize your itineraries, dates, Riad pool options, and diet plans to match your exact wishes.</p></div>
    </div>
  </div>
</section>

<!-- CONTACT FORM -->
<section class="contact-section" id="contact">
  <div class="section-header reveal active">
    <span class="tag">Begin Your Journey</span>
    <h2>Submit An Inquiry</h2>
    <p>Ready to trace the red streets of Marrakech or watch Sahara night skies? Send us a message and our expert planning team will draft your custom plan within 24 hours.</p>
  </div>
  <div 
    class="contact-container reveal active"
    x-data="{
      name:'',email:'',travelers:'',pkg:'none',message:'',
      showModal:false,modalTitle:'',modalMsg:'',
      handleSubmit(){
        this.modalTitle='Shukran, '+this.name+'!';
        this.modalMsg='Your custom trip inquiry has been successfully registered with <strong>Sahara Star Tours</strong>. Our travel designers in Marrakech are analyzing your requests.<br><br>Expect a highly detailed bespoke travel itinerary in your email (<strong>'+this.email+'</strong>) within 24 hours.';
        this.showModal=true;
        document.body.style.overflow='hidden';
        this.name='';this.email='';this.travelers='';this.pkg='none';this.message='';
      },
      closeModal(){this.showModal=false;document.body.style.overflow='';}
    }"
  >
    <form class="contact-form" @submit.prevent="handleSubmit()">
      <div class="form-group">
        <input type="text" id="contact-name" x-model="name" placeholder=" " required />
        <label for="contact-name">Your Full Name</label>
      </div>
      <div class="form-group">
        <input type="email" id="contact-email" x-model="email" placeholder=" " required />
        <label for="contact-email">Email Address</label>
      </div>
      <div class="form-grid-2">
        <div class="form-group">
          <select id="contact-travelers" x-model="travelers" style="width:100%">
            <option value="">Select Travelers</option>
            <option value="1 Traveler">1 Traveler</option>
            <option value="2 Travelers">2 Travelers</option>
            <option value="3-5 Travelers">3 - 5 Travelers</option>
            <option value="6+ Travelers">6+ Travelers Group</option>
          </select>
          <label for="contact-travelers">Group Size</label>
        </div>
        <div class="form-group">
          <select id="contact-package" x-model="pkg" style="width:100%">
            <option value="none">Custom Expedition / Not Sure</option>
            <option value="sahara">Sahara Dunes &amp; Desert Glamping (4 Days)</option>
            <option value="imperial">Imperial Medinas &amp; Riad Retreat (7 Days)</option>
            <option value="atlas">High Atlas &amp; Berber Villages Trek (5 Days)</option>
            <option value="coast">Blue City &amp; Atlantic Coast Escape (5 Days)</option>
          </select>
          <label for="contact-package">Selected Tour Package</label>
        </div>
      </div>
      <div class="form-group form-full">
        <textarea id="contact-message" x-model="message" placeholder=" " rows="5" required></textarea>
        <label for="contact-message">Tell us about your travel wishes (Preferred dates, special requirements, food allergies...)</label>
      </div>
      <button type="submit" class="btn btn-primary btn-submit">Send Inquiry Proposal</button>
    </form>
    <div class="success-overlay" :class="showModal?'active':''" id="success-modal">
      <div class="success-card">
        <div class="success-icon-box"><i class="fa-solid fa-circle-check"></i></div>
        <h3 x-text="modalTitle"></h3>
        <p x-html="modalMsg"></p>
        <button class="btn btn-primary" @click="closeModal()">Return to Exploring</button>
      </div>
    </div>
  </div>
</section>

</BaseLayout>

<style>
/* ---- Page-specific styles for index.astro ---- */
.hero {
  height: 100vh; display: flex; align-items: center; justify-content: center;
  position: relative; padding: 0 5%; overflow: hidden;
}
.hero-background { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; }
.hero-background img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.4) contrast(1.1); animation: slowZoom 25s infinite alternate ease-in-out; }
.hero-gradient { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to bottom, rgba(17,14,13,0.2) 0%, rgba(17,14,13,0.4) 60%, var(--night-bg) 100%); z-index: 2; }
.hero-content { position: relative; z-index: 3; text-align: center; max-width: 900px; margin-top: 50px; }
.hero-content .subtitle { font-size: 1.1rem; text-transform: uppercase; letter-spacing: 4px; color: var(--sand-gold); font-weight: 600; margin-bottom: 20px; display: inline-block; opacity: 0; transform: translateY(20px); animation: slideUpFade 1s forwards 0.2s cubic-bezier(0.16,1,0.3,1); }
.hero-content h1 { font-size: 4.8rem; line-height: 1.1; margin-bottom: 24px; color: var(--text-main); opacity: 0; transform: translateY(25px); animation: slideUpFade 1s forwards 0.4s cubic-bezier(0.16,1,0.3,1); }
.hero-content h1 span { background: linear-gradient(135deg, var(--terracotta) 0%, var(--sand-gold) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
