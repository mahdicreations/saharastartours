---
// src/pages/tours/index.astro — Multi-Day Tours Catalogue Hub
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getMultiDayTours } from '../../data/tours';

const multiDayTours = getMultiDayTours();

// Departure city counts
const marrakechCount = multiDayTours.filter(t => t.departureCity === 'Marrakech').length;
const casablancaCount = multiDayTours.filter(t => t.departureCity === 'Casablanca').length;
const fesCount = multiDayTours.filter(t => t.departureCity === 'Fes').length;
const tangierCount = multiDayTours.filter(t => t.departureCity === 'Tangier').length;
const ouarzazateCount = multiDayTours.filter(t => t.departureCity === 'Ouarzazate').length;

// Duration tier helper
function getDurationTier(days: number): string {
  if (days <= 4) return '2-4';
  if (days <= 7) return '5-7';
  if (days <= 10) return '8-10';
  return '11+';
}

const toursSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Multi-Day Morocco Tours & Private Expeditions | Sahara Star Tours",
  "description": `Discover our collection of ${multiDayTours.length} private multi-day Morocco tours. Luxury Sahara desert safaris, Imperial Cities circuits, and grand mountain odysseys from Marrakech, Casablanca, Fes, Tangier, and Ouarzazate.`,
  "url": "https://www.saharastartours.com/tours"
};
---

<BaseLayout
  title={`Multi-Day Morocco Tours (${multiDayTours.length} Private Itineraries) | Sahara Star Tours`}
  description={`Explore ${multiDayTours.length} bespoke multi-day Morocco tours from 2 to 16 days. Sahara desert safaris, imperial medina explorations, High Atlas crossings, and nomad heritage routes with private transport and licensed guides.`}
  keywords="morocco multi day tours, sahara desert tours, tours from marrakech, tours from casablanca, tours from fes, tours from tangier, private morocco itineraries"
  currentPage="tours"
  schemaData={toursSchema}
>

<!-- CATALOGUE HERO -->
<section class="tours-cat-hero">
  <div class="tours-cat-hero-overlay"></div>
  <div class="tours-cat-hero-content">
    <nav class="tours-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep"><i class="fa-solid fa-chevron-right"></i></span>
      <span class="current">Multi-Day Tours</span>
    </nav>
    <span class="tag"><i class="fa-solid fa-compass"></i> Handcrafted Private Expeditions</span>
    <h1>Multi-Day Morocco Tours &amp; Expeditions</h1>
    <p>From 2-day Sahara dunes escapes to 16-day grand Moroccan odysseys — discover all {multiDayTours.length} private multi-day itineraries crafted with licensed local guides, air-conditioned luxury 4x4 transport, and handpicked boutique riads and desert glamping camps.</p>
  </div>
</section>

<!-- DEPARTURE CITY HUBS QUICK JUMP CARDS -->
<section class="city-hubs-section">
  <div class="city-hubs-container">
    <div class="section-badge-center">
      <span class="tag"><i class="fa-solid fa-map-location-dot"></i> Browse by Departure Hub</span>
    </div>
    <div class="city-hubs-grid">
      <a href="/tours-from-marrakech" class="city-hub-card">
        <div class="city-hub-info">
          <h3>Tours from Marrakech</h3>
          <p>Desert dunes, High Atlas passes &amp; Fes traverses</p>
        </div>
        <span class="city-hub-count">{marrakechCount} Tours <i class="fa-solid fa-arrow-right"></i></span>
      </a>

      <a href="/tours-from-casablanca" class="city-hub-card">
        <div class="city-hub-info">
          <h3>Tours from Casablanca</h3>
          <p>Grand loops, Imperial Cities &amp; airport arrivals</p>
        </div>
        <span class="city-hub-count">{casablancaCount} Tours <i class="fa-solid fa-arrow-right"></i></span>
      </a>

      <a href="/tours-from-fes" class="city-hub-card">
        <div class="city-hub-info">
          <h3>Tours from Fes</h3>
          <p>Middle Atlas cedar forests &amp; Merzouga routes</p>
        </div>
        <span class="city-hub-count">{fesCount} Tours <i class="fa-solid fa-arrow-right"></i></span>
      </a>

      <a href="/tours-from-tangier" class="city-hub-card">
        <div class="city-hub-info">
          <h3>Tours from Tangier</h3>
          <p>Chefchaouen, Rif mountains &amp; North-to-South circuits</p>
        </div>
        <span class="city-hub-count">{tangierCount} Tours <i class="fa-solid fa-arrow-right"></i></span>
      </a>

      <a href="/tours-from-ouarzazate" class="city-hub-card">
        <div class="city-hub-info">
          <h3>Tours from Ouarzazate</h3>
          <p>Direct Sahara gateways, Draa Valley &amp; Kasbah trails</p>
        </div>
        <span class="city-hub-count">{ouarzazateCount} Tours <i class="fa-solid fa-arrow-right"></i></span>
      </a>
    </div>
  </div>
</section>

<!-- TOURS SHOWCASE SECTION WITH DUAL FILTERS -->
<section class="tours-catalogue-body">
  <div class="category-showcase-container" x-data="{ activeCity: 'all', activeDuration: 'all' }">
    
    <!-- Filter Controls Bar -->
    <div class="filters-master-panel">
      <!-- Departure City Filter Pills -->
      <div class="filter-row">
        <span class="filter-row-label"><i class="fa-solid fa-location-dot" style="color:var(--sand-gold);margin-right:6px;"></i> Departure City:</span>
        <div class="filter-pills-group">
          <button
            class="filter-pill"
            :class="activeCity === 'all' ? 'active' : ''"
            @click="activeCity = 'all'"
            type="button"
          >
            All Cities ({multiDayTours.length})
          </button>
          <button
            class="filter-pill"
            :class="activeCity === 'marrakech' ? 'active' : ''"
            @click="activeCity = 'marrakech'"
            type="button"
          >
            Marrakech ({marrakechCount})
          </button>
          <button
            class="filter-pill"
            :class="activeCity === 'casablanca' ? 'active' : ''"
            @click="activeCity = 'casablanca'"
            type="button"
          >
            Casablanca ({casablancaCount})
          </button>
          <button
            class="filter-pill"
            :class="activeCity === 'fes' ? 'active' : ''"
            @click="activeCity = 'fes'"
            type="button"
          >
            Fes ({fesCount})
          </button>
          <button
            class="filter-pill"
            :class="activeCity === 'tangier' ? 'active' : ''"
            @click="activeCity = 'tangier'"
            type="button"
          >
            Tangier ({tangierCount})
          </button>
          <button
            class="filter-pill"
            :class="activeCity === 'ouarzazate' ? 'active' : ''"
            @click="activeCity = 'ouarzazate'"
            type="button"
          >
            Ouarzazate ({ouarzazateCount})
          </button>
        </div>
      </div>

      <!-- Duration Filter Pills -->
      <div class="filter-row" style="margin-top: 14px;">
        <span class="filter-row-label"><i class="fa-regular fa-clock" style="color:var(--sand-gold);margin-right:6px;"></i> Duration:</span>
        <div class="filter-pills-group">
          <button
            class="filter-pill"
            :class="activeDuration === 'all' ? 'active' : ''"
            @click="activeDuration = 'all'"
            type="button"
          >
            All Durations
          </button>
          <button
            class="filter-pill"
            :class="activeDuration === '2-4' ? 'active' : ''"
            @click="activeDuration = '2-4'"
            type="button"
          >
            2–4 Days
          </button>
          <button
            class="filter-pill"
            :class="activeDuration === '5-7' ? 'active' : ''"
            @click="activeDuration = '5-7'"
            type="button"
          >
            5–7 Days
          </button>
          <button
            class="filter-pill"
            :class="activeDuration === '8-10' ? 'active' : ''"
            @click="activeDuration = '8-10'"
            type="button"
          >
            8–10 Days
          </button>
          <button
            class="filter-pill"
            :class="activeDuration === '11+' ? 'active' : ''"
            @click="activeDuration = '11+'"
            type="button"
          >
            11+ Days
          </button>
        </div>
      </div>
    </div>

    <!-- Multi-Day Tour Cards Grid -->
    <div class="category-tours-wrapper">
      <div class="category-tour-grid">
        {multiDayTours.map(tour => {
          const tier = getDurationTier(tour.durationDays);
          return (
            <article 
              class="tour-card reveal active"
              data-city={tour.departureCity.toLowerCase()}
              data-duration-tier={tier}
              x-show={`(activeCity === 'all' || activeCity === '${tour.departureCity.toLowerCase()}') && (activeDuration === 'all' || activeDuration === '${tier}')`}
              x-transition:enter="transition ease-out duration-300"
              x-transition:enter-start="opacity-0 scale-95"
              x-transition:enter-end="opacity-100 scale-100"
            >
              <div class="tour-img-wrapper">
                <img 
                  src={tour.heroImage} 
                  alt={tour.shortTitle} 
                  loading="lazy"
                  onerror="this.src='/assets/placeholder-morocco.svg'"
                />
                {tour.badge && <span class="tour-badge">{tour.badge}</span>}
              </div>
              <div class="tour-info">
                <div class="tour-meta">
                  <div><i class="fa-regular fa-clock"></i> {tour.duration}</div>
                  <div><i class="fa-solid fa-location-dot"></i> {tour.startingFrom}</div>
                </div>
                <h2 class="tour-title" style="font-size:1.35rem;">{tour.shortTitle}</h2>
                <p class="tour-desc">{tour.description}</p>
                <div class="tour-footer">
                  <div class="tour-price">
                    <span class="tour-price-label">Starting from</span>
                    <span class="tour-price-value">{tour.price.replace(/^From\s*/i, '').replace(/\/person\s*/i, '').trim()}</span>
                  </div>
                  <a href={`/tours/${tour.slug}`} class="btn btn-primary btn-sm">
                    View Tour <i class="fa-solid fa-arrow-right"></i>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</section>

<!-- SEPARATE PRODUCT FAMILIES CONTEXTUAL CROSS-LINK -->
<section class="cross-silo-banner">
  <div class="cross-silo-container">
    <div class="cross-silo-box">
      <div class="cross-silo-text">
        <span class="tag"><i class="fa-solid fa-compass"></i> Other Travel Experiences</span>
        <h3>Looking for Single-Day Excursions or Outdoor Adventures?</h3>
        <p>In addition to our {multiDayTours.length} multi-day tours, we offer dedicated day trips and authentic desert activities departing from Marrakech:</p>
      </div>
      <div class="cross-silo-links">
        <a href="/imperial-cities" class="btn btn-secondary">
          <i class="fa-solid fa-landmark"></i> Imperial Cities Circuits
        </a>
        <a href="/day-trips" class="btn btn-secondary">
          <i class="fa-solid fa-mountain-sun"></i> Marrakech Day Trips
        </a>
        <a href="/activities" class="btn btn-secondary">
          <i class="fa-solid fa-star"></i> Outdoor Activities &amp; Shows
        </a>
      </div>
    </div>
  </div>
</section>

<!-- CUSTOM TRIP CTA BANNER -->
<section class="custom-trip-cta">
  <div class="custom-cta-card">
    <div class="custom-cta-text">
      <span class="tag"><i class="fa-solid fa-wand-magic-sparkles"></i> Need Something Tailor-Made?</span>
      <h3>Can't Find Your Exact Dream Itinerary?</h3>
      <p>Our Marrakech-based travel designers will craft a 100% custom itinerary with private Mercedes transport, luxury riad selections, and secret desert stops tailored to your schedule.</p>
    </div>
    <div class="custom-cta-btn">
      <a href="/contact" class="btn btn-primary btn-lg">
        <i class="fa-solid fa-paper-plane"></i> Request Custom Itinerary
      </a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
.tours-cat-hero {
  position: relative;
  padding: 160px 5% 80px;
  text-align: center;
  background: radial-gradient(circle at 50% 30%, rgba(217, 107, 67, 0.15) 0%, transparent 60%), linear-gradient(180deg, var(--night-surface) 0%, var(--night-bg) 100%);
  border-bottom: 1px solid var(--glass-border);
  overflow: hidden;
}

.tours-cat-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url('/assets/zellij_pattern.svg');
  background-repeat: repeat;
  background-size: 180px 180px;
  background-position: center;
  opacity: 0.16;
  -webkit-mask-image: radial-gradient(ellipse at 50% 45%, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 0) 75%);
  mask-image: radial-gradient(ellipse at 50% 45%, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 0) 75%);
  pointer-events: none;
  z-index: 1;
}

.tours-cat-hero-content {
  position: relative;
  z-index: 2;
  max-width: 850px;
  margin: 0 auto;
}

.tours-breadcrumbs {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  font-size: 0.88rem;
  color: var(--text-muted);
  margin-bottom: 20px;
}

.tours-breadcrumbs a {
  color: var(--text-muted);
  transition: color 0.3s;
}

.tours-breadcrumbs a:hover {
  color: var(--sand-gold);
}

.tours-breadcrumbs .sep {
  font-size: 0.7rem;
  opacity: 0.5;
}

.tours-breadcrumbs .current {
  color: var(--sand-gold);
  font-weight: 500;
}

.tours-cat-hero h1 {
  font-size: 3.2rem;
  line-height: 1.15;
  margin: 16px 0 20px;
  background: linear-gradient(135deg, var(--text-main) 30%, var(--sand-gold) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.tours-cat-hero p {
  font-size: 1.15rem;
  color: var(--text-muted);
  line-height: 1.7;
}

/* Departure Hub Quick Cards */
.city-hubs-section {
  padding: 40px 5% 20px;
  max-width: 1400px;
  margin: 0 auto;
}

.section-badge-center {
  text-align: center;
  margin-bottom: 24px;
}

.city-hubs-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 18px;
}

.city-hub-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-md);
  padding: 22px 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 16px;
  text-decoration: none;
  transition: all 0.3s ease;
}

.city-hub-card:hover {
  background: rgba(212, 175, 55, 0.05);
  border-color: var(--sand-gold);
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
}

.city-hub-info h3 {
  font-size: 1.15rem;
  color: var(--text-main);
  margin: 0 0 6px;
  font-weight: 600;
}

.city-hub-info p {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin: 0;
  line-height: 1.4;
}

.city-hub-count {
  font-size: 0.85rem;
  color: var(--sand-gold);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6px;
}

/* Master Filter Panel */
.tours-catalogue-body {
  padding: 40px 0 80px;
}

.category-showcase-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 5%;
}

.filters-master-panel {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  padding: 24px 30px;
  margin: 0 auto 50px;
  max-width: 1100px;
}

.filter-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
}

.filter-row-label {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 1.2px;
  color: var(--text-muted);
  font-weight: 600;
  min-width: 160px;
}

.filter-pills-group {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.filter-pill {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: var(--text-muted);
  border-radius: 30px;
  padding: 6px 16px;
  font-family: var(--font-sans);
  font-size: 0.85rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition-smooth);
}

.filter-pill:hover {
  color: var(--sand-gold);
  border-color: var(--sand-gold);
}

.filter-pill.active {
  background: linear-gradient(135deg, var(--terracotta) 0%, hsl(14, 75%, 45%) 100%);
  border-color: var(--terracotta);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4px 14px var(--terracotta-glow);
}

.category-tour-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 32px;
}

/* Cross-Silo Cross Links */
.cross-silo-banner {
  padding: 20px 5% 60px;
  max-width: 1400px;
  margin: 0 auto;
}

.cross-silo-box {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  padding: 35px 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 30px;
  flex-wrap: wrap;
}

.cross-silo-text h3 {
  font-size: 1.4rem;
  margin: 8px 0 6px;
  color: var(--text-main);
}

.cross-silo-text p {
  color: var(--text-muted);
  margin: 0;
  font-size: 0.95rem;
}

.cross-silo-links {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

/* Custom trip CTA */
.custom-trip-cta {
  padding: 0 5% 100px;
  max-width: 1400px;
  margin: 0 auto;
}

.custom-cta-card {
  background: linear-gradient(135deg, rgba(32, 25, 23, 0.9) 0%, rgba(20, 16, 15, 0.98) 100%);
  border: 1px solid rgba(232, 195, 158, 0.25);
  border-radius: var(--radius-lg);
  padding: 50px 60px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 40px;
  box-shadow: var(--shadow-premium);
  position: relative;
  overflow: hidden;
}

.custom-cta-card::before {
  content: '';
  position: absolute;
  top: -80px;
  right: -80px;
  width: 250px;
  height: 250px;
  background: radial-gradient(circle, var(--terracotta-glow) 0%, transparent 70%);
  pointer-events: none;
}

.custom-cta-text h3 {
  font-size: 2rem;
  margin: 12px 0 10px;
  color: var(--text-main);
}

.custom-cta-text p {
  font-size: 1rem;
  color: var(--text-muted);
  max-width: 650px;
  margin: 0;
  line-height: 1.6;
}

.custom-cta-btn {
  flex-shrink: 0;
}

@media (max-width: 900px) {
  .custom-cta-card {
    flex-direction: column;
    text-align: center;
    padding: 35px 25px;
  }
  .cross-silo-box {
    flex-direction: column;
    text-align: center;
  }
  .cross-silo-links {
    justify-content: center;
  }
  .filter-row-label {
    min-width: 100%;
    margin-bottom: 6px;
  }
  .tours-cat-hero h1 {
    font-size: 2.3rem;
  }
}
</style>
